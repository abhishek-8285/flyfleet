{
  "dashboard": {
    "title": "FlyFleet Cost Optimization",
    "uid": "flyfleet-cost-optimization",
    "version": 1,
    "schemaVersion": 38,
    "timezone": "browser",
    "refresh": "5m",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "tags": ["flyfleet", "cost", "finops"],
    "editable": true,
    "graphTooltip": 1,
    "panels": [
      {
        "id": 1,
        "title": "Total Daily Cost (USD)",
        "type": "graph",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "cost_cloud_total_usd",
            "legendFormat": "{{cloud_provider}} - {{service}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "USD", "label": "Cost/Day" },
          { "format": "short" }
        ]
      },
      {
        "id": 2,
        "title": "Cost by Service Category",
        "type": "piechart",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(cost_cloud_total_usd) by (service)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Budget vs Actual (MTD)",
        "type": "graph",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "cost_budget_set_usd",
            "legendFormat": "Budget",
            "refId": "A"
          },
          {
            "expr": "cost_budget_set_usd * (cost_budget_consumption_percentage / 100)",
            "legendFormat": "Actual ({{ org_id }})",
            "refId": "B"
          }
        ],
        "yaxes": [
          { "format": "USD" },
          { "format": "short" }
        ]
      },
      {
        "id": 4,
        "title": "Budget Consumption Warnings",
        "type": "stat",
        "gridPos": { "x": 12, "y": 8, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "cost_budget_consumption_percentage",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "orange", "value": 0.8 },
                { "color": "red", "value": 0.95 }
              ]
            },
            "min": 0,
            "max": 1
          }
        }
      },
      {
        "id": 5,
        "title": "Unallocated/Untagged Resources",
        "type": "stat",
        "gridPos": { "x": 18, "y": 8, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "cost_unallocated_usd",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "USD",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "red", "value": 100 }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Resource Utilization Efficiency",
        "type": "graph",
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "cost_resource_utilization_efficiency_percentage",
            "legendFormat": "{{resource_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "percentunit", "min": 0, "max": 1 },
          { "format": "short" }
        ]
      },
      {
        "id": 7,
        "title": "Idle Resource Waste (Daily)",
        "type": "graph",
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "cost_idle_resource_usd",
            "legendFormat": "{{resource_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "USD", "label": "Daily Waste" },
          { "format": "short" }
        ]
      },
      {
        "id": 8,
        "title": "Top 10 Cost Anomalies (Last 24h)",
        "type": "table",
        "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "topk(10, cost_anomaly_value_usd)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 9,
        "title": "Storage Optimization Opportunities",
        "type": "graph",
        "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "cost_storage_tier_distribution_bytes",
            "legendFormat": "{{tier}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "bytes" },
          { "format": "short" }
        ]
      },
      {
        "id": 10,
        "title": "Rightsizing Potential Savings",
        "type": "graph",
        "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "cost_rightsizing_savings_usd",
            "legendFormat": "{{instance_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "USD/month", "label": "Potential Savings" },
          { "format": "short" }
        ]
      },
      {
        "id": 11,
        "title": "Spot vs Reserved vs On-Demand Mix",
        "type": "piechart",
        "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(compute_cost) by (payment_option)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 12,
        "title": "Observability Stack Cost Breakdown",
        "type": "graph",
        "gridPos": { "x": 0, "y": 40, "w": 24, "h": 8 },
        "targets": [
          {
            "expr": "cost_observability_total_usd",
            "legendFormat": "{{tool}} - {{usage_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "USD/day", "label": "Daily Cost" },
          { "format": "short" }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "org_id",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(cost_per_organization_usd, org_id)",
          "includeAll": true,
          "multi": true
        },
        {
          "name": "service",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(cost_cloud_total_usd, service)",
          "includeAll": true,
          "multi": true
        }
      ]
    }
  }
}
