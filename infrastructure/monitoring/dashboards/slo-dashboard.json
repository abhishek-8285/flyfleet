{
  "dashboard": {
    "title": "FlyFleet SLO & Error Budget Dashboard",
    "uid": "flyfleet-slo-v2",
    "version": 1,
    "schemaVersion": 38,
    "timezone": "browser",
    "refresh": "1m",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "tags": ["flyfleet", "slo", "reliability"],
    "editable": true,
    "graphTooltip": 1,
    "panels": [
      {
        "id": 1,
        "title": "Error Budget Remaining - All Services",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 24, "h": 4},
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "orange", "value": 20},
                {"color": "green", "value": 50}
              ]
            },
            "mappings": [
              {"type": "value", "options": {"0": {"text": "Burned", "color": "red"}, "100": {"text": "Full", "color": "green"}}}
            ],
            "unit": "percentunit"
          }
        },
        "targets": [
          {
            "expr": "1 - (sum(increase(fleet_core_errors_total[30d])) / sum(increase(fleet_core_requests_total[30d])))",
            "legendFormat": "API Availability"
          }
        ],
        "transformations": [
          {
            "id": "reduce",
            "options": {
              "mode": "reduce",
              "field": "Value",
              "reducer": "last",
              "newFieldName": "remaining"
            }
          }
        ]
      },
      {
        "id": 2,
        "title": "SLO Burn Rate - Last 24h",
        "type": "stat",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "(1 - (sum(rate(http_requests_total{status!~\"5..\",service=\"fleet-core\"}[1h])) / sum(rate(http_requests_total{service=\"fleet-core\"}[1h])))) / ((1 - 0.9995) / (30 * 24))",
            "legendFormat": "1h burn rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "orange", "value": 1.0},
                {"color": "red", "value": 2.0}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Error Budget Remaining - API",
        "type": "stat",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "(1 - (sum(increase(http_requests_total{status=~\"5..\",service=\"fleet-core\"}[30d])) / sum(increase(http_requests_total{service=\"fleet-core\"}[30d]))))",
            "legendFormat": "consumed"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "orange", "value": 0.5},
                {"color": "green", "value": 0}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "API Availability (30d rolling)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 10, "w": 12, "h": 8},
        "yaxes": [
          {"format": "percentunit", "min": 0.999, "max": 1, "decimals": 4},
          {"format": "short"}
        ],
        "targets": [
          {
            "expr": "sli:api:availability:percentage / 100",
            "legendFormat": "Availability"
          }
        ],
        "alert": {
          "conditions": [
            {"evaluator": {"params": [0.9995], "type": "lt"}, "operator": {"type": "and"}, "query": {"params": ["A", "5m", "now"]}, "reducer": {"params": [], "type": "avg"}}
          ]
        }
      },
      {
        "id": 5,
        "title": "API Latency (p95, p99)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 10, "w": 12, "h": 8},
        "yaxes": [
          {"format": "s", "min": 0, "max": 1},
          {"format": "short"}
        ],
        "targets": [
          {
            "expr": "sli:api:latency:p95",
            "legendFormat": "p95"
          },
          {
            "expr": "sli:api:latency:p99",
            "legendFormat": "p99"
          }
        ]
      },
      {
        "id": 6,
        "title": "Error Budget Burn Rate (1h vs 30d)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 18, "w": 24, "h": 8},
        "yaxes": [
          {"format": "percentunit", "min": 0, "max": 5},
          {"format": "short"}
        ],
        "targets": [
          {
            "expr": "((1 - (sum(rate(http_requests_total{status!~\"5..\",service=\"fleet-core\"}[1h])) / sum(rate(http_requests_total{service=\"fleet-core\"}[1h])))) / ((1 - 0.9995) / (30 * 24)))",
            "legendFormat": "1h burn rate"
          },
          {
            "expr": "((1 - (sum(rate(http_requests_total{status!~\"5..\",service=\"fleet-core\"}[30m])) / sum(rate(http_requests_total{service=\"fleet-core\"}[30m])))) / ((1 - 0.9995) / (30 * 24)))",
            "legendFormat": "30m burn rate"
          },
          {
            "expr": "((1 - (sum(rate(http_requests_total{status!~\"5..\",service=\"fleet-core\"}[5m])) / sum(rate(http_requests_total{service=\"fleet-core\"}[5m])))) / ((1 - 0.9995) / (30 * 24)))",
            "legendFormat": "5m burn rate"
          }
        ],
        "alert": {
          "conditions": [
            {"evaluator": {"params": [2.0], "type": "gt"}, "operator": {"type": "and"}, "query": {"params": ["A", "1m", "now"]}, "reducer": {"params": [], "type": "avg"}}
          ]
        }
      },
      {
        "id": 7,
        "title": "Command Success Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 26, "w": 12, "h": 8},
        "yaxes": [
          {"format": "percentunit", "min": 0.98, "max": 1},
          {"format": "short"}
        ],
        "targets": [
          {
            "expr": "sli:commands:success_rate:percentage / 100",
            "legendFormat": "Success Rate"
          }
        ]
      },
      {
        "id": 8,
        "title": "Command Latency p95",
        "type": "graph",
        "gridPos": {"x": 12, "y": 26, "w": 12, "h": 8},
        "yaxes": [
          {"format": "s", "min": 0, "max": 5},
          {"format": "short"}
        ],
        "targets": [
          {
            "expr": "sli:commands:ack_latency:p95",
            "legendFormat": "p95 ACK latency"
          }
        ]
      },
      {
        "id": 9,
        "title": "Telemetry Ingestion Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 34, "w": 12, "h": 8},
        "yaxes": [
          {"format": "eps", "min": 0},
          {"format": "short"}
        ],
        "targets": [
          {
            "expr": "rate(telemetry_events_received_total[1m])",
            "legendFormat": "events/sec"
          }
        ]
      },
      {
        "id": 10,
        "title": "Telemetry Latency p99",
        "type": "graph",
        "gridPos": {"x": 12, "y": 34, "w": 12, "h": 8},
        "yaxes": [
          {"format": "s", "min": 0, "max": 10},
          {"format": "short"}
        ],
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(telemetry_latency_seconds_bucket[1h])) by (le))",
            "legendFormat": "p99 latency"
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(service)",
          "includeAll": true,
          "multi": true
        },
        {
          "name": "slo",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(sli_*)",
          "includeAll": true,
          "multi": true
        }
      ]
    }
  }
}
