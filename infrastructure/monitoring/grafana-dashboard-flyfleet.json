{
  "dashboard": {
    "title": "FlyFleet Overview",
    "uid": "flyfleet-overview",
    "version": 1,
    "timezone": "browser",
    "schemaVersion": 36,
    "refresh": "10s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "tags": ["flyfleet", "production"],
    "editable": true,
    "graphTooltip": 1,
    "panels": [
      {
        "id": 1,
        "title": "Request Rate",
        "type": "graph",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "xaxis": { "mode": "time" },
        "yaxes": [
          { "format": "req/s", "label": "Requests/sec" },
          { "format": "short" }
        ]
      },
      {
        "id": 2,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(http_requests_total{status=~\"5..\"}[5m]) / rate(http_requests_total[5m])",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "xaxis": { "mode": "time" },
        "yaxes": [
          { "format": "percentunit", "label": "Error Rate", "max": 1 },
          { "format": "short" }
        ],
        "thresholds": [
          { "colorMode": "critical", "value": 0.05 },
          { "colorMode": "warning", "value": 0.01 }
        ]
      },
      {
        "id": 3,
        "title": "API Latency (p95)",
        "type": "graph",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service))",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "xaxis": { "mode": "time" },
        "yaxes": [
          { "format": "s", "label": "Latency" },
          { "format": "short" }
        ]
      },
      {
        "id": 4,
        "title": "Database Connections",
        "type": "graph",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "pg_stat_database_numbackends{datname=\"flyfleet\"}",
            "legendFormat": "Connections",
            "refId": "A"
          }
        ],
        "xaxis": { "mode": "time" },
        "yaxes": [
          { "format": "short", "label": "Connections" },
          { "format": "short" }
        ]
      },
      {
        "id": 5,
        "title": "Pod Status",
        "type": "stat",
        "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "kube_pod_status_phase{phase=\"Running\", namespace=\"flyfleet\"}",
            "legendFormat": "Running: {{pod}}",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 6,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"flyfleet\"}[5m]))",
            "legendFormat": "Total CPU",
            "refId": "A"
          }
        ],
        "xaxis": { "mode": "time" },
        "yaxes": [
          { "format": "cores", "label": "CPU Cores" },
          { "format": "short" }
        ]
      },
      {
        "id": 7,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "sum(container_memory_usage_bytes{namespace=\"flyfleet\"})",
            "legendFormat": "Total Memory",
            "refId": "A"
          }
        ],
        "xaxis": { "mode": "time" },
        "yaxes": [
          { "format": "bytes", "label": "Memory" },
          { "format": "short" }
        ]
      },
      {
        "id": 8,
        "title": "NATS Messages",
        "type": "graph",
        "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "rate(nats_server_msgs_total[5m])",
            "legendFormat": "{{server}}",
            "refId": "A"
          }
        ],
        "xaxis": { "mode": "time" },
        "yaxes": [
          { "format": "msg/s", "label": "Messages/sec" },
          { "format": "short" }
        ]
      }
    ]
  }
}
