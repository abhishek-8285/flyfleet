{
  "dashboard": {
    "id": null,
    "title": "FlyFleet SLO Journeys",
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Login Success Rate (30m)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "100 * (sum(rate(auth_login_requests_total{status=\"success\"}[30m])) / clamp_min(sum(rate(auth_login_requests_total[30m])), 1))"
          }
        ]
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "Dashboard P95 Usable Time",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(web_dashboard_usable_seconds_bucket[30m])) by (le))"
          }
        ]
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "Critical API P95 Latency",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{route=~\"/api/v1/auth/login|/api/v1/trips.*|/api/v1/admin/work-orders.*|/api/v1/commands.*\"}[30m])) by (le))"
          }
        ]
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "Telemetry Freshness P95",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(device_telemetry_freshness_seconds_bucket[30m])) by (le))"
          }
        ]
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Command Success Rate (30m)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "100 * (sum(rate(device_command_events_total{result=\"success\"}[30m])) / clamp_min(sum(rate(device_command_events_total{result=~\"success|failed|timeout\"}[30m])), 1))"
          }
        ]
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Command Ack P95",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(device_command_ack_latency_seconds_bucket[30m])) by (le))"
          }
        ]
      },
      {
        "id": 7,
        "type": "timeseries",
        "title": "Mobile Sync Apply Success Rate",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "100 * (sum(rate(mobile_sync_operations_total{result=\"applied\"}[30m])) / clamp_min(sum(rate(mobile_sync_operations_total{result=~\"applied|failed\"}[30m])), 1))"
          }
        ]
      },
      {
        "id": 8,
        "type": "timeseries",
        "title": "OTA Success Rate by Ring",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "100 * (sum by (ring) (rate(ota_update_attempts_total{result=\"success\"}[2h])) / clamp_min(sum by (ring) (rate(ota_update_attempts_total{result=~\"success|failed|rolled_back\"}[2h])), 1))",
            "legendFormat": "ring={{ring}}"
          }
        ]
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    }
  }
}
