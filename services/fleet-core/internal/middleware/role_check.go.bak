package middleware

import (
	"net/http"
	"slices"

	"go.uber.org/zap"
)

// RequireRole returns middleware that checks the authenticated user
// has at least one of the specified roles.
func RequireRole(allowedRoles []string, logger *zap.Logger) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			roles := GetUserRoles(r)
			if roles == nil {
				logger.Warn("role check failed: no roles in context")
				http.Error(w, `{"error":"forbidden"}`, http.StatusForbidden)
				return
			}

			for _, role := range roles {
				if slices.Contains(allowedRoles, role) {
					next.ServeHTTP(w, r)
					return
				}
			}

			logger.Debug("insufficient role",
				zap.Strings("user_roles", roles),
				zap.Strings("allowed_roles", allowedRoles))
			http.Error(w, `{"error":"insufficient permissions"}`, http.StatusForbidden)
		})
	}
}
