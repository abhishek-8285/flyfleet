LOG_LEVEL=debug
PORT=8109
DATABASE_URL=postgres://fleet_user:fleet_password@localhost:5432/fleet_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
JWT_SECRET=flyfleet-super-secret-jwt-key-32chars
JWKS_URL=
ENVIRONMENT=development
IAM_BCRYPT_COST=4
IAM_MAX_LOGIN_ATTEMPTS=5
IAM_LOCKOUT_DURATION=15
IAM_PASSWORD_HISTORY_LENGTH=5
IAM_JWT_ACCESS_TTL=900
IAM_JWT_REFRESH_TTL=604800
IAM_EMAIL_PROVIDER=noop
BILLING_ENABLED=true
BILLING_CHROME_TIMEOUT_SECONDS=30
TELEMETRY_HMAC_SECRET=telemetry-secret
VEHICLE_FIELD_ENCRYPTION_KEY=super-secret-key-32-chars-long-!!
