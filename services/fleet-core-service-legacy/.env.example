# ===== FlyFleet Invoice System Configuration =====
# Copy this file to .env and update with your settings

# ===== Invoice Storage =====
# Directory where invoice PDFs are stored locally
INVOICE_STORAGE_PATH=/opt/flyfleet/data/invoices

# Directory for backup archives
BACKUP_DIR=/opt/flyfleet/data/backups

# ===== Cache Configuration =====
# Maximum number of invoices to cache in memory
CACHE_MAX_SIZE=1000

# Cache time-to-live (30 days = 720h)
CACHE_TTL=720h

# ===== PDF Generation =====
# Path to Chrome/Chromium binary (leave empty for auto-detect)
CHROME_PATH=/usr/bin/chromium

# Timeout for PDF generation
CHROME_TIMEOUT=30s

# ===== Email Configuration (SendGrid Free Tier) =====
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# From email address for invoice emails
FROM_EMAIL=billing@flyfleet.com

# From name for invoice emails
FROM_NAME=FlyFleet Billing

# CC email for accounting team (optional)
INVOICE_CC_EMAIL=

# ===== Backup Configuration (Google Drive) =====
# rclone remote name (configured via 'rclone config')
RCLONE_REMOTE=gdrive:flyfleet-backup

# Number of days to keep local backups
RETENTION_DAYS=90

# Backup log file
LOG_FILE=/var/log/flyfleet/backup.log

# ===== Webhook Notifications (Optional) =====
# Webhook URL for backup notifications
NOTIFICATION_WEBHOOK=

# ===== Application Settings =====
# Server port
PORT=8084

# Log level (debug, info, warn, error)
LOG_LEVEL=info
