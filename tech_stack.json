{
    "name": "FlyFleet",
    "version": "1.0.0",
    "stack": {
        "backend": {
            "languages": [
                "Go (Golang) 1.24-1.25",
                "Python 3.11+"
            ],
            "frameworks": {
                "go": [
                    "Chi / Net/HTTP (Standardized)"
                ],
                "python": [
                    "FastAPI (Optimization Service)"
                ]
            },
            "libraries": [
                "Zap (Logging)",
                "Viper (Configuration)",
                "Pydantic (Validation)",
                "JWT-Go (Security)",
                "PGX (Postgres Driver)",
                "Asynq (Redis Jobs)",
                "NATS.go (Messaging)",
                "Prophet (Forecasting)",
                "Pandas (Data Analysis)",
                "Scikit-learn (ML)"
            ]
        },
        "frontend": {
            "dashboard": {
                "framework": "React 19",
                "styling": "Tailwind CSS v3 (Transitioning to v4)",
                "state_management": "Redux Toolkit",
                "animations": "Framer Motion",
                "charts": "Recharts",
                "maps": "Leaflet / React-Leaflet"
            },
            "landing_page": {
                "framework": "Next.js 16 (Next.js 15+ compatible)",
                "styling": "Tailwind CSS v4"
            }
        },
        "infrastructure": {
            "database": "PostgreSQL 16-Alpine",
            "caching_jobs": "Redis 7-Alpine",
            "messaging": "NATS 2.10-Alpine",
            "containerization": "Docker / Docker Compose",
            "backup": "PostgreSQL Backup Local (prodrigestivill)"
        }
    },
    "api": {
        "gateway": "Web-BFF (Backend-for-Frontend)",
        "standard": "RESTful with RFC 7807 Error Problem Details",
        "specification": "OpenAPI 3.1.0 (v2.0.0 foundation)"
    }
}