2026-04-12 10:41:24.156 IST [9677] STATEMENT:  CREATE MATERIALIZED VIEW IF NOT EXISTS vehicle_status AS
	WITH latest_telemetry AS (
	    SELECT DISTINCT ON (vehicle_id)
	        vehicle_id,
	        time,
	        latitude,
	        longitude,
	        speed_kph,
	        heading,
	        odometer_km,
	        fuel_level_percent,
	        engine_temp_celsius,
	        alerts
	    FROM vehicle_telemetry
	    ORDER BY vehicle_id, time DESC
	)
	SELECT 
	    v.id AS vehicle_id,
	    v.registration_number,
	    v.status AS vehicle_registry_status,
	    lt.time AS last_update,
	    lt.latitude,
	    lt.longitude,
	    lt.speed_kph,
	    lt.heading,
	    lt.odometer_km,
	    lt.fuel_level_percent,
	    lt.engine_temp_celsius,
	    lt.alerts,
	    CASE 
	        WHEN lt.time < NOW() - INTERVAL '5 minutes' THEN 'offline'
	        WHEN lt.speed_kph > 5 THEN 'moving'
	        ELSE 'idle'
	    END AS operational_status,
	    d.name AS driver_name,
	    d.id AS driver_id
	FROM vehicles v
	LEFT JOIN latest_telemetry lt ON v.id = lt.vehicle_id
