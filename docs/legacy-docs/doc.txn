```bash
# 1. Install
./install.sh

# 2. Verify all services
docker-compose -f docker-compose.prod.yml ps

# 3. Test API
curl -X POST https://fleet.local/api/v1/auth/login \
  -d '{"email":"admin@fleet.local","password":"password"}'

# 4. Create vehicle
TOKEN=$(curl -s -X POST https://fleet.local/api/v1/auth/login \
  -d '{"email":"admin@fleet.local","password":"password"}' | jq -r .access_token)

curl -X POST https://fleet.local/api/v1/vehicles \
  -H "Authorization: Bearer $TOKEN" \
  -d '{"registration_number":"KA01AB1234","type":"truck","make":"Tata"}'

# 5. Simulate GPS
curl -X POST https://fleet.local/device/telemetry/gps \
  -H "X-API-Key: device-key" \
  -d '{"vehicle_id":"VEHICLE_ID","latitude":12.97,"longitude":77.59,"speed":45,"timestamp":'$(date +%s)'}'

# 6. Open web UI
open https://app.fleet.local

# 7. Check monitoring
open https://grafana.fleet.local
```

