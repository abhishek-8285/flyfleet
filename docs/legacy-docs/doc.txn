## B. COMPLETE DRIVER SERVICE

**`backend/internal/driver/entity.go`**
```go
package driver

import "time"

type Driver struct {
	ID                string    `json:"id"`
	OrgID             string    `json:"org_id"`
	UserID            string    `json:"user_id"`
	Name              string    `json:"name"`
	Email             string    `json:"email"`
	Phone             string    `json:"phone"`
	LicenseNumber     string    `json:"license_number"`
	LicenseExpiry     time.Time `json:"license_expiry"`
	Status            string    `json:"status"`
	Rating            float64   `json:"rating"`
	BehaviorScore     int       `json:"behavior_score"`
	TotalTrips        int       `json:"total_trips"`
	TotalDistanceKm   float64   `json:"total_distance_km"`
	CurrentVehicleID  *string   `json:"current_vehicle_id"`
	EmergencyContact  string    `json:"emergency_contact"`
	Documents         []Document `json:"documents"`
	CreatedAt         time.Time `json:"created_at"`
	UpdatedAt         time.Time `json:"updated_at"`
}

type Document struct {
	Type     string    `json:"type"`
	Number   string    `json:"number"`
	URL      string    `json:"url"`
	ExpiryAt time.Time `json:"expiry_at"`
}

type CreateRequest struct {
	Name             string   `json:"name" binding:"required"`
	Email            string   `json:"email" binding:"required,email"`
	Phone            string   `json:"phone" binding:"required,e164"`
	Password         string   `json:"password" binding:"required,min=12"`
	LicenseNumber    string   `json:"license_number" binding:"required"`
	LicenseExpiry    string   `json:"license_expiry" binding:"required,datetime=2006-01-02"`
	EmergencyContact string   `json:"emergency_contact"`
}

type UpdateRequest struct {
	Name             string   `json:"name"`
	Phone            string   `json:"phone" binding:"omitempty,e164"`
	LicenseNumber    string   `json:"license_number"`
	LicenseExpiry    string   `json:"license_expiry" binding:"omitempty,datetime=2006-01-02"`
	Status           string   `json:"status" binding:"omitempty,oneof=active inactive suspended on_leave"`
	EmergencyContact string   `json:"emergency_contact"`
}
```

**`backend/internal/driver/service.go`**
```go
package driver

import (
	"context"
	"fmt"
	"time"

	"fleet-platform/backend/internal/auth"

	"github.com/jackc/pgx/v5/pgtype"
	"go.uber.org/zap"
)

type Service struct {
	repo       *Repository
	authService *auth.Service
	logger     *zap.Logger
}

func NewService(repo *Repository, authService *auth.Service, logger *zap.Logger) *Service {
	return &Service{
		repo:       repo,
		authService: authService,
		logger:     logger,
	}
}

func (s *Service) Create(ctx context.Context, orgID string, req *CreateRequest) (*Driver, error) {
	// Validate license format (Indian)
	if len(req.LicenseNumber) != 16 {
		return nil, fmt.Errorf("invalid license number format")
	}

	// Parse expiry
	expiry, err := time.Parse("2006-01-02", req.LicenseExpiry)
	if err != nil {
		return nil, fmt.Errorf("invalid license expiry date")
	}

	if expiry.Before(time.Now()) {
		return nil, fmt.Errorf("license already expired")
	}

	// Create user account for driver
	userReq := auth.CreateUserRequest{
		Email:    req.Email,
		Phone:    req.Phone,
		Password: req.Password,
		Role:     "driver",
		Profile: auth.Profile{
			Name:            req.Name,
			LicenseNumber:   req.LicenseNumber,
			LicenseExpiry:   req.LicenseExpiry,
			EmergencyContact: req.EmergencyContact,
		},
	}

	user, err := s.authService.CreateUser(ctx, orgID, &userReq)
	if err != nil {
		return nil, fmt.Errorf("failed to create user account: %w", err)
	}

	// Create driver record
	driver := &Driver{
		OrgID:            orgID,
		UserID:           user.ID,
		Name:             req.Name,
		Email:            req.Email,
		Phone:            req.Phone,
		LicenseNumber:    req.LicenseNumber,
		LicenseExpiry:    expiry,
		Status:           "active",
		Rating:           5.0,
		BehaviorScore:    100,
		EmergencyContact: req.EmergencyContact,
	}

	if err := s.repo.Create(ctx, driver); err != nil {
		return nil, fmt.Errorf("failed to create driver: %w", err)
	}

	s.logger.Info("driver created", zap.String("id", driver.ID), zap.String("name", driver.Name))
	return driver, nil
}

func (s *Service) Get(ctx context.Context, id, orgID string) (*Driver, error) {
	driver, err := s.repo.GetByID(ctx, id)
	if err != nil {
		return nil, err
	}
	if driver.OrgID != orgID {
		return nil, fmt.Errorf("unauthorized")
	}
	return driver, nil
}

func (s *Service) List(ctx context.Context, orgID string, status string) ([]*Driver, error) {
	return s.repo.ListByOrg(ctx, orgID, status)
}

func (s *Service) Update(ctx context.Context, id, orgID string, req *UpdateRequest) error {
	driver, err := s.repo.GetByID(ctx, id)
	if err != nil {
		return err
	}
	if driver.OrgID != orgID {
		return fmt.Errorf("unauthorized")
	}

	updates := map[string]interface{}{}
	if req.Name != "" {
		updates["name"] = req.Name
	}
	if req.Phone != "" {
		updates["phone"] = req.Phone
	}
	if req.LicenseNumber != "" {
		updates["license_number"] = req.LicenseNumber
	}
	if req.LicenseExpiry != "" {
		expiry, _ := time.Parse("2006-01-02", req.LicenseExpiry)
		updates["license_expiry"] = pgtype.Date{Time: expiry, Valid: true}
	}
	if req.Status != "" {
		updates["status"] = req.Status
	}
	if req.EmergencyContact != "" {
		updates["emergency_contact"] = req.EmergencyContact
	}

	return s.repo.Update(ctx, id, updates)
}

func (s *Service) Delete(ctx context.Context, id, orgID string) error {
	driver, err := s.repo.GetByID(ctx, id)
	if err != nil {
		return err
	}
	if driver.OrgID != orgID {
		return fmt.Errorf("unauthorized")
	}

	// Soft delete
	return s.repo.SoftDelete(ctx, id)
}

func (s *Service) AssignVehicle(ctx context.Context, driverID, vehicleID, orgID string) error {
	driver, err := s.repo.GetByID(ctx, driverID)
	if err != nil {
		return err
	}
	if driver.OrgID != orgID {
		return fmt.Errorf("unauthorized")
	}

	return s.repo.UpdateCurrentVehicle(ctx, driverID, &vehicleID)
}

func (s *Service) UnassignVehicle(ctx context.Context, driverID, orgID string) error {
	driver, err := s.repo.GetByID(ctx, driverID)
	if err != nil {
		return err
	}
	if driver.OrgID != orgID {
		return fmt.Errorf("unauthorized")
	}

	return s.repo.UpdateCurrentVehicle(ctx, driverID, nil)
}

func (s *Service) UpdateStats(ctx context.Context, driverID string, tripDistance float64) error {
	return s.repo.IncrementStats(ctx, driverID, tripDistance)
}

func (s *Service) UpdateBehaviorScore(ctx context.Context, driverID string, delta int) error {
	return s.repo.UpdateBehaviorScore(ctx, driverID, delta)
}
```

**`backend/internal/driver/repository.go`**
```go
package driver

import (
	"context"
	"encoding/json"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"
)

type Repository struct {
	db *pgxpool.Pool
}

func NewRepository(db *pgxpool.Pool) *Repository {
	return &Repository{db: db}
}

func (r *Repository) Create(ctx context.Context, d *Driver) error {
	query := `
		INSERT INTO drivers (org_id, user_id, name, email, phone, license_number, 
		                     license_expiry, emergency_contact, documents)
		VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
		RETURNING id, status, rating, behavior_score, created_at, updated_at
	`
	
	docsJSON, _ := json.Marshal(d.Documents)
	
	return r.db.QueryRow(ctx, query,
		d.OrgID, d.UserID, d.Name, d.Email, d.Phone,
		d.LicenseNumber, d.LicenseExpiry, d.EmergencyContact, docsJSON,
	).Scan(&d.ID, &d.Status, &d.Rating, &d.BehaviorScore, &d.CreatedAt, &d.UpdatedAt)
}

func (r *Repository) GetByID(ctx context.Context, id string) (*Driver, error) {
	query := `
		SELECT d.id, d.org_id, d.user_id, d.name, d.email, d.phone,
		       d.license_number, d.license_expiry, d.status, d.rating,
		       d.behavior_score, d.total_trips, d.total_distance_km,
		       d.current_vehicle_id, d.emergency_contact, d.documents,
		       d.created_at, d.updated_at
		FROM drivers d
		WHERE d.id = $1 AND d.deleted_at IS NULL
	`
	
	d := &Driver{}
	var docsJSON []byte
	
	err := r.db.QueryRow(ctx, query, id).Scan(
		&d.ID, &d.OrgID, &d.UserID, &d.Name, &d.Email, &d.Phone,
		&d.LicenseNumber, &d.LicenseExpiry, &d.Status, &d.Rating,
		&d.BehaviorScore, &d.TotalTrips, &d.TotalDistanceKm,
		&d.CurrentVehicleID, &d.EmergencyContact, &docsJSON,
		&d.CreatedAt, &d.UpdatedAt,
	)
	
	if err == pgx.ErrNoRows {
		return nil, fmt.Errorf("driver not found")
	}
	if err != nil {
		return nil, err
	}
	
	json.Unmarshal(docsJSON, &d.Documents)
	return d, nil
}

func (r *Repository) ListByOrg(ctx context.Context, orgID, status string) ([]*Driver, error) {
	where := "d.org_id = $1 AND d.deleted_at IS NULL"
	args := []interface{}{orgID}
	
	if status != "" {
		where += " AND d.status = $2"
		args = append(args, status)
	}
	
	query := fmt.Sprintf(`
		SELECT d.id, d.name, d.email, d.phone, d.status, d.rating,
		       d.behavior_score, d.current_vehicle_id,
		       v.registration_number as vehicle_reg
		FROM drivers d
		LEFT JOIN vehicles v ON d.current_vehicle_id = v.id
		WHERE %s
		ORDER BY d.created_at DESC
	`, where)
	
	rows, err := r.db.Query(ctx, query, args...)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	
	var drivers []*Driver
	for rows.Next() {
		d := &Driver{}
		var vehicleReg *string
		
		err := rows.Scan(
			&d.ID, &d.Name, &d.Email, &d.Phone, &d.Status, &d.Rating,
			&d.BehaviorScore, &d.CurrentVehicleID, &vehicleReg,
		)
		if err != nil {
			return nil, err
		}
		drivers = append(drivers, d)
	}
	
	return drivers, nil
}

func (r *Repository) Update(ctx context.Context, id string, updates map[string]interface{}) error {
	if len(updates) == 0 {
		return nil
	}
	
	setParts := []string{}
	args := []interface{}{id}
	argCount := 1
	
	for field, value := range updates {
		argCount++
		setParts = append(setParts, fmt.Sprintf("%s = $%d", field, argCount))
		args = append(args, value)
	}
	
	query := fmt.Sprintf("UPDATE drivers SET %s, updated_at = NOW() WHERE id = $1",
		strings.Join(setParts, ", "))
	
	_, err := r.db.Exec(ctx, query, args...)
	return err
}

func (r *Repository) UpdateCurrentVehicle(ctx context.Context, driverID string, vehicleID *string) error {
	_, err := r.db.Exec(ctx,
		"UPDATE drivers SET current_vehicle_id = $1, updated_at = NOW() WHERE id = $2",
		vehicleID, driverID)
	return err
}

func (r *Repository) IncrementStats(ctx context.Context, driverID string, distance float64) error {
	_, err := r.db.Exec(ctx, `
		UPDATE drivers 
		SET total_trips = total_trips + 1,
		    total_distance_km = total_distance_km + $1,
		    updated_at = NOW()
		WHERE id = $2`,
		distance, driverID)
	return err
}

func (r *Repository) UpdateBehaviorScore(ctx context.Context, driverID string, delta int) error {
	_, err := r.db.Exec(ctx, `
		UPDATE drivers 
		SET behavior_score = GREATEST(0, LEAST(100, behavior_score + $1)),
		    updated_at = NOW()
		WHERE id = $2`,
		delta, driverID)
	return err
}

func (r *Repository) SoftDelete(ctx context.Context, id string) error {
	_, err := r.db.Exec(ctx,
		"UPDATE drivers SET deleted_at = NOW(), status = 'inactive' WHERE id = $1",
		id)
	return err
}
```

