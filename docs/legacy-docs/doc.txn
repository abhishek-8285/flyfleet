func (s *Service) Start(ctx context.Context, tripID, driverID string) (*Trip, error) {
	trip, err := s.repo.GetByID(ctx, tripID)
	if err != nil {
		return nil, err
	}
	
	if trip.DriverID != driverID {
		return nil, fmt.Errorf("unauthorized")
	}
	
	if trip.Status != "planned" && trip.Status != "paused" {
		return nil, fmt.Errorf("trip cannot be started from status: %s", trip.Status)
	}
	
	now := time.Now()
	updates := map[string]interface{}{
		"status":       "in_progress",
		"started_at":   pgtype.Timestamptz{Time: now, Valid: true},
		"start_location": "", // Get from last GPS
	}
	
	if err := s.repo.Update(ctx, tripID, updates); err != nil {
		return nil, err
	}
	
	// Update vehicle status
	// Notify via WebSocket
	
	return s.repo.GetByID(ctx, tripID)
}

func (s *Service) Complete(ctx context.Context, tripID, driverID string, req *CompleteRequest) (*Trip, error) {
	trip, err := s.repo.GetByID(ctx, tripID)
	if err != nil {
		return nil, err
	}
	
	if trip.DriverID != driverID {
		return nil, fmt.Errorf("unauthorized")
	}
	
	if trip.Status != "in_progress" {
		return nil, fmt.Errorf("trip not in progress")
	}
	
	now := time.Now()
	duration := now.Sub(*trip.StartedAt)
	
	updates := map[string]interface{}{
		"status":          "completed",
		"ended_at":        pgtype.Timestamptz{Time: now, Valid: true},
		"actual_distance": req.ActualDistanceKm,
		"actual_duration": int(duration.Minutes()),
		"end_location":    "", // Get from GPS
		"fuel_consumed":   req.FuelConsumedLiters,
		"idle_time_minutes": req.IdleTimeMinutes,
		"pod_documents":   req.PODDocuments,
	}
	
	if err := s.repo.Update(ctx, tripID, updates); err != nil {
		return nil, err
	}
	
	// Update driver stats
	// Update vehicle odometer
	// Calculate and store profitability
	
	return s.repo.GetByID(ctx, tripID)
}

func (s *Service) Get(ctx context.Context, id string) (*Trip, error) {
	return s.repo.GetByID(ctx, id)
}

func (s *Service) List(ctx context.Context, filter ListFilter) ([]*Trip, int, error) {
	return s.repo.List(ctx, filter)
}

func (s *Service) Cancel(ctx context.Context, tripID, reason string) error {
	return s.repo.Update(ctx, tripID, map[string]interface{}{
		"status": "cancelled",
		"cancellation_reason": reason,
	})
}

