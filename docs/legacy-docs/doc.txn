## K. TESTING SUITE

**`backend/internal/tests/integration/api_test.go`**
```go
package integration

import (
	"bytes"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"testing"

	"fleet-platform/backend/internal/auth"

	"github.com/gin-gonic/gin"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/suite"
)

type APITestSuite struct {
	suite.Suite
	router *gin.Engine
	token  string
}

func (s *APITestSuite) SetupSuite() {
	gin.SetMode(gin.TestMode)
	// Setup test database and router
	s.router = setupTestRouter()
	
	// Get auth token
	s.token = s.getAuthToken()
}

func (s *APITestSuite) getAuthToken() string {
	body := `{"email":"admin@fleet.local","password":"password"}`
	req := httptest.NewRequest("POST", "/api/v1/auth/login", bytes.NewBufferString(body))
	req.Header.Set("Content-Type", "application/json")
	
	w := httptest.NewRecorder()
	s.router.ServeHTTP(w, req)
	
	var resp map[string]interface{}
	json.Unmarshal(w.Body.Bytes(), &resp)
	return resp["access_token"].(string)
}

func (s *APITestSuite) TestCreateVehicle() {
	body := `{
		"registration_number": "MH12AB1234",
		"type": "truck",
		"make": "Tata",
		"model": "Ace",
		"year": 2023
	}`
	
	req := httptest.NewRequest("POST", "/api/v1/vehicles", bytes.NewBufferString(body))
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("Authorization", "Bearer "+s.token)
	
	w := httptest.NewRecorder()
	s.router.ServeHTTP(w, req)
	
	assert.Equal(s.T(), http.StatusCreated, w.Code)
	
	var resp map[string]interface{}
	json.Unmarshal(w.Body.Bytes(), &resp)
	assert.NotEmpty(s.T(), resp["id"])
	assert.Equal(s.T(), "MH12AB1234", resp["registration_number"])
}

func (s *APITestSuite) TestTelemetryIngestion() {
	// First create and enroll a device to get API key
	
	body := `{
		"vehicle_id": "test-vehicle-id",
		"latitude": 19.0760,
		"longitude": 72.8777,
		"speed": 45.5,
		"timestamp": 1704067200
	}`
	
	req := httptest.NewRequest("POST", "/device/telemetry/gps", bytes.NewBufferString(body))
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("X-API-Key", "test-device-api-key")
	
	w := httptest.NewRecorder()
	s.router.ServeHTTP(w, req)
	
	assert.Equal(s.T(), http.StatusAccepted, w.Code)
}

func (s *APITestSuite) TestGeofenceAlert() {
	// Create geofence
	gfBody := `{
		"name": "Test Zone",
		"type": "circle",
		"center": {"lat": 19.0760, "lng": 72.8777},
		"radius_meters": 500,
		"entry_alert": true,
		"exit_alert": true
	}`
	
	req := httptest.NewRequest("POST", "/api/v1/geofences", bytes.NewBufferString(gfBody))
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("Authorization", "Bearer "+s.token)
	
	w := httptest.NewRecorder()
	s.router.ServeHTTP(w, req)
	assert.Equal(s.T(), http.StatusCreated, w.Code)
	
	// Send GPS inside geofence
	// Verify alert created
}

func TestAPISuite(t *testing.T) {
	suite.Run(t, new(APITestSuite))
}
```

