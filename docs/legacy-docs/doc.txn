## F. COMPLETE DEVICE MANAGEMENT

**`backend/internal/device/service.go`**
```go
package device

import (
	"context"
	"crypto/sha256"
	"encoding/base64"
	"fmt"
	"time"

	"fleet-platform/backend/internal/auth"
	"go.uber.org/zap"
)

type Service struct {
	repo   *Repository
	nats   interface{} // NATS connection
	logger *zap.Logger
}

func NewService(repo *Repository, nats interface{}, logger *zap.Logger) *Service {
	return &Service{repo: repo, nats: nats, logger: logger}
}

func (s *Service) Enroll(ctx context.Context, req *EnrollRequest) (*Device, string, error) {
	// Validate IMEI format
	if len(req.IMEI) != 15 {
		return nil, "", fmt.Errorf("invalid IMEI format")
	}

	// Check if device already enrolled
	existing, _ := s.repo.GetByIMEI(ctx, req.IMEI)
	if existing != nil {
		return nil, "", fmt.Errorf("device already enrolled")
	}

	// Generate API key
	apiKey := auth.GenerateRandomToken()
	apiKeyHash := hashAPIKey(apiKey)

	device := &Device{
		OrgID:       req.OrgID,
		DeviceType:  req.DeviceType,
		IMEI:        req.IMEI,
		SerialNumber: req.SerialNumber,
		Model:       req.Model,
		APIKeyHash:  apiKeyHash,
		Status:      "pending", // Pending assignment
		Metadata:    req.Metadata,
	}

	if err := s.repo.Create(ctx, device); err != nil {
		return nil, "", err
	}

	s.logger.Info("device enrolled", zap.String("imei", req.IMEI), zap.String("type", req.DeviceType))

	// Return device with plaintext API key (shown only once)
	return device, apiKey, nil
}

func (s *Service) AssignToVehicle(ctx context.Context, deviceID, vehicleID, orgID string) error {
	device, err := s.repo.GetByID(ctx, deviceID)
	if err != nil {
		return err
	}
	if device.OrgID != orgID {
		return fmt.Errorf("unauthorized")
	}

	if err := s.repo.AssignVehicle(ctx, deviceID, vehicleID); err != nil {
		return err
	}

	// Activate device
	s.repo.UpdateStatus(ctx, deviceID, "active")

	// Send configuration update
	s.sendConfigUpdate(deviceID)

	return nil
}

func (s *Service) ValidateAPIKey(ctx context.Context, apiKey string) (*Device, error) {
	hash := hashAPIKey(apiKey)
	device, err := s.repo.GetByAPIKeyHash(ctx, hash)
	if err != nil {
		return nil, fmt.Errorf("invalid API key")
	}

	if device.Status != "active" {
		return nil, fmt.Errorf("device not active")
	}

	// Update last seen
	s.repo.UpdateLastSeen(ctx, device.ID)

	return device, nil
}

func (s *Service) GetConfig(ctx context.Context, deviceID string) (*DeviceConfig, error) {
	device, err := s.repo.GetByID(ctx, deviceID)
	if err != nil {
		return nil, err
	}

	config := &DeviceConfig{
		DeviceID:        device.ID,
		VehicleID:       device.VehicleID,
		GPSInterval:     5000,  // 5 seconds
		OBDInterval:     30000, // 30 seconds
		BatchSize:       100,
		UploadInterval:  60000, // 1 minute
		OfflineRetention: 7 * 24 * time.Hour,
		GeofenceCheck:   true,
		HarshEventThreshold: 3.5, // G-force
	}

	return config, nil
}

func (s *Service) RotateAPIKey(ctx context.Context, deviceID, orgID string) (string, error) {
	device, err := s.repo.GetByID(ctx, deviceID)
	if err != nil {
		return "", err
	}
	if device.OrgID != orgID {
		return "", fmt.Errorf("unauthorized")
	}

	newKey := auth.GenerateRandomToken()
	newHash := hashAPIKey(newKey)

	if err := s.repo.UpdateAPIKey(ctx, deviceID, newHash); err != nil {
		return "", err
	}

	return newKey, nil
}

func (s *Service) sendConfigUpdate(deviceID string) {
	// Publish to NATS for device to pick up
}

func hashAPIKey(key string) string {
	h := sha256.New()
	h.Write([]byte(key))
	return base64.URLEncoding.EncodeToString(h.Sum(nil))
}
```

