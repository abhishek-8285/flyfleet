                isOnline = uiState.isOnline,
                onToggleOnline = { viewModel.toggleOnlineStatus() }
            )
            
            Spacer(modifier = Modifier.height(16.dp))
            
            // Active Trip Card (if any)
            uiState.activeTrip?.let { trip ->
                ActiveTripCard(
                    trip = trip,
                    onNavigate = { 
                        // Open Google Maps with route
                        openNavigation(context, trip.nextWaypoint)
                    },
                    onSOS = { showSOSDialog = true }
