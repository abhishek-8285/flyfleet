## 9. SECURITY ARCHITECTURE

### 9.1 Authentication Flow

```go
// auth/middleware.go
package auth

import (
    "github.com/golang-jwt/jwt/v5"
    "golang.org/x/crypto/bcrypt"
)

// JWT Claims structure
type Claims struct {
    UserID   string   `json:"user_id"`
    OrgID    string   `json:"org_id"`
    Role     string   `json:"role"`
    Permissions []string `json:"permissions"`
    DeviceID string   `json:"device_id,omitempty"`
    jwt.RegisteredClaims
}

// Device Authentication (for OBD/Android)
type DeviceAuth struct {
    DeviceID   string
    VehicleID  string
    SecretHash string
}

func DeviceAuthMiddleware() gin.HandlerFunc {
    return func(c *gin.Context) {
        deviceKey := c.GetHeader("X-Device-Key")
        if deviceKey == "" {
            c.AbortWithStatusJSON(401, gin.H{"error": "missing device key"})
            return
        }
        
        // Validate against database
        device, err := validateDeviceKey(deviceKey)
        if err != nil {
            c.AbortWithStatusJSON(401, gin.H{"error": "invalid device"})
            return
        }
        
        // Set context
        c.Set("device_id", device.DeviceID)
        c.Set("vehicle_id", device.VehicleID)
        c.Set("org_id", device.OrgID)
        c.Next()
    }
}

// Human User Authentication
func JWTMiddleware() gin.HandlerFunc {
    return func(c *gin.Context) {
        authHeader := c.GetHeader("Authorization")
        tokenString := strings.Replace(authHeader, "Bearer ", "", 1)
        
        token, err := jwt.ParseWithClaims(tokenString, &Claims{}, func(token *jwt.Token) (interface{}, error) {
            return []byte(config.JWTSecret), nil
        })
        
        if claims, ok := token.Claims.(*Claims); ok && token.Valid {
            c.Set("user_id", claims.UserID)
            c.Set("org_id", claims.OrgID)
            c.Set("role", claims.Role)
            c.Set("permissions", claims.Permissions)
            
            // Check permission for this route
            requiredPerm := c.GetString("required_permission")
            if requiredPerm != "" && !hasPermission(claims.Permissions, requiredPerm) {
                c.AbortWithStatusJSON(403, gin.H{"error": "insufficient permissions"})
                return
            }
            
            c.Next()
        } else {
            c.AbortWithStatusJSON(401, gin.H{"error": "invalid token"})
        }
    }
}
```

### 9.2 Encryption Strategy

| Data | Encryption | Implementation |
|------|-----------|----------------|
| **Database at-rest** | AES-256 | PostgreSQL pgcrypto extension |
| **API Transport** | TLS 1.3 | Caddy auto-HTTPS (Let's Encrypt) |
| **Device Keys** | bcrypt + HMAC | Store hash only |
| **Video Storage** | AES-256-GCM | MinIO server-side encryption |
| **Offline Cache** | SQLCipher | Android Room with encryption |
| **MQTT** | TLS 1.3 | NATS built-in |

### 9.3 Tamper Detection (Android)

```kotlin
// SecurityManager.kt
class SecurityManager @Inject constructor(
    private val context: Context
) {
    fun verifyIntegrity(): Boolean {
        // 1. Check if device is rooted
        if (isDeviceRooted()) {
            triggerSecurityAlert("ROOT_DETECTED")
            return false
        }
        
        // 2. Check if app is debug build (in production)
        if (BuildConfig.DEBUG && !BuildConfig.ALLOW_DEBUG) {
            triggerSecurityAlert("DEBUG_BUILD")
            return false
        }
        
        // 3. Check if running in emulator
        if (isEmulator()) {
            triggerSecurityAlert("EMULATOR_DETECTED")
            return false
        }
        
        // 4. Verify app signature
        if (!verifyAppSignature()) {
            triggerSecurityAlert("SIGNATURE_MISMATCH")
            return false
        }
        
        // 5. Check if Mock Locations enabled
        if (Settings.Secure.getString(context.contentResolver, 
            Settings.Secure.ALLOW_MOCK_LOCATION) != "0") {
            triggerSecurityAlert("MOCK_LOCATION_ENABLED")
            return false
        }
        
        return true
    }
    
    private fun isDeviceRooted(): Boolean {
        val paths = arrayOf(
            "/system/app/Superuser.apk",
            "/sbin/su",
            "/system/bin/su",
            "/system/xbin/su",
            "/data/local/xbin/su"
        )
        return paths.any { File(it).exists() }
    }
    
    fun triggerSecurityAlert(type: String) {
        // Send immediate alert to server
        CoroutineScope(Dispatchers.IO).launch {
            api.postSecurityAlert(SecurityAlert(
                type = type,
                deviceInfo = getDeviceInfo(),
                timestamp = System.currentTimeMillis()
            ))
        }
        
        // Disable functionality based on severity
        when (type) {
            "ROOT_DETECTED" -> disableApp()
            "MOCK_LOCATION_ENABLED" -> disableLocationFeatures()
        }
    }
}
```

