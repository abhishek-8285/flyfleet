## 10. MONITORING STACK (Free & Open Source)

### 10.1 Components

| Purpose | Tool | Resource Usage |
|---------|------|---------------|
| **Metrics** | VictoriaMetrics | 100MB RAM, replaces Prometheus |
| **Visualization** | Grafana | 100MB RAM |
| **Logs** | Loki (Grafana Labs) | 50MB RAM, replaces ELK |
| **Tracing** | Jaeger | 200MB RAM |
| **Uptime** | Uptime Kuma | Node.js, minimal |
| **Alerts** | AlertManager (Victoria) | Built-in |

### 10.2 Setup (Phase 1 on Laptop)

```bash
# 1. VictoriaMetrics (single binary)
wget https://github.com/VictoriaMetrics/VictoriaMetrics/releases/download/v1.93.0/victoria-metrics-linux-amd64-v1.93.0.tar.gz
tar -xzf victoria-metrics-linux-amd64-v1.93.0.tar.gz

# Run with retention 30 days (laptop storage constraint)
./victoria-metrics-prod \
    -retentionPeriod=30d \
    -storageDataPath=/var/lib/victoria \
    -httpListenAddr=:8428

# 2. Grafana
sudo apt-get install -y software-properties-common
sudo add-apt-repository "deb https://packages.grafana.com/oss/deb stable main"
wget -q -O - https://packages.grafana.com/gpg.key | sudo apt-key add -
sudo apt-get update
sudo apt-get install grafana

sudo systemctl enable --now grafana-server

# 3. Loki (log aggregation)
wget https://github.com/grafana/loki/releases/download/v2.9.0/loki-linux-amd64.zip
unzip loki-linux-amd64.zip

cat > loki-config.yaml << 'EOF'
auth_enabled: false
server:
  http_listen_port: 3100
ingester:
  lifecycler:
    address: 127.0.0.1
    ring:
      kvstore:
        store: inmemory
      replication_factor: 1
  chunk_idle_period: 5m
  max_chunk_age: 1h
schema_config:
  configs:
    - from: 2020-10-24
      store: boltdb
      object_store: filesystem
      schema: v11
      index:
        prefix: index_
        period: 168h
storage_config:
  boltdb:
    directory: /tmp/loki/index
  filesystem:
    directory: /tmp/loki/chunks
EOF

./loki-linux-amd64 -config.file=loki-config.yaml

# 4. Promtail (log shipper for Go apps)
cat > promtail-config.yaml << 'EOF'
server:
  http_listen_port: 9080
positions:
  filename: /tmp/positions.yaml
clients:
  - url: http://localhost:3100/loki/api/v1/push
scrape_configs:
  - job_name: fleet-platform
    static_configs:
      - targets:
          - localhost
        labels:
          job: fleet-api
          __path__: /var/log/fleet/*.log
EOF

./promtail-linux-amd64 -config.file=promtail-config.yaml
```

### 10.3 Go Application Instrumentation

```go
// telemetry/metrics.go
package telemetry

import (
    "github.com/VictoriaMetrics/metrics"
    "github.com/gin-gonic/gin"
)

var (
    // Counters
    HttpRequestsTotal = metrics.NewCounterVec(`http_requests_total`, 
        []string{"method", "endpoint", "status"})
    TelemetryMessagesTotal = metrics.NewCounter(`telemetry_messages_total`)
    ActiveVehicles = metrics.NewGauge(`active_vehicles`, func() float64 {
        return float64(getActiveVehicleCount())
    })
    
    // Histograms
    HttpRequestDuration = metrics.NewHistogram(`http_request_duration_seconds`)
    GpsProcessingLatency = metrics.NewHistogram(`gps_processing_latency_seconds`)
)

// Gin middleware
func MetricsMiddleware() gin.HandlerFunc {
    return func(c *gin.Context) {
        start := time.Now()
        
        c.Next()
        
        duration := time.Since(start).Seconds()
        status := strconv.Itoa(c.Writer.Status())
        
        HttpRequestsTotal.WithLabelValues(c.Request.Method, c.FullPath(), status).Inc()
        HttpRequestDuration.Update(duration)
    }
}

// Log with Loki format (JSON)
func LogWithContext(ctx context.Context, level string, message string, fields map[string]interface{}) {
    logEntry := map[string]interface{}{
        "timestamp": time.Now().UnixNano(),
        "level":     level,
        "message":   message,
        "trace_id":  ctx.Value("trace_id"),
        "org_id":    ctx.Value("org_id"),
    }
    for k, v := range fields {
        logEntry[k] = v
    }
    
    jsonLog, _ := json.Marshal(logEntry)
    fmt.Println(string(jsonLog)) // Promtail picks this up
}
```

