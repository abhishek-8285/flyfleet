## 7. MONITORING & ALERTING

### 7.1 Prometheus Rules

**File: `monitoring/prometheus/rules.yml`**

```yaml
groups:
  - name: fleet-alerts
    interval: 30s
    rules:
      - alert: FleetAPIDown
        expr: up{job="fleet-api"} == 0
        for: 1m
        labels:
          severity: critical
          team: platform
        annotations:
          summary: "Fleet API is down"
          description: "Fleet API on {{ $labels.instance }} has been down for more than 1 minute"

      - alert: HighErrorRate
        expr: |
          (
            sum(rate(fleet_http_requests_total{status=~"5.."}[5m]))
            /
            sum(rate(fleet_http_requests_total[5m]))
          ) > 0.05
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "High error rate on API"
          description: "Error rate is {{ $value | humanizePercentage }}"

      - alert: DatabaseConnectionsHigh
        expr: |
          pg_stat_activity_count{state="active"} 
          / 
          pg_settings_max_connections > 0.8
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "Database connections running high"

      - alert: GPSIngestionLag
        expr: |
          time() - fleet_last_gps_timestamp > 300
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "GPS ingestion lag detected"
          description: "No GPS data received in 5 minutes"

      - alert: DiskSpaceLow
        expr: |
          (
            node_filesystem_avail_bytes{mountpoint="/data"} 
            / 
            node_filesystem_size_bytes{mountpoint="/data"}
          ) < 0.1
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Disk space critically low on {{ $labels.instance }}"

      - alert: BackupFailed
        expr: |
          time() - backup_last_success_timestamp > 90000
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Database backup has not run in 25 hours"

      - alert: VehicleOfflineSpike
        expr: |
          (
            fleet_vehicles_offline 
            / 
            fleet_vehicles_total
          ) > 0.3
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Large number of vehicles offline"
          description: "{{ $value | humanizePercentage }} of vehicles are offline"
```

