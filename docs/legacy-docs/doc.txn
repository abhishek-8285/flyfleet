  -H "X-API-Key: test-device-key" \
  -d '{"vehicle_id":"VEHICLE_UUID","latitude":12.9716,"longitude":77.5946,"speed":45,"timestamp":'$(date +%s)'}'

# 5. Query Locations
curl -s "http://localhost:8080/api/v1/vehicles/VEHICLE_UUID/locations" \
  -H "Authorization: Bearer $TOKEN" | jq .
```

