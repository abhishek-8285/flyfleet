## 6. DEVICE PROTOCOL & FIRMWARE

### 6.1 OBD-II Integration (Cheap Bluetooth ELM327)

```cpp
// Arduino/ESP32 Firmware for OBD Bridge
#include <BluetoothSerial.h>
#include <Arduino_JSON.h>

BluetoothSerial SerialBT;
HardwareSerial OBD(1);  // UART1

struct Telemetry {
  int rpm;
  int speed;
  float coolantTemp;
  int engineLoad;
  float fuelLevel;
  char vin[18];
  char dtcs[10][6];  // Up to 10 DTCs
};

void setup() {
  Serial.begin(115200);
  OBD.begin(38400, SERIAL_8N1, 16, 17);  // RX, TX
  SerialBT.begin("FLEET-OBD-" + String(ESP.getEfuseMac()));
  
  // Initialize ELM327
  sendOBDCommand("ATZ");      // Reset
  sendOBDCommand("ATE0");     // Echo off
  sendOBDCommand("ATL1");     // Linefeeds on
  sendOBDCommand("ATS0");     // Spaces off
  sendOBDCommand("ATSP0");    // Auto protocol
}

void loop() {
  Telemetry data = readOBDData();
  
  JSONVar payload;
  payload["vehicle_id"] = VEHICLE_ID;  // Configured via BLE
  payload["timestamp"] = millis();
  payload["rpm"] = data.rpm;
  payload["speed"] = data.speed;
  payload["coolant_temp"] = data.coolantTemp;
  payload["fuel_level"] = data.fuelLevel;
  payload["dtcs"] = data.dtcs;
  
  String json = JSON.stringify(payload);
  
  // Send via BLE to Android app, or WiFi/MQTT if ESP32-S3 with WiFi
  SerialBT.println(json);
  
  delay(5000);  // Read every 5 seconds
}

Telemetry readOBDData() {
  Telemetry t = {0};
  
  // RPM: Service 01 PID 0C
  String rpmResp = sendOBDCommand("010C");
  if (rpmResp.length() > 4) {
    int A = hexToInt(rpmResp.substring(4, 6));
    int B = hexToInt(rpmResp.substring(6, 8));
    t.rpm = ((A * 256) + B) / 4;
  }
  
  // Speed: Service 01 PID 0D
  String speedResp = sendOBDCommand("010D");
  if (speedResp.length() > 4) {
    t.speed = hexToInt(speedResp.substring(4, 6));
  }
  
  // Coolant: Service 01 PID 05
  String tempResp = sendOBDCommand("0105");
  if (tempResp.length() > 4) {
    t.coolantTemp = hexToInt(tempResp.substring(4, 6)) - 40;
  }
  
  // Fuel Level: Service 01 PID 2F
  String fuelResp = sendOBDCommand("012F");
  if (fuelResp.length() > 4) {
    int A = hexToInt(fuelResp.substring(4, 6));
    t.fuelLevel = (A * 100) / 255.0;
  }
  
  // Read DTCs: Service 03
  String dtcResp = sendOBDCommand("03");
  parseDTCs(dtcResp, t.dtcs);
  
  return t;
}

String sendOBDCommand(String cmd) {
  OBD.println(cmd);
  delay(100);
  
  String response = "";
  while (OBD.available()) {
    response += char(OBD.read());
  }
  
  return response;
}
```

### 6.2 Communication Protocol (MQTT Topics)

```yaml
# Topic Structure
fleet/{org_id}/{vehicle_id}/telemetry/gps
  QoS: 1 (at least once)
  Payload: {lat, lng, speed, ...}
  Retain: false

fleet/{org_id}/{vehicle_id}/telemetry/obd
  QoS: 1
  Payload: {rpm, temp, ...}

fleet/{org_id}/{vehicle_id}/events/safety
  QoS: 2 (exactly once for critical)
  Payload: {type, severity, video_url, ...}

fleet/{org_id}/{vehicle_id}/commands
  QoS: 2
  Payload: {command: "immobilize", reason: "...", auth_token: "..."}

fleet/{org_id}/{vehicle_id}/status
  QoS: 1, Retain: true
  Payload: {online: true, last_seen: "...", battery: 85}

# Broker: NATS (self-hosted)
# - MQTT adapter enabled
# - JetStream for persistence
# - Leaf nodes for edge resilience
```

### 6.3 Offline Storage Strategy (Android)

```kotlin
// Room Database Schema
@Database(
    entities = [
        GPSEntity::class,
        OBDEntity::class,
        VideoSegment::class,
        AlertEntity::class,
        TripEvent::class
    ],
    version = 1
)
abstract class OfflineDatabase : RoomDatabase() {
    abstract fun gpsDao(): GPSDao
    abstract fun obdDao(): OBDDao
    abstract fun videoDao(): VideoDao
    abstract fun alertDao(): AlertDao
}

@Entity(tableName = "gps_buffer")
data class GPSEntity(
    @PrimaryKey val id: Long = System.currentTimeMillis(),
    val vehicleId: String,
    val latitude: Double,
    val longitude: Double,
    val speed: Float,
    val accuracy: Float,
    val timestamp: Long,
    val synced: Boolean = false,
    val retryCount: Int = 0
)

// FIFO Buffer Management
class BufferManager @Inject constructor(
    private val db: OfflineDatabase,
    private val config: BufferConfig
) {
    // Auto-cleanup: Keep only last 7 days locally
    suspend fun cleanup() {
        val cutoff = System.currentTimeMillis() - (7 * 24 * 60 * 60 * 1000)
        db.gpsDao().deleteOlderThan(cutoff)
        db.videoDao().deleteUploadedAndOlderThan(cutoff)
    }
    
    // Priority sync: SOS > GPS > OBD > Video
    suspend fun getPendingSync(): List<Syncable> {
        return db.gpsDao().getUnsynced()
            .sortedBy { it.priority }
            .take(100)  // Batch size
    }
    
    // Storage quota management
    fun checkStorage(): Boolean {
        val stats = db.getStorageStats()
        return if (stats.videoBytes > config.maxVideoCacheBytes) {
            // Delete oldest non-critical videos
            db.videoDao().deleteOldestNonCritical(stats.videoBytes - config.maxVideoCacheBytes)
            true
        } else true
    }
}
```

