```

### 5.4 OTA Update Mechanism

```kotlin
// In-app update check (bypasses Google Play)
class UpdateManager(private val context: Context) {
    private val repoUrl = "https://fdroid.yourdomain.com/fdroid/repo/index.xml"
    
    suspend fun checkForUpdate(): UpdateInfo? {
        val currentVersion = BuildConfig.VERSION_CODE
        val latest = fetchLatestVersionFromRepo()
        
        return if (latest.versionCode > currentVersion) {
            UpdateInfo(
                version = latest.versionName,
                apkUrl = latest.apkUrl,
                mandatory = latest.isMandatory,
                releaseNotes = latest.changelog
            )
        } else null
    }
    
    fun downloadAndInstall(update: UpdateInfo) {
        val request = DownloadManager.Request(Uri.parse(update.apkUrl))
            .setDestinationInExternalFilesDir(context, "updates", "update.apk")
            .setNotificationVisibility(DownloadManager.Request.VISIBILITY_VISIBLE)
        
        val downloadId = downloadManager.enqueue(request)
        
        // Monitor download, then install
        val filter = IntentFilter(DownloadManager.ACTION_DOWNLOAD_COMPLETE)
        context.registerReceiver(object : BroadcastReceiver() {
            override fun onReceive(context: Context?, intent: Intent?) {
                installApk(downloadId)
            }
        }, filter)
    }
    
    private fun installApk(downloadId: Long) {
        val file = downloadManager.getUriForDownloadedFile(downloadId)
        val intent = Intent(Intent.ACTION_VIEW).apply {
            setDataAndType(file, "application/vnd.android.package-archive")
            flags = Intent.FLAG_ACTIVITY_NEW_TASK
            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
        }
        context.startActivity(intent)
    }
}
```

