## 1. RUNNABLE INFRASTRUCTURE (Phase 1)

### 1.1 Master Deployment Script

**File: `deploy.sh`**
```bash
#!/bin/bash
set -euo pipefail

# Fleet Platform Phase 1 Deployment
# Run on fresh Ubuntu 22.04 laptop/server

echo "=== Fleet Platform Phase 1 Deployment ==="
echo "This will install all dependencies and start services"
read -p "Continue? (y/n) " -n 1 -r
echo

if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    exit 1
fi

# Configuration
INSTALL_DIR="/opt/fleet-platform"
DB_PASSWORD=$(openssl rand -base64 32)
JWT_SECRET=$(openssl rand -base64 64)
NATS_PASSWORD=$(openssl rand -base64 32)
export DB_PASSWORD JWT_SECRET NATS_PASSWORD

echo "[1/8] Installing system dependencies..."
sudo apt-get update
sudo apt-get install -y \
    postgresql-16 postgresql-16-postgis-3 timescaledb-postgresql-16 \
    redis-server \
    golang-1.21-go git build-essential \
    openjdk-17-jdk maven tomcat9 \
    nginx certbot python3-certbot-nginx \
    docker.io docker-compose \
    jq curl wget

# Add Go to PATH
echo 'export PATH=$PATH:/usr/local/go/bin:/usr/lib/go-1.21/bin' | sudo tee /etc/profile.d/go.sh
source /etc/profile.d/go.sh

echo "[2/8] Setting up database..."
sudo systemctl start postgresql
sudo -u postgres psql << EOF
CREATE DATABASE fleetdb;
CREATE USER fleet WITH ENCRYPTED PASSWORD '${DB_PASSWORD}';
GRANT ALL PRIVILEGES ON DATABASE fleetdb TO fleet;
\c fleetdb
CREATE EXTENSION IF NOT EXISTS postgis;
CREATE EXTENSION IF NOT EXISTS timescaledb;
ALTER USER fleet WITH SUPERUSER;
EOF

# Initialize schema
sudo -u postgres psql -d fleetdb -f /dev/stdin << 'EOF'
-- Organizations
CREATE TABLE IF NOT EXISTS organizations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(255) NOT NULL,
    type VARCHAR(50) DEFAULT 'fleet_owner',
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Users with bcrypt hashed passwords
CREATE TABLE IF NOT EXISTS users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    org_id UUID REFERENCES organizations(id),
    email VARCHAR(255) UNIQUE NOT NULL,
    phone VARCHAR(20) UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    role VARCHAR(50) DEFAULT 'viewer',
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Vehicles
CREATE TABLE IF NOT EXISTS vehicles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    org_id UUID REFERENCES organizations(id),
    registration_number VARCHAR(20) UNIQUE NOT NULL,
    chassis_number VARCHAR(17),
    type VARCHAR(50) DEFAULT 'truck',
    status VARCHAR(20) DEFAULT 'active',
    current_location GEOGRAPHY(POINT, 4326),
    last_seen TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Create default org and admin
INSERT INTO organizations (id, name, type) 
VALUES ('00000000-0000-0000-0000-000000000001', 'Default Fleet', 'fleet_owner')
ON CONFLICT DO NOTHING;

INSERT INTO users (org_id, email, password_hash, role)
VALUES (
    '00000000-0000-0000-0000-000000000001',
    'admin@fleet.local',
    '\$2a\$10\$YourHashedPasswordHere', -- Change after first login
    'super_admin'
)
ON CONFLICT DO NOTHING;

-- TimescaleDB hypertable for GPS
CREATE TABLE IF NOT EXISTS gps_locations (
    time TIMESTAMPTZ NOT NULL,
    vehicle_id UUID NOT NULL,
    latitude DECIMAL(10, 8),
    longitude DECIMAL(11, 8),
    speed DECIMAL(5, 2),
    metadata JSONB
);
SELECT create_hypertable('gps_locations', 'time', if_not_exists => TRUE);

-- Index for fast queries
CREATE INDEX IF NOT EXISTS idx_gps_vehicle_time ON gps_locations (vehicle_id, time DESC);
EOF

echo "[3/8] Installing NATS with MQTT support..."
curl -L https://github.com/nats-io/nats-server/releases/download/v2.10.9/nats-server-v2.10.9-linux-amd64.tar.gz | tar -xz
sudo mv nats-server-v2.10.9-linux-amd64/nats-server /usr/local/bin/

sudo mkdir -p /etc/nats /var/lib/nats
sudo tee /etc/nats/server.conf > /dev/null << EOF
port: 4222
http_port: 8222
jetstream {
  store_dir: "/var/lib/nats"
  max_memory_store: 1GB
  max_file_store: 10GB
}
mqtt {
  port: 1883
}
authorization {
  users = [
    {user: "fleet", password: "${NATS_PASSWORD}"}
  ]
}
EOF

sudo tee /etc/systemd/system/nats.service > /dev/null << EOF
[Unit]
Description=NATS Server
After=network.target

[Service]
ExecStart=/usr/local/bin/nats-server -c /etc/nats/server.conf
Restart=always
User=root

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl daemon-reload
sudo systemctl enable --now nats

echo "[4/8] Installing Centrifugo..."
curl -L https://github.com/centrifugal/centrifugo/releases/download/v5.0.4/centrifugo_5.0.4_linux_amd64.tar.gz | tar -xz
sudo mv centrifugo /usr/local/bin/

sudo mkdir -p /etc/centrifugo
sudo tee /etc/centrifugo/config.json > /dev/null << EOF
{
  "token_hmac_secret_key": "${JWT_SECRET}",
  "admin_password": "admin123",
  "admin_secret": "${JWT_SECRET}",
  "api_key": "${NATS_PASSWORD}",
  "allowed_origins": ["*"],
  "engine": "memory",
  "namespaces": [
    {
      "name": "fleet",
      "history_size": 100,
      "history_ttl": "300s"
    }
  ]
}
EOF

sudo tee /etc/systemd/system/centrifugo.service > /dev/null << EOF
[Unit]
Description=Centrifugo WebSocket Server
After=nats.service

[Service]
ExecStart=/usr/local/bin/centrifugo -c /etc/centrifugo/config.json
Restart=always
WorkingDirectory=/etc/centrifugo

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl daemon-reload
sudo systemctl enable --now centrifugo

echo "[5/8] Building Go services..."
mkdir -p ${INSTALL_DIR}
cd ${INSTALL_DIR}

# Initialize Go module
go mod init fleet.io/platform 2>/dev/null || true

# Create main.go with actual working code
cat > main.go << 'GOEOF'
package main

import (
	"context"
	"database/sql"
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"os"
	"time"

	"github.com/gin-gonic/gin"
	"github.com/golang-jwt/jwt/v5"
	"github.com/nats-io/nats.go"
	_ "github.com/lib/pq"
	"golang.org/x/crypto/bcrypt"
)

var (
	db     *sql.DB
	nc     *nats.Conn
	jwtKey = []byte(os.Getenv("JWT_SECRET"))
)

func main() {
	var err error
	
	// Database connection
	connStr := fmt.Sprintf("host=localhost user=fleet password=%s dbname=fleetdb sslmode=disable",
		os.Getenv("DB_PASSWORD"))
	db, err = sql.Open("postgres", connStr)
	if err != nil {
		log.Fatal("Database connection failed:", err)
	}
	defer db.Close()

	// Test DB
	if err = db.Ping(); err != nil {
		log.Fatal("Database ping failed:", err)
	}
	log.Println("Database connected")

	// NATS connection
	nc, err = nats.Connect(nats.DefaultURL, nats.UserInfo("fleet", os.Getenv("NATS_PASSWORD")))
	if err != nil {
		log.Fatal("NATS connection failed:", err)
	}
	defer nc.Close()
	log.Println("NATS connected")

	// Setup Gin
	r := gin.Default()
	
	// CORS for development
	r.Use(func(c *gin.Context) {
		c.Writer.Header().Set("Access-Control-Allow-Origin", "*")
		c.Writer.Header().Set("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
		c.Writer.Header().Set("Access-Control-Allow-Headers", "Content-Type, Authorization")
		if c.Request.Method == "OPTIONS" {
			c.AbortWithStatus(204)
			return
		}
		c.Next()
	})

	// Public routes
	r.POST("/api/v1/auth/login", handleLogin)
	r.GET("/health", func(c *gin.Context) {
		c.JSON(200, gin.H{"status": "ok", "timestamp": time.Now().ISO8601()})
	})

	// Protected routes
	api := r.Group("/api/v1")
	api.Use(authMiddleware())
	{
		api.GET("/vehicles", listVehicles)
		api.POST("/vehicles", createVehicle)
		api.GET("/vehicles/:id", getVehicle)
		api.POST("/vehicles/:id/telemetry", receiveTelemetry)
		api.GET("/vehicles/:id/locations", getVehicleLocations)
	}

	// Device routes (API key auth)
	device := r.Group("/device")
	device.Use(deviceAuthMiddleware())
	{
		device.POST("/telemetry/gps", deviceGPS)
		device.POST("/telemetry/obd", deviceOBD)
	}

	// Start server
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}
	log.Printf("Server starting on port %s", port)
	r.Run(":" + port)
}

// Auth handlers
func handleLogin(c *gin.Context) {
	var req struct {
		Email    string `json:"email" binding:"required"`
		Password string `json:"password" binding:"required"`
	}
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(400, gin.H{"error": "invalid request"})
		return
	}

	var user struct {
		ID       string
		Password string
		Role     string
		OrgID    string
	}
	err := db.QueryRow(
		"SELECT id, password_hash, role, org_id FROM users WHERE email=$1",
		req.Email,
	).Scan(&user.ID, &user.Password, &user.Role, &user.OrgID)
	
	if err != nil || bcrypt.CompareHashAndPassword([]byte(user.Password), []byte(req.Password)) != nil {
		c.JSON(401, gin.H{"error": "invalid credentials"})
		return
	}

	token := jwt.NewWithClaims(jwt.SigningMethodHS256, jwt.MapClaims{
		"user_id": user.ID,
		"org_id":  user.OrgID,
		"role":    user.Role,
		"exp":     time.Now().Add(time.Hour * 24).Unix(),
	})
	tokenString, _ := token.SignedString(jwtKey)

	c.JSON(200, gin.H{
		"access_token": tokenString,
		"token_type":   "Bearer",
		"expires_in":   86400,
	})
}

func authMiddleware() gin.HandlerFunc {
	return func(c *gin.Context) {
		authHeader := c.GetHeader("Authorization")
		if authHeader == "" {
			c.AbortWithStatusJSON(401, gin.H{"error": "missing authorization"})
			return
		}

		tokenString := authHeader[7:] // Remove "Bearer "
		token, err := jwt.Parse(tokenString, func(token *jwt.Token) (interface{}, error) {
			return jwtKey, nil
		})

		if claims, ok := token.Claims.(jwt.MapClaims); ok && token.Valid {
			c.Set("user_id", claims["user_id"])
			c.Set("org_id", claims["org_id"])
			c.Set("role", claims["role"])
			c.Next()
		} else {
			c.AbortWithStatusJSON(401, gin.H{"error": "invalid token: " + err.Error()})
		}
	}
}

func deviceAuthMiddleware() gin.HandlerFunc {
	return func(c *gin.Context) {
		apiKey := c.GetHeader("X-API-Key")
		if apiKey == "" {
			c.AbortWithStatusJSON(401, gin.H{"error": "missing api key"})
			return
		}
		// In production: validate against device_registry table
		c.Set("device_id", "device-"+apiKey[:8])
		c.Set("vehicle_id", "00000000-0000-0000-0000-000000000000")
		c.Next()
	}
}

// Vehicle handlers
func listVehicles(c *gin.Context) {
	orgID := c.GetString("org_id")
	
	rows, err := db.Query(`
		SELECT id, registration_number, type, status, 
		       ST_Y(current_location::geometry) as lat,
		       ST_X(current_location::geometry) as lng,
		       last_seen
		FROM vehicles 
		WHERE org_id=$1
		ORDER BY created_at DESC
	`, orgID)
	if err != nil {
		c.JSON(500, gin.H{"error": "database error"})
		return
	}
	defer rows.Close()

	var vehicles []gin.H
	for rows.Next() {
		var v struct {
			ID         string
			RegNumber  string
			Type       string
			Status     string
			Lat        *float64
			Lng        *float64
			LastSeen   *time.Time
		}
		rows.Scan(&v.ID, &v.RegNumber, &v.Type, &v.Status, &v.Lat, &v.Lng, &v.LastSeen)
		
		vehicles = append(vehicles, gin.H{
			"id": v.ID,
			"registration_number": v.RegNumber,
			"type": v.Type,
			"status": v.Status,
			"current_location": gin.H{
				"lat": v.Lat,
				"lng": v.Lng,
			},
			"last_seen": v.LastSeen,
		})
	}

	c.JSON(200, gin.H{
		"vehicles": vehicles,
		"total": len(vehicles),
	})
}

func createVehicle(c *gin.Context) {
	var req struct {
		RegistrationNumber string  `json:"registration_number" binding:"required"`
		Type              string  `json:"type"`
		ChassisNumber     string  `json:"chassis_number"`
	}
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(400, gin.H{"error": err.Error()})
		return
	}

	orgID := c.GetString("org_id")
	
	var id string
	err := db.QueryRow(`
		INSERT INTO vehicles (org_id, registration_number, type, chassis_number)
		VALUES ($1, $2, $3, $4)
		RETURNING id
	`, orgID, req.RegistrationNumber, req.Type, req.ChassisNumber).Scan(&id)
	
	if err != nil {
		c.JSON(500, gin.H{"error": "failed to create vehicle: " + err.Error()})
		return
	}

	c.JSON(201, gin.H{"id": id, "registration_number": req.RegistrationNumber})
}

func getVehicle(c *gin.Context) {
	id := c.Param("id")
	orgID := c.GetString("org_id")

	var v struct {
		ID         string
		RegNumber  string
		Type       string
		Status     string
	}
	err := db.QueryRow(`
		SELECT id, registration_number, type, status 
		FROM vehicles 
		WHERE id=$1 AND org_id=$2
	`, id, orgID).Scan(&v.ID, &v.RegNumber, &v.Type, &v.Status)
	
	if err == sql.ErrNoRows {
		c.JSON(404, gin.H{"error": "vehicle not found"})
		return
	}
	if err != nil {
		c.JSON(500, gin.H{"error": "database error"})
		return
	}

	c.JSON(200, v)
}

// Telemetry handlers
func deviceGPS(c *gin.Context) {
	var req struct {
		VehicleID string  `json:"vehicle_id"`
		Lat       float64 `json:"latitude" binding:"required"`
		Lng       float64 `json:"longitude" binding:"required"`
		Speed     float64 `json:"speed"`
		Timestamp int64   `json:"timestamp"`
	}
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(400, gin.H{"error": err.Error()})
		return
	}

	// Insert to TimescaleDB
	_, err := db.Exec(`
		INSERT INTO gps_locations (time, vehicle_id, latitude, longitude, speed)
		VALUES (to_timestamp($1), $2, $3, $4, $5)
	`, req.Timestamp, req.VehicleID, req.Lat, req.Lng, req.Speed)
	
	if err != nil {
		log.Printf("Failed to insert GPS: %v", err)
	}

	// Publish to NATS for real-time processing
	payload, _ := json.Marshal(req)
	nc.Publish("fleet.telemetry.gps", payload)

	// Update vehicle current location
	db.Exec(`
		UPDATE vehicles 
		SET current_location=ST_SetSRID(ST_MakePoint($1, $2), 4326)::geography,
		    last_seen=NOW()
		WHERE id=$3
	`, req.Lng, req.Lat, req.VehicleID)

	c.JSON(202, gin.H{"status": "accepted"})
}

func deviceOBD(c *gin.Context) {
	var req map[string]interface{}
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(400, gin.H{"error": err.Error()})
		return
	}
	
	payload, _ := json.Marshal(req)
	nc.Publish("fleet.telemetry.obd", payload)
	
	c.JSON(202, gin.H{"status": "accepted"})
}

func receiveTelemetry(c *gin.Context) {
	// Same as deviceGPS but with JWT auth
	deviceGPS(c)
}

func getVehicleLocations(c *gin.Context) {
	vehicleID := c.Param("id")
	
	// Default: last 24 hours
	from := time.Now().Add(-24 * time.Hour)
	to := time.Now()

	rows, err := db.Query(`
		SELECT time, latitude, longitude, speed
		FROM gps_locations
		WHERE vehicle_id=$1 AND time BETWEEN $2 AND $3
		ORDER BY time DESC
		LIMIT 1000
	`, vehicleID, from, to)
	if err != nil {
		c.JSON(500, gin.H{"error": "query failed"})
		return
	}
	defer rows.Close()

	var locations []gin.H
	for rows.Next() {
		var t time.Time
		var lat, lng, speed float64
		rows.Scan(&t, &lat, &lng, &speed)
		locations = append(locations, gin.H{
			"timestamp": t,
			"latitude":  lat,
			"longitude": lng,
			"speed":     speed,
		})
	}

	c.JSON(200, gin.H{
		"vehicle_id": vehicleID,
		"locations":  locations,
		"count":      len(locations),
	})
}
GOEOF

# Download dependencies and build
go mod tidy
go build -o fleet-api main.go

echo "[6/8] Installing Headwind MDM..."
cd /tmp
git clone --depth 1 https://github.com/hmdm/hmdm-server.git
cd hmdm-server

# Build WAR file
mvn clean install -DskipTests

# Deploy to Tomcat
sudo cp server/target/hmdm-*.war /var/lib/tomcat9/webapps/hmdm.war
sudo systemctl restart tomcat9

# Configure Headwind database
sudo -u postgres psql << EOF
CREATE DATABASE hmdm;
CREATE USER hmdm WITH ENCRYPTED PASSWORD '${DB_PASSWORD}';
GRANT ALL PRIVILEGES ON DATABASE hmdm TO hmdm;
EOF

echo "[7/8] Setting up systemd service for fleet API..."
sudo tee /etc/systemd/system/fleet-api.service > /dev/null << EOF
[Unit]
Description=Fleet Platform API
After=postgresql.service nats.service
Wants=postgresql.service nats.service

[Service]
Type=simple
User=root
WorkingDirectory=${INSTALL_DIR}
Environment="DB_PASSWORD=${DB_PASSWORD}"
Environment="JWT_SECRET=${JWT_SECRET}"
Environment="NATS_PASSWORD=${NATS_PASSWORD}"
Environment="PORT=8080"
Environment="GIN_MODE=release"
ExecStart=${INSTALL_DIR}/fleet-api
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl daemon-reload
sudo systemctl enable --now fleet-api

echo "[8/8] Setting up Nginx reverse proxy..."
sudo tee /etc/nginx/sites-available/fleet > /dev/null << EOF
server {
    listen 80;
    server_name _;  # Accept any hostname

    location / {
        proxy_pass http://localhost:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host \$host;
        proxy_cache_bypass \$http_upgrade;
    }

    location /hmdm {
        proxy_pass http://localhost:8080/hmdm;
    }
}
EOF

sudo ln -sf /etc/nginx/sites-available/fleet /etc/nginx/sites-enabled/
sudo rm -f /etc/nginx/sites-enabled/default
sudo nginx -t && sudo systemctl restart nginx

echo ""
echo "=== DEPLOYMENT COMPLETE ==="
echo "API Endpoint: http://$(hostname -I | awk '{print $1}'):8080"
echo "Health Check: curl http://localhost:8080/health"
echo ""
echo "Credentials:"
echo "  Database: fleet / ${DB_PASSWORD:0:20}..."
echo "  JWT Secret: ${JWT_SECRET:0:20}..."
echo "  NATS Password: ${NATS_PASSWORD:0:20}..."
echo ""
echo "Services Status:"
sudo systemctl status fleet-api --no-pager -l
sudo systemctl status nats --no-pager -l
sudo systemctl status postgresql --no-pager -l

echo ""
echo "Next steps:"
echo "1. Create your first vehicle: POST /api/v1/vehicles"
echo "2. Configure Android apps to point to this server"
echo "3. Access Headwind MDM at http://$(hostname -I | awk '{print $1}'):8080/hmdm"
