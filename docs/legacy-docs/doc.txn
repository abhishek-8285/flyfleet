## 3. API CONTRACT

### 3.1 OpenAPI 3.0 Specification

**File: `api/openapi.yaml`**

```yaml
openapi: 3.0.3
info:
  title: Fleet Management API
  version: 1.0.0
  description: Production API for vehicle tracking and fleet management

servers:
  - url: https://api.fleet.local/v1
    description: Local development
  - url: https://fleet.example.com/api/v1
    description: Production

security:
  - BearerAuth: []
  - ApiKeyAuth: []

paths:
  # ==================== AUTHENTICATION ====================
  /auth/login:
    post:
      summary: User login
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [email, password]
              properties:
                email:
                  type: string
                  format: email
                  example: admin@fleet.local
                password:
                  type: string
                  format: password
                  example: SecurePass123!
                device_id:
                  type: string
                  description: Mobile device identifier
      responses:
        200:
          description: Login successful
          content:
            application/json:
              schema:
                type: object
                properties:
                  access_token:
                    type: string
                    example: eyJhbGciOiJIUzI1NiIs...
                  refresh_token:
                    type: string
                  expires_in:
                    type: integer
                    example: 3600
                  user:
                    $ref: '#/components/schemas/User'
        401:
          description: Invalid credentials
          headers:
            X-RateLimit-Remaining:
              schema:
                type: integer

  /auth/refresh:
    post:
      summary: Refresh access token
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [refresh_token]
              properties:
                refresh_token:
                  type: string
      responses:
        200:
          description: New tokens issued
        401:
          description: Invalid refresh token

  # ==================== VEHICLES ====================
  /vehicles:
    get:
      summary: List vehicles
      parameters:
        - name: status
          in: query
          schema:
            type: string
            enum: [active, inactive, maintenance]
        - name: driver_id
          in: query
          schema:
            type: string
            format: uuid
        - name: search
          in: query
          description: Search by registration number or driver name
          schema:
            type: string
        - name: limit
          in: query
          schema:
            type: integer
            default: 20
            maximum: 100
        - name: offset
          in: query
          schema:
            type: integer
            default: 0
      responses:
        200:
          description: Vehicle list
          headers:
            X-Total-Count:
              schema:
                type: integer
          content:
            application/json:
              schema:
                type: object
                properties:
                  vehicles:
                    type: array
                    items:
                      $ref: '#/components/schemas/Vehicle'
                  total:
                    type: integer

    post:
      summary: Create vehicle
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/VehicleCreate'
      responses:
        201:
          description: Vehicle created
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Vehicle'
        409:
          description: Duplicate registration number

  /vehicles/{vehicle_id}:
    parameters:
      - name: vehicle_id
        in: path
        required: true
        schema:
          type: string
          format: uuid
    
    get:
      summary: Get vehicle details
      responses:
        200:
          description: Vehicle details
          content:
            application/json:
              schema:
                allOf:
                  - $ref: '#/components/schemas/Vehicle'
                  - type: object
                    properties:
                      driver:
                        $ref: '#/components/schemas/User'
                      recent_locations:
                        type: array
                        items:
                          $ref: '#/components/schemas/GPSReading'
                      recent_events:
                        type: array
                        items:
                          $ref: '#/components/schemas/Event'

    put:
      summary: Update vehicle
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/VehicleUpdate'
      responses:
        200:
          description: Updated vehicle

    delete:
      summary: Soft delete vehicle
      responses:
        204:
          description: Deleted

  /vehicles/{vehicle_id}/locations:
    get:
      summary: Get vehicle location history
      parameters:
        - name: from
          in: query
          required: true
          schema:
            type: string
            format: date-time
        - name: to
          in: query
          required: true
          schema:
            type: string
            format: date-time
        - name: interval
          in: query
          description: Downsampling interval
          schema:
            type: string
            enum: [raw, 1m, 5m, 15m, 1h]
            default: raw
      responses:
        200:
          description: Location history
          content:
            application/json:
              schema:
                type: object
                properties:
                  vehicle_id:
                    type: string
                  from:
                    type: string
                    format: date-time
                  to:
                    type: string
                    format: date-time
                  locations:
                    type: array
                    items:
                      $ref: '#/components/schemas/GPSReading'
                  summary:
                    type: object
                    properties:
                      distance_km:
                        type: number
                      max_speed:
                        type: number
                      stops_count:
                        type: integer

  /vehicles/{vehicle_id}/immobilize:
    post:
      summary: Send immobilize command
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                reason:
                  type: string
                emergency:
                  type: boolean
                  default: false
      responses:
        202:
          description: Command queued
          content:
            application/json:
              schema:
                type: object
                properties:
                  command_id:
                    type: string
                    format: uuid
                  status:
                    type: string
                    enum: [queued, sent, acknowledged, failed]
                  eta_seconds:
                    type: integer

  # ==================== TELEMETRY (DEVICE API) ====================
  /telemetry/gps:
    post:
      summary: Submit GPS telemetry (device endpoint)
      security:
        - ApiKeyAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GPSPayload'
      responses:
        202:
          description: Accepted for processing
        429:
          description: Rate limit exceeded
          headers:
            Retry-After:
              schema:
                type: integer

  /telemetry/obd:
    post:
      summary: Submit OBD telemetry
      security:
        - ApiKeyAuth: []
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/OBDPAyload'
      responses:
        202:
          description: Accepted

  # ==================== TRIPS ====================
  /trips:
    get:
      summary: List trips
      parameters:
        - name: vehicle_id
          in: query
          schema:
            type: string
            format: uuid
        - name: driver_id
          in: query
          schema:
            type: string
            format: uuid
        - name: status
          in: query
          schema:
            type: string
            enum: [planned, in_progress, completed, cancelled]
        - name: from
          in: query
          schema:
            type: string
            format: date
        - name: to
          in: query
          schema:
            type: string
            format: date
      responses:
        200:
          description: Trip list
          content:
            application/json:
              schema:
                type: object
                properties:
                  trips:
                    type: array
                    items:
                      $ref: '#/components/schemas/Trip'

    post:
      summary: Create trip
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TripCreate'
      responses:
        201:
          description: Trip created

  /trips/{trip_id}/start:
    post:
      summary: Start trip (driver action)
      responses:
        200:
          description: Trip started
        409:
          description: Trip already in progress

  /trips/{trip_id}/complete:
    post:
      summary: Complete trip
      responses:
        200:
          description: Trip completed with summary

  # ==================== GEOFENCES ====================
  /geofences:
    get:
      summary: List geofences
      responses:
        200:
          description: Geofence list

    post:
      summary: Create geofence
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GeofenceCreate'
      responses:
        201:
          description: Geofence created

  # ==================== EVENTS & ALERTS ====================
  /events:
    get:
      summary: List events/alerts
      parameters:
        - name: severity
          in: query
          schema:
            type: array
            items:
              type: string
              enum: [info, warning, critical, emergency]
        - name: vehicle_id
          in: query
          schema:
            type: string
            format: uuid
        - name: unacknowledged_only
          in: query
          schema:
            type: boolean
      responses:
        200:
          description: Events list

  /events/{event_id}/acknowledge:
    post:
      summary: Acknowledge alert
      responses:
        200:
          description: Acknowledged

  # ==================== REAL-TIME ====================
  /ws/token:
    get:
      summary: Get WebSocket connection token
      responses:
        200:
          description: WebSocket token
          content:
            application/json:
              schema:
                type: object
                properties:
                  token:
                    type: string
                  url:
                    type: string
                    example: wss://fleet.example.com/connection/websocket

components:
  securitySchemes:
    BearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
    ApiKeyAuth:
      type: apiKey
      in: header
      name: X-API-Key

  schemas:
    User:
      type: object
      properties:
        id:
          type: string
          format: uuid
        email:
          type: string
        role:
          type: string
        org_id:
          type: string
          format: uuid

    Vehicle:
      type: object
      properties:
        id:
          type: string
          format: uuid
        registration_number:
          type: string
          example: KA01AB1234
        type:
          type: string
          enum: [truck, bus, car, bike, tempo]
        status:
          type: string
        current_location:
          $ref: '#/components/schemas/Location'
        last_location_at:
          type: string
          format: date-time
        current_driver:
          $ref: '#/components/schemas/User'

    VehicleCreate:
      type: object
      required: [registration_number, type]
      properties:
        registration_number:
          type: string
          pattern: '^[A-Z]{2}[0-9]{2}[A-Z]{1,2}[0-9]{4}$'
        chassis_number:
          type: string
          minLength: 17
          maxLength: 17
        type:
          type: string
        fuel_type:
          type: string

    GPSReading:
      type: object
      properties:
        time:
          type: string
          format: date-time
        latitude:
          type: number
          minimum: -90
          maximum: 90
        longitude:
          type: number
          minimum: -180
          maximum: 180
        speed:
          type: number
          minimum: 0
        heading:
          type: number
          minimum: 0
          maximum: 360
        ignition:
          type: boolean

    GPSPayload:
      type: object
      required: [vehicle_id, latitude, longitude, timestamp]
      properties:
        vehicle_id:
          type: string
          format: uuid
        latitude:
          type: number
        longitude:
          type: number
        speed:
          type: number
        heading:
          type: number
        accuracy:
          type: number
        timestamp:
          type: integer
          description: Unix timestamp
        ignition:
          type: boolean
        odometer_km:
          type: number

    Trip:
      type: object
      properties:
        id:
          type: string
        vehicle_id:
          type: string
        driver_id:
          type: string
        status:
          type: string
        started_at:
          type: string
          format: date-time
        ended_at:
          type: string
          format: date-time
        distance_km:
          type: number
        route:
          type: object

    Event:
      type: object
      properties:
        id:
          type: string
        time:
          type: string
          format: date-time
        event_type:
          type: string
        severity:
          type: string
        vehicle_id:
          type: string
        latitude:
          type: number
        longitude:
          type: number
        acknowledged:
          type: boolean

    GeofenceCreate:
      type: object
      required: [name, type, geometry]
      properties:
        name:
          type: string
        type:
          type: string
          enum: [circle, polygon]
        geometry:
          type: object
          description: GeoJSON geometry
        radius_meters:
          type: integer
        entry_alert:
          type: boolean
        exit_alert:
          type: boolean

    Location:
      type: object
      properties:
        lat:
          type: number
        lng:
          type: number
        accuracy:
          type: number
        timestamp:
          type: string
          format: date-time
```

### 3.2 Rate Limiting Policy

| Endpoint | Rate Limit | Burst |
|----------|-----------|-------|
| `POST /auth/login` | 5/min | 10 |
| `POST /telemetry/gps` | 12/min (1 per 5s) | 20 |
| `GET /vehicles` | 100/min | 200 |
| `GET /vehicles/{id}/locations` | 30/min | 50 |
| All other endpoints | 60/min | 100 |

