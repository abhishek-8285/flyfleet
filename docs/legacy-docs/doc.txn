## E. COMPLETE BILLING SERVICE

**`backend/internal/billing/service.go`**
```go
package billing

import (
	"context"
	"fmt"
	"time"

	"go.uber.org/zap"
)

type Service struct {
	repo   *Repository
	logger *zap.Logger
}

func NewService(repo *Repository, logger *zap.Logger) *Service {
	return &Service{repo: repo, logger: logger}
}

func (s *Service) GetSubscription(ctx context.Context, orgID string) (*Subscription, error) {
	return s.repo.GetSubscription(ctx, orgID)
}

func (s *Service) CreateSubscription(ctx context.Context, orgID string, planID string) (*Subscription, error) {
	plan, err := s.repo.GetPlan(ctx, planID)
	if err != nil {
		return nil, fmt.Errorf("plan not found")
	}

	sub := &Subscription{
		OrgID:     orgID,
		PlanID:    planID,
		Status:    "active",
		Amount:    plan.PriceMonthly,
		Currency:  "INR",
		Interval:  "month",
		CurrentPeriodStart: time.Now(),
		CurrentPeriodEnd:   time.Now().AddDate(0, 1, 0),
		Features:  plan.Features,
	}

	if err := s.repo.CreateSubscription(ctx, sub); err != nil {
		return nil, err
	}

	return sub, nil
}

func (s *Service) RecordUsage(ctx context.Context, orgID string, metric string, value float64) error {
	return s.repo.InsertUsage(ctx, &UsageRecord{
		OrgID:     orgID,
		Metric:    metric,
		Value:     value,
		Timestamp: time.Now(),
	})
}

func (s *Service) GetUsage(ctx context.Context, orgID string, from, to time.Time) (*UsageSummary, error) {
	records, err := s.repo.GetUsage(ctx, orgID, from, to)
	if err != nil {
		return nil, err
	}

	summary := &UsageSummary{
		PeriodStart: from,
		PeriodEnd:   to,
		Metrics:     make(map[string]float64),
	}

	for _, r := range records {
		summary.Metrics[r.Metric] += r.Value
	}

	// Calculate costs
	sub, _ := s.repo.GetSubscription(ctx, orgID)
	if sub != nil {
		summary.BillAmount = s.calculateBill(sub, summary.Metrics)
	}

	return summary, nil
}

func (s *Service) ListInvoices(ctx context.Context, orgID string) ([]*Invoice, error) {
	return s.repo.ListInvoices(ctx, orgID)
}

func (s *Service) GenerateInvoice(ctx context.Context, orgID string, period time.Time) (*Invoice, error) {
	// Calculate usage for period
	start := time.Date(period.Year(), period.Month(), 1, 0, 0, 0, 0, time.UTC)
	end := start.AddDate(0, 1, 0).Add(-time.Second)
	
	usage, err := s.GetUsage(ctx, orgID, start, end)
	if err != nil {
		return nil, err
	}

	invoice := &Invoice{
		OrgID:       orgID,
		InvoiceNumber: fmt.Sprintf("INV-%d%d-%d", period.Year(), period.Month(), time.Now().Unix()),
		Status:      "draft",
		PeriodStart: start,
		PeriodEnd:   end,
		Amount:      usage.BillAmount,
		Currency:    "INR",
		UsageSummary: usage,
		DueDate:     time.Now().AddDate(0, 0, 15),
	}

	if err := s.repo.CreateInvoice(ctx, invoice); err != nil {
		return nil, err
	}

	return invoice, nil
}

func (s *Service) calculateBill(sub *Subscription, metrics map[string]float64) float64 {
	base := sub.Amount
	
	// Overage calculations
	if vehicles, ok := metrics["active_vehicles"]; ok {
		included := sub.Features["max_vehicles"].(float64)
		if vehicles > included {
			base += (vehicles - included) * 100 // ₹100 per extra vehicle
		}
	}
	
	if gpsPoints, ok := metrics["gps_ingested"]; ok {
		included := sub.Features["max_gps_monthly"].(float64)
		if gpsPoints > included {
			base += (gpsPoints - included) * 0.001 // ₹0.001 per extra point
		}
	}
	
	return base
}
```

