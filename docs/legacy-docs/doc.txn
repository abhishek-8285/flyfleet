# Verify hypertables
psql -U fleet -d fleetdb -c "SELECT hypertable_name, chunk_time_interval, compression_enabled FROM timescaledb_information.hypertables;"

# Expected output:
# hypertable_name | chunk_time_interval | compression_enabled
