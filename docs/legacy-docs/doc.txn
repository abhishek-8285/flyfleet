**`web-admin/src/App.tsx`**
```typescript
import React from 'react';
import { BrowserRouter, Routes, Route, Navigate } from 'react-router-dom';
import { Provider } from 'react-redux';
import { store } from './store';
import Login from './pages/Login';
import Dashboard from './pages/Dashboard';
import Vehicles from './pages/Vehicles';
import LiveMap from './pages/LiveMap';
import Trips from './pages/Trips';
import Geofences from './pages/Geofences';
import Alerts from './pages/Alerts';
import Billing from './pages/Billing';
import Layout from './components/Layout';

const PrivateRoute: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const token = localStorage.getItem('token');
  return token ? <>{children}</> : <Navigate to="/login" />;
};

function App() {
  return (
    <Provider store={store}>
      <BrowserRouter>
        <Routes>
          <Route path="/login" element={<Login />} />
          <Route path="/" element={
            <PrivateRoute>
              <Layout />
            </PrivateRoute>
          }>
            <Route index element={<Dashboard />} />
            <Route path="vehicles" element={<Vehicles />} />
            <Route path="map" element={<LiveMap />} />
            <Route path="trips" element={<Trips />} />
            <Route path="geofences" element={<Geofences />} />
            <Route path="alerts" element={<Alerts />} />
            <Route path="billing" element={<Billing />} />
          </Route>
        </Routes>
      </BrowserRouter>
    </Provider>
  );
}

export default App;
```

**`web-admin/src/pages/LiveMap.tsx`**
```typescript
import React, { useEffect, useState } from 'react';
import { MapContainer, TileLayer, Marker, Popup, Polyline } from 'react-leaflet';
import L from 'leaflet';
import { useSelector, useDispatch } from 'react-redux';
import { fetchVehicles, selectVehicles } from '../store/vehiclesSlice';
import { wsConnect, wsDisconnect } from '../services/websocket';

const vehicleIcon = (heading: number, status: string) => L.divIcon({
  className: 'vehicle-icon',
  html: `<div style="transform: rotate(${heading}deg); width: 20px; height: 20px; background: ${status === 'online' ? '#22c55e' : '#ef4444'}; border-radius: 50%; border: 2px solid white;"></div>`,
  iconSize: [20, 20]
});

const LiveMap: React.FC = () => {
  const dispatch = useDispatch();
  const vehicles = useSelector(selectVehicles);
  const [selectedVehicle, setSelectedVehicle] = useState<string | null>(null);

  useEffect(() => {
    dispatch(fetchVehicles());
    wsConnect('wss://api.fleet.local/ws');
    return () => wsDisconnect();
  }, [dispatch]);

  return (
    <div className="h-screen flex flex-col">
      <div className="bg-white shadow p-4 flex justify-between items-center">
        <h1 className="text-2xl font-bold">Live Tracking</h1>
        <div className="flex gap-4">
          <span className="text-green-600">● {vehicles.filter(v => v.status === 'online').length} Online</span>
          <span className="text-red-600">● {vehicles.filter(v => v.status === 'offline').length} Offline</span>
        </div>
      </div>
      
      <MapContainer center={[20.5937, 78.9629]} zoom={5} className="flex-1">
        <TileLayer
          attribution='&copy; OpenStreetMap'
          url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
        />
        {vehicles.map(v => v.current_location && (
          <Marker
            key={v.id}
            position={[v.current_location.lat, v.current_location.lng]}
            icon={vehicleIcon(v.current_location.heading || 0, v.status)}
            eventHandlers={{
              click: () => setSelectedVehicle(v.id)
            }}
          >
            <Popup>
              <div className="p-2">
                <h3 className="font-bold text-lg">{v.registration_number}</h3>
                <p className="text-gray-600">{v.make} {v.model}</p>
                <p>Speed: {v.current_location.speed?.toFixed(0) || 0} km/h</p>
                <p>Last seen: {new Date(v.last_location_at).toLocaleTimeString()}</p>
                {v.current_driver && <p>Driver: {v.current_driver.name}</p>}
              </div>
            </Popup>
          </Marker>
        ))}
      </MapContainer>
      
      {selectedVehicle && (
        <div className="absolute bottom-4 right-4 bg-white p-4 rounded-lg shadow-lg w-80">
          <VehicleDetail vehicleId={selectedVehicle} onClose={() => setSelectedVehicle(null)} />
        </div>
      )}
    </div>
  );
};

const VehicleDetail: React.FC<{ vehicleId: string; onClose: () => void }> = ({ vehicleId, onClose }) => {
  const vehicle = useSelector(state => selectVehicles(state).find(v => v.id === vehicleId));
  
  return (
    <div>
      <div className="flex justify-between items-center mb-4">
        <h2 className="text-xl font-bold">{vehicle?.registration_number}</h2>
        <button onClick={onClose} className="text-gray-500 hover:text-gray-700">×</button>
      </div>
      <div className="space-y-2">
        <button className="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700">
          View History
        </button>
        <button className="w-full bg-yellow-600 text-white py-2 rounded hover:bg-yellow-700">
          Send Alert
        </button>
        <button className="w-full bg-red-600 text-white py-2 rounded hover:bg-red-700">
          Immobilize
        </button>
      </div>
    </div>
  );
};

export default LiveMap;
```

**`web-admin/src/store/vehiclesSlice.ts`**
```typescript
import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';
import axios from 'axios';

const API_URL = process.env.REACT_APP_API_URL || 'https://api.fleet.local/api/v1';

export const fetchVehicles = createAsyncThunk('vehicles/fetch', async () => {
  const token = localStorage.getItem('token');
  const response = await axios.get(`${API_URL}/vehicles`, {
    headers: { Authorization: `Bearer ${token}` }
  });
  return response.data;
});

const vehiclesSlice = createSlice({
  name: 'vehicles',
  initialState: { items: [], loading: false, error: null },
  reducers: {
    updateVehicleLocation: (state, action) => {
      const { vehicle_id, location } = action.payload;
      const vehicle = state.items.find(v => v.id === vehicle_id);
      if (vehicle) {
        vehicle.current_location = location;
        vehicle.last_location_at = new Date().toISOString();
      }
    }
  },
  extraReducers: (builder) => {
    builder
      .addCase(fetchVehicles.pending, (state) => { state.loading = true; })
      .addCase(fetchVehicles.fulfilled, (state, action) => {
        state.loading = false;
        state.items = action.payload.vehicles;
      });
  }
});

export const { updateVehicleLocation } = vehiclesSlice.actions;
export const selectVehicles = (state: any) => state.vehicles.items;
export default vehiclesSlice.reducer;
```

