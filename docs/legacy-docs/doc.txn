## 3. ANDROID PRODUCTION APP

### 3.1 Complete Offline-First Architecture

**File: `android/driver-app/app/src/main/java/com/fleet/driver/data/local/Database.kt`**
```kotlin
package com.fleet.driver.data.local

import android.content.Context
import androidx.room.*
import androidx.room.migration.Migration
import androidx.sqlite.db.SupportSQLiteDatabase
import com.fleet.driver.data.model.*
import kotlinx.coroutines.flow.Flow

@Database(
    entities = [
        PendingLocation::class,
        PendingEvent::class,
        PendingPOD::class,
        TripEntity::class,
        AlertEntity::class
    ],
    version = 3,
    exportSchema = true
)
@TypeConverters(Converters::class)
abstract class FleetDatabase : RoomDatabase() {
    abstract fun pendingSyncDao(): PendingSyncDao
    abstract fun tripDao(): TripDao
    abstract fun alertDao(): AlertDao

    companion object {
        @Volatile
        private var INSTANCE: FleetDatabase? = null

        fun getInstance(context: Context): FleetDatabase {
            return INSTANCE ?: synchronized(this) {
                INSTANCE ?: Room.databaseBuilder(
                    context.applicationContext,
                    FleetDatabase::class.java,
                    "fleet_database"
                )
                .addMigrations(MIGRATION_1_2, MIGRATION_2_3)
                .enableMultiInstanceInvalidation()
                .build()
                .also { INSTANCE = it }
            }
        }

        private val MIGRATION_1_2 = object : Migration(1, 2) {
            override fun migrate(db: SupportSQLiteDatabase) {
                db.execSQL("ALTER TABLE pending_locations ADD COLUMN accuracy REAL")
            }
        }

        private val MIGRATION_2_3 = object : Migration(2, 3) {
            override fun migrate(db: SupportSQLiteDatabase) {
                db.execSQL("CREATE TABLE IF NOT EXISTS alerts (id TEXT PRIMARY KEY, type TEXT, message TEXT, timestamp INTEGER, isRead INTEGER)")
            }
        }
    }
}

@Entity(tableName = "pending_locations")
data class PendingLocation(
    @PrimaryKey val id: String = UUID.randomUUID().toString(),
    val vehicleId: String,
    val latitude: Double,
    val longitude: Double,
    val speed: Float,
    val accuracy: Float,
    val timestamp: Long,
    val retryCount: Int = 0,
    val createdAt: Long = System.currentTimeMillis()
)

@Dao
interface PendingSyncDao {
    @Query("SELECT * FROM pending_locations WHERE retryCount < 10 ORDER BY timestamp ASC LIMIT 100")
    suspend fun getPendingLocations(): List<PendingLocation>

    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun insertLocation(location: PendingLocation)

    @Delete
    suspend fun deleteLocation(location: PendingLocation)

    @Query("UPDATE pending_locations SET retryCount = retryCount + 1 WHERE id = :id")
    suspend fun incrementRetry(id: String)

    @Query("DELETE FROM pending_locations WHERE createdAt < :cutoff")
    suspend fun deleteOld(cutoff: Long)

    @Query("SELECT COUNT(*) FROM pending_locations")
    fun getPendingCount(): Flow<Int>
}
```

### 3.2 Encrypted SharedPreferences & API Security

**File: `android/driver-app/app/src/main/java/com/fleet/driver/security/SecureStorage.kt`**
```kotlin
package com.fleet.driver.security

import android.content.Context
import android.content.SharedPreferences
import androidx.security.crypto.EncryptedSharedPreferences
import androidx.security.crypto.MasterKey

class SecureStorage(context: Context) {
    private val masterKey = MasterKey.Builder(context)
        .setKeyScheme(MasterKey.KeyScheme.AES256_GCM)
        .build()

    private val prefs: SharedPreferences = EncryptedSharedPreferences.create(
        context,
        "fleet_secure_prefs",
        masterKey,
        EncryptedSharedPreferences.PrefKeyEncryptionScheme.AES256_SIV,
        EncryptedSharedPreferences.PrefValueEncryptionScheme.AES256_GCM
    )

    companion object {
        private const val KEY_API_TOKEN = "api_token"
        private const val KEY_REFRESH_TOKEN = "refresh_token"
        private const val KEY_VEHICLE_ID = "vehicle_id"
        private const val KEY_DRIVER_ID = "driver_id"
        private const val KEY_SERVER_URL = "server_url"
    }

    fun saveAuthToken(token: String) {
        prefs.edit().putString(KEY_API_TOKEN, token).apply()
    }

    fun getAuthToken(): String? = prefs.getString(KEY_API_TOKEN, null)

    fun saveRefreshToken(token: String) {
        prefs.edit().putString(KEY_REFRESH_TOKEN, token).apply()
    }

    fun clearAuth() {
        prefs.edit()
            .remove(KEY_API_TOKEN)
            .remove(KEY_REFRESH_TOKEN)
            .apply()
    }

    fun saveVehicleId(vehicleId: String) {
        prefs.edit().putString(KEY_VEHICLE_ID, vehicleId).apply()
    }

    fun getVehicleId(): String? = prefs.getString(KEY_VEHICLE_ID, null)

    fun saveServerUrl(url: String) {
        prefs.edit().putString(KEY_SERVER_URL, url).apply()
    }

    fun getServerUrl(): String = prefs.getString(KEY_SERVER_URL, "https://api.fleet.example.com")!!
}
```

