### 4.7 Video & Safety APIs

```yaml
POST /api/v1/videos/upload
  # Multipart upload from dashcam/Android
  Auth: Device API Key
  
  Request:
    vehicle_id: UUID
    timestamp: ISO8601
    type: enum [continuous, event_triggered, manual]
    event_type?: enum [harsh_brake, collision, lane_departure, pedestrian, overspeed]
    file: binary (mp4, h264)
    metadata: {
      lat: decimal
      lng: decimal
      speed: decimal
      g_force: {x, y, z}
    }
  
  Response 202:
    upload_id: UUID
    status: "uploading"
  
  # Callback when processed
  Webhook: /api/v1/webhooks/video-processed
  
GET /api/v1/vehicles/{id}/videos
  Query:
    from: ISO8601
    to: ISO8601
    type: string[]
    has_event: boolean
  
  Response 200:
    videos: [
      {
        id: UUID
        timestamp: ISO8601
        duration_seconds: integer
        thumbnail_url: string
        playback_url: string  # HLS streaming
        event_type: string
        location: {...}
        ai_analysis: {
          objects_detected: [...]
          risk_score: integer
          driver_distraction: boolean
        }
      }
    ]

GET /api/v1/vehicles/{id}/live-video
  Auth: fleet_manager, admin
  
  Query:
    camera: enum [front, cabin, rear, all]
  
  Response 200:
    stream_url: string  # WebRTC or HLS
    expires_at: ISO8601

POST /api/v1/safety/events
  # From AI dashcam
  Request:
    vehicle_id: UUID
    timestamp: ISO8601
    type: enum [
      driver_distraction, phone_usage, smoking, 
      fatigue_detected, seatbelt_violation, 
      overspeed, harsh_driving, collision_imminent
    ]
    severity: enum [low, medium, high, critical]
    video_segment: {
      start_offset_ms: integer
      end_offset_ms: integer
    }
    location: {...}
  
  Response 201
