### 5.2 Driver App Architecture (Kotlin)

```kotlin
// Core Services Structure
class FleetTrackingService : Service() {
    // Foreground service with persistent notification
    // Handles GPS, OBD, and video streaming
    // Auto-restart on boot
    
    override fun onCreate() {
        startForeground(
            NOTIFICATION_ID,
            createPersistentNotification()
        )
        initializeLocationTracking()
        initializeOBDConnection()
        initializeVideoRecorder()
    }
    
    private fun initializeLocationTracking() {
        val locationRequest = LocationRequest.Builder(
            Priority.PRIORITY_HIGH_ACCURACY,
            5000L  // 5 seconds
        ).build()
        
        fusedLocationClient.requestLocationUpdates(
            locationRequest,
            locationCallback,
            Looper.getMainLooper()
        )
    }
    
    // Battery optimization: batch uploads when network poor
    // Store locally in Room DB, sync when connected
}

// Offline-First Architecture
@Entity(tableName = "pending_sync")
data class PendingSync(
    @PrimaryKey val id: UUID = UUID.randomUUID(),
    val type: SyncType,  // GPS, EVENT, POD, VIDEO
    val payload: String,   // JSON
    val createdAt: Long = System.currentTimeMillis(),
    val retryCount: Int = 0,
    val priority: Int  // SOS = 0, GPS = 5, Video = 10
)

// WorkManager for background sync
class SyncWorker(context: Context, params: WorkerParameters) : 
    CoroutineWorker(context, params) {
    
    override suspend fun doWork(): Result {
        val pending = db.pendingSyncDao().getPending()
        
        pending.forEach { item ->
            try {
                when (item.type) {
                    SyncType.GPS -> api.postTelemetry(item.payload)
                    SyncType.EVENT -> api.postEvent(item.payload)
                    SyncType.VIDEO -> uploadVideo(item.payload)
                }
                db.pendingSyncDao().delete(item)
            } catch (e: Exception) {
                db.pendingSyncDao().incrementRetry(item.id)
            }
        }
        return Result.success()
    }
}
```

