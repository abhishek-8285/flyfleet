## H. COMPLETE ANDROID APP

### H.1 Enrollment Flow - FULL IMPLEMENTATION

**`android-driver/app/src/main/java/com/fleet/driver/ui/enrollment/EnrollmentScreen.kt`**
```kotlin
package com.fleet.driver.ui.enrollment

import android.Manifest
import android.content.pm.PackageManager
import android.telephony.TelephonyManager
import android.widget.Toast
import androidx.activity.compose.rememberLauncherForActivityResult
import androidx.activity.result.contract.ActivityResultContracts
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.text.KeyboardOptions
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.QrCodeScanner
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.text.input.KeyboardType
import androidx.compose.ui.unit.dp
import androidx.core.content.ContextCompat
import com.fleet.driver.data.remote.EnrollmentService
import com.fleet.driver.util.SecurePrefs
import com.journeyapps.barcodescanner.ScanContract
import com.journeyapps.barcodescanner.ScanOptions
import kotlinx.coroutines.launch

@Composable
fun EnrollmentScreen(onEnrolled: () -> Unit) {
    val context = LocalContext.current
    val scope = rememberCoroutineScope()
    
    var step by remember { mutableStateOf(1) }
    var imei by remember { mutableStateOf("") }
    var enrollmentToken by remember { mutableStateOf("") }
    var vehicleId by remember { mutableStateOf("") }
    var isLoading by remember { mutableStateOf(false) }
    var error by remember { mutableStateOf<String?>(null) }

    // Get IMEI
    LaunchedEffect(Unit) {
        val telephonyManager = context.getSystemService(Context.TELEPHONY_SERVICE) as TelephonyManager
        imei = try {
            telephonyManager.deviceId ?: "unknown"
        } catch (e: SecurityException) {
            "permission_required"
        }
    }

    // QR Scanner
    val scanLauncher = rememberLauncherForActivityResult(ScanContract()) { result ->
        result.contents?.let {
            enrollmentToken = it
            step = 3
        }
    }

    Scaffold(
        topBar = {
            TopAppBar(title = { Text("Device Enrollment") })
        }
    ) { padding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(padding)
                .padding(16.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.Center
        ) {
            when (step) {
                1 -> IMEIStep(
                    imei = imei,
                    onNext = { step = 2 }
                )
                2 -> ScanStep(
                    onScan = { scanLauncher.launch(ScanOptions()) },
                    onManual = { step = 3 }
                )
                3 -> TokenStep(
                    token = enrollmentToken,
                    onTokenChange = { enrollmentToken = it },
                    vehicleId = vehicleId,
                    onVehicleIdChange = { vehicleId = it },
                    isLoading = isLoading,
                    error = error,
                    onSubmit = {
                        scope.launch {
                            isLoading = true
                            error = null
                            
                            try {
                                val response = EnrollmentService.enroll(
                                    imei = imei,
                                    token = enrollmentToken,
                                    vehicleId = vehicleId
                                )
                                
                                // Save credentials securely
                                SecurePrefs.saveCredentials(
                                    context,
                                    apiKey = response.apiKey,
                                    deviceId = response.deviceId,
                                    vehicleId = response.vehicleId,
                                    serverUrl = response.serverUrl
                                )
                                
                                onEnrolled()
                            } catch (e: Exception) {
                                error = e.message
                            } finally {
                                isLoading = false
                            }
                        }
                    }
                )
            }
        }
    }
}

@Composable
fun IMEIStep(imei: String, onNext: () -> Unit) {
    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text(
            "Device IMEI",
            style = MaterialTheme.typography.headlineMedium
        )
        Spacer(modifier = Modifier.height(16.dp))
        Text(
            imei,
            style = MaterialTheme.typography.bodyLarge,
            color = MaterialTheme.colorScheme.primary
        )
        Spacer(modifier = Modifier.height(32.dp))
        Button(onClick = onNext) {
            Text("Continue")
        }
    }
}

@Composable
fun ScanStep(onScan: () -> Unit, onManual: () -> Unit) {
    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text(
            "Scan Enrollment QR",
            style = MaterialTheme.typography.headlineMedium
        )
        Spacer(modifier = Modifier.height(32.dp))
        Button(
            onClick = onScan,
            modifier = Modifier.size(120.dp)
        ) {
            Icon(
                Icons.Default.QrCodeScanner,
                contentDescription = "Scan",
                modifier = Modifier.size(48.dp)
            )
        )
        Spacer(modifier = Modifier.height(16.dp))
        TextButton(onClick = onManual) {
            Text("Enter code manually")
        }
    }
}

@Composable
fun TokenStep(
    token: String,
    onTokenChange: (String) -> Unit,
    vehicleId: String,
    onVehicleIdChange: (String) -> Unit,
    isLoading: Boolean,
    error: String?,
    onSubmit: () -> Unit
) {
    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        OutlinedTextField(
            value = token,
            onValueChange = onTokenChange,
            label = { Text("Enrollment Token") },
            modifier = Modifier.fillMaxWidth()
        )
        Spacer(modifier = Modifier.height(16.dp))
        OutlinedTextField(
            value = vehicleId,
            onValueChange = onVehicleIdChange,
            label = { Text("Vehicle ID (optional)") },
            modifier = Modifier.fillMaxWidth()
        )
        error?.let {
            Spacer(modifier = Modifier.height(8.dp))
            Text(it, color = MaterialTheme.colorScheme.error)
        }
        Spacer(modifier = Modifier.height(32.dp))
        Button(
            onClick = onSubmit,
            enabled = token.isNotBlank() && !isLoading,
            modifier = Modifier.fillMaxWidth()
        ) {
            if (isLoading) {
                CircularProgressIndicator(modifier = Modifier.size(24.dp))
            } else {
                Text("Complete Enrollment")
            }
        }
    }
}
```

### H.2 API Service Layer

**`android-driver/app/src/main/java/com/fleet/driver/data/remote/ApiService.kt`**
```kotlin
package com.fleet.driver.data.remote

import com.fleet.driver.BuildConfig
import com.fleet.driver.data.model.*
import com.fleet.driver.util.SecurePrefs
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import okhttp3.*
import okhttp3.logging.HttpLoggingInterceptor
import retrofit2.Retrofit
import retrofit2.converter.gson.GsonConverterFactory
import retrofit2.http.*
import java.util.concurrent.TimeUnit

interface ApiService {
    @POST("device/telemetry/gps")
    suspend fun postTelemetry(@Body payload: GPSPayload): Response<Unit>

    @POST("device/telemetry/obd")
    suspend fun postOBD(@Body payload: OBDPAyload): Response<Unit>

    @POST("device/events")
    suspend fun postEvent(@Body payload: EventPayload): Response<Unit>

    @GET("device/config")
    suspend fun getConfig(): Response<DeviceConfig>

    @POST("driver/trips/{id}/start")
    suspend fun startTrip(@Path("id") tripId: String): Response<Trip>

    @POST("driver/trips/{id}/complete")
    suspend fun completeTrip(@Path("id") tripId: String, @Body payload: TripCompletePayload): Response<Trip>

    @GET("driver/trips/active")
    suspend fun getActiveTrip(): Response<Trip?>

    @POST("driver/sos")
    suspend fun triggerSOS(@Body payload: SOSRequest): Response<Unit>
}

object EnrollmentService {
    private val client = OkHttpClient.Builder()
        .addInterceptor(HttpLoggingInterceptor().apply { level = HttpLoggingInterceptor.Level.BODY })
        .build()

    suspend fun enroll(imei: String, token: String, vehicleId: String?): EnrollmentResponse {
        return withContext(Dispatchers.IO) {
            val request = Request.Builder()
                .url("${BuildConfig.API_BASE_URL}/devices/enroll")
                .post(
                    FormBody.Builder()
                        .add("imei", imei)
                        .add("enrollment_token", token)
                        .add("vehicle_id", vehicleId ?: "")
                        .build()
                )
                .build()

            client.newCall(request).execute().use { response ->
                if (!response.isSuccessful) {
                    throw Exception("Enrollment failed: ${response.code}")
                }

                val body = response.body?.string() ?: throw Exception("Empty response")
                Gson().fromJson(body, EnrollmentResponse::class.java)
            }
        }
    }
}

class AuthInterceptor(private val context: android.content.Context) : Interceptor {
    override fun intercept(chain: Interceptor.Chain): Response {
        val request = chain.request()
        val apiKey = SecurePrefs.getApiKey(context) ?: return chain.proceed(request)

        val newRequest = request.newBuilder()
            .header("X-API-Key", apiKey)
            .header("X-Device-ID", SecurePrefs.getDeviceId(context) ?: "unknown")
            .build()

        return chain.proceed(newRequest)
    }
}

object RetrofitClient {
    fun create(context: android.content.Context): ApiService {
        val client = OkHttpClient.Builder()
            .addInterceptor(AuthInterceptor(context))
            .addInterceptor(HttpLoggingInterceptor().apply {
                level = if (BuildConfig.DEBUG) HttpLoggingInterceptor.Level.BODY else HttpLoggingInterceptor.Level.BASIC
            })
            .certificatePinner(
                CertificatePinner.Builder()
                    .add(BuildConfig.API_HOST, BuildConfig.CERT_PIN)
                    .build()
            )
            .connectTimeout(30, TimeUnit.SECONDS)
            .readTimeout(30, TimeUnit.SECONDS)
            .build()

        return Retrofit.Builder()
            .baseUrl(SecurePrefs.getServerUrl(context) ?: BuildConfig.API_BASE_URL)
            .client(client)
            .addConverterFactory(GsonConverterFactory.create())
            .build()
            .create(ApiService::class.java)
    }
}

data class EnrollmentResponse(
    val deviceId: String,
    val apiKey: String,
    val vehicleId: String,
    val serverUrl: String
)
```

### H.3 Room Database

**`android-driver/app/src/main/java/com/fleet/driver/data/local/Database.kt`**
```kotlin
package com.fleet.driver.data.local

import android.content.Context
import androidx.room.*
import androidx.room.migration.Migration
import androidx.sqlite.db.SupportSQLiteDatabase
import kotlinx.coroutines.flow.Flow

@Database(
    entities = [
        PendingLocation::class,
        PendingEvent::class,
        PendingPOD::class,
        TripCache::class,
        AlertCache::class
    ],
    version = 3,
    exportSchema = true
)
@TypeConverters(Converters::class)
abstract class FleetDatabase : RoomDatabase() {
    abstract fun pendingSyncDao(): PendingSyncDao
    abstract fun tripDao(): TripDao
    abstract fun alertDao(): AlertDao

    companion object {
        @Volatile
        private var INSTANCE: FleetDatabase? = null

        fun getDatabase(context: Context): FleetDatabase {
            return INSTANCE ?: synchronized(this) {
                val instance = Room.databaseBuilder(
                    context.applicationContext,
                    FleetDatabase::class.java,
                    "fleet_database"
                )
                .addMigrations(MIGRATION_1_2, MIGRATION_2_3)
                .build()
                INSTANCE = instance
                instance
            }
        }

        private val MIGRATION_1_2 = object : Migration(1, 2) {
            override fun migrate(db: SupportSQLiteDatabase) {
                db.execSQL("ALTER TABLE pending_locations ADD COLUMN altitude REAL")
            }
        }

        private val MIGRATION_2_3 = object : Migration(2, 3) {
            override fun migrate(db: SupportSQLiteDatabase) {
                db.execSQL("CREATE TABLE IF NOT EXISTS alerts (id TEXT PRIMARY KEY, type TEXT, message TEXT, severity TEXT, timestamp INTEGER, isRead INTEGER DEFAULT 0)")
            }
        }
    }
}

@Entity(tableName = "pending_locations")
data class PendingLocation(
    @PrimaryKey val id: String = java.util.UUID.randomUUID().toString(),
    val vehicleId: String,
    val latitude: Double,
    val longitude: Double,
    val altitude: Double?,
    val speed: Float,
    val accuracy: Float,
    val bearing: Float?,
    val timestamp: Long,
    val ignition: Boolean?,
    val batteryLevel: Int?,
    val retryCount: Int = 0,
    val createdAt: Long = System.currentTimeMillis()
) {
    fun toPayload(): GPSPayload = GPSPayload(
        vehicleId = vehicleId,
        latitude = latitude,
        longitude = longitude,
        altitude = altitude,
        speed = speed,
        heading = bearing,
        accuracy = accuracy,
        timestamp = timestamp / 1000,
        ignition = ignition,
        batteryLevel = batteryLevel
    )
}

@Dao
interface PendingSyncDao {
    @Query("SELECT * FROM pending_locations WHERE retryCount < 10 ORDER BY timestamp ASC LIMIT 100")
    suspend fun getPendingLocations(): List<PendingLocation>

    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun insert(location: PendingLocation)

    @Delete
    suspend fun delete(location: PendingLocation)

    @Query("UPDATE pending_locations SET retryCount = retryCount + 1 WHERE id = :id")
    suspend fun incrementRetry(id: String)

    @Query("DELETE FROM pending_locations WHERE createdAt < :cutoff")
    suspend fun deleteOld(cutoff: Long)

    @Query("SELECT COUNT(*) FROM pending_locations")
    fun getPendingCount(): Flow<Int>
}
```

