## E. DEPLOYMENT

### E.1 Docker Compose (Single Command Start)

**`docker-compose.yml`**
```yaml
version: '3.8'

services:
  postgres:
    image: timescale/timescaledb:latest-pg16
    environment:
      POSTGRES_DB: fleetdb
      POSTGRES_USER: fleet
      POSTGRES_PASSWORD: fleet123
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./backend/migrations:/docker-entrypoint-initdb.d
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U fleet -d fleetdb"]
      interval: 5s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    volumes:
      - redis_data:/data

  nats:
    image: nats:2.10-alpine
    command: "-js -m 8222 --mqtt_port 1883"
    ports:
      - "4222:4222"
      - "1883:1883"
      - "8222:8222"
    volumes:
      - nats_data:/data/jetstream

  api:
    build:
      context: ./backend
      dockerfile: Dockerfile
    environment:
      DATABASE_URL: postgres://fleet:fleet123@postgres:5432/fleetdb?sslmode=disable
      REDIS_URL: redis:6379
      NATS_URL: nats://nats:4222
      JWT_SECRET: your-jwt-secret-change-in-production
    ports:
      - "8080:8080"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_started
      nats:
        condition: service_started

  web:
    build:
      context: ./web-admin
      dockerfile: Dockerfile
    ports:
      - "3000:80"
    environment:
      REACT_APP_API_URL: http://localhost:8080/api/v1

volumes:
  postgres_data:
  redis_data:
  nats_data:
```

### E.2 Install Script

**`install.sh`**
```bash
#!/bin/bash
set -e

echo "=== Fleet Platform Installation ==="

# Check dependencies
command -v docker >/dev/null 2>&1 || { echo "Docker required"; exit 1; }
command -v docker-compose >/dev/null 2>&1 || { echo "Docker Compose required"; exit 1; }

# Clone or setup
if [ ! -d "fleet-platform" ]; then
    mkdir -p fleet-platform
    cd fleet-platform
fi

# Generate secrets
JWT_SECRET=$(openssl rand -base64 32)
echo "JWT_SECRET=$JWT_SECRET" > .env

# Start services
docker-compose up --build -d

# Wait for health
echo "Waiting for services..."
sleep 10

# Seed database
docker-compose exec -T postgres psql -U fleet -d fleetdb < backend/migrations/001_init.up.sql

echo ""
echo "=== Installation Complete ==="
echo "API: http://localhost:8080"
echo "Web: http://localhost:3000"
echo "Login: admin@fleet.local / admin123"
echo ""
echo "Next steps:"
echo "1. Install Android app on phones"
echo "2. Enroll devices at http://localhost:3000"
echo "3. Start tracking!"
```

