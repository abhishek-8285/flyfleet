      <Card title="Engine Diagnostics">
        <OBDGauge 
          label="RPM"
          value={vehicle.latest_obd?.rpm || 0}
          max={6000}
          warning={5000}
        />
        <OBDGauge 
          label="Coolant Temp"
          value={vehicle.latest_obd?.coolant_temp || 0}
          max={120}
          unit="°C"
          warning={100}
        />
        <OBDGauge 
          label="Engine Load"
          value={vehicle.latest_obd?.engine_load || 0}
          max={100}
          unit="%"
        />
        {vehicle.latest_obd?.dtcs?.length > 0 && (
          <Alert variant="error">
            Active DTCs: {vehicle.latest_obd.dtcs.join(', ')}
          </Alert>
        )}
      </Card>
      
      {/* Documents Card */}
      <Card title="Documents">
        <DocumentList 
          documents={vehicle.documents}
          onUpload={(type) => openUploadModal(type)}
          onView={(url) => window.open(url)}
        />
        {vehicle.expiring_documents?.length > 0 && (
          <Alert variant="warning">
            {vehicle.expiring_documents.length} documents expiring soon
          </Alert>
        )}
      </Card>
      
      {/* Quick Stats */}
      <Card title="This Month">
        <StatItem label="Distance" value={`${vehicle.stats?.monthly_distance || 0} km`} />
        <StatItem label="Fuel Cost" value={`₹${vehicle.stats?.monthly_fuel_cost || 0}`} />
        <StatItem label="Trips" value={vehicle.stats?.monthly_trips || 0} />
        <StatItem 
          label="Safety Score" 
          value={vehicle.stats?.safety_score || 100} 
          color={vehicle.stats?.safety_score > 80 ? 'green' : 'red'}
        />
      </Card>
    </div>
  );
};
```

#### Screen: Dispatch Console

```typescript
// DispatchConsole.tsx - Logistics management
const DispatchConsole: React.FC = () => {
  const [unassignedTasks, setUnassignedTasks] = useState<Task[]>([]);
  const [availableDrivers, setAvailableDrivers] = useState<Driver[]>([]);
  const [availableVehicles, setAvailableVehicles] = useState<Vehicle[]>([]);
  const [selectedTask, setSelectedTask] = useState<Task | null>(null);
  const [optimizationParams, setOptimizationParams] = useState({
    minimizeFuel: true,
    avoidTolls: false,
    trafficAware: true
  });
  
  // Drag-and-drop assignment
  const handleAssign = async (taskId: string, driverId: string, vehicleId: string) => {
    const trip = await api.post('/api/v1/trips', {
      task_id: taskId,
      driver_id: driverId,
      vehicle_id: vehicleId,
      optimization_params: optimizationParams
    });
    
    // Optimized route returned
    visualizeRoute(trip.optimized_route);
    setUnassignedTasks(prev => prev.filter(t => t.id !== taskId));
  };
  
  return (
    <div className="dispatch-console">
      {/* Left Panel: Unassigned Tasks */}
      <Panel title="Pending Tasks" width="25%">
        <TaskList 
          tasks={unassignedTasks}
          onSelect={setSelectedTask}
          selectedId={selectedTask?.id}
          filters={{
            priority: ['high', 'urgent'],
            type: ['delivery', 'pickup']
          }}
        />
        <Button onClick={() => setCreateTaskOpen(true)}>
          Create Manual Task
        </Button>
      </Panel>
      
      {/* Center: Map & Route Optimization */}
      <Panel title="Route Planning" width="50%">
        <OptimizationToolbar 
          params={optimizationParams}
          onChange={setOptimizationParams}
          onOptimize={runOptimization}
        />
        
        <RouteMap 
          tasks={unassignedTasks}
          drivers={availableDrivers}
          optimizedRoutes={optimizedRoutes}
          onAssign={handleAssign}
        />
        
        {selectedTask && (
          <TaskDetailPanel task={selectedTask}>
            <Button onClick={() => optimizeForTask(selectedTask)}>
              Optimize Route
            </Button>
          </TaskDetailPanel>
        )}
      </Panel>
      
      {/* Right Panel: Resources */}
      <Panel title="Available Resources" width="25%">
        <DriverList 
          drivers={availableDrivers}
          onStatusChange={handleDriverStatusChange}
        />
        <VehicleList 
          vehicles={availableVehicles}
          filterByCapabilities={selectedTask?.requirements}
        />
      </Panel>
    </div>
  );
};
