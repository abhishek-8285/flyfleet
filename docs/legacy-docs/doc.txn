## 6. REAL-TIME DATA PIPELINE

### 6.1 NATS Configuration

**File: `deploy/nats/server.conf`**

```hcl
# NATS Server Configuration for Fleet Platform

# Network
port: 4222
http_port: 8222

# MQTT for device connectivity
mqtt {
  port: 1883
  tls {
    cert_file: "/etc/nats/tls/server.crt"
    key_file: "/etc/nats/tls/server.key"
  }
}

# JetStream for persistence
jetstream {
  store_dir: "/data/jetstream"
  max_memory_store: 2GB
  max_file_store: 50GB
  sync_interval: 2m
}

# Authentication
authorization {
  users = [
    {
      user: "fleet-api"
      password: $API_PASSWORD
      permissions: {
        publish: ["fleet.>", "telemetry.>"]
        subscribe: ["commands.>", "_INBOX.>"]
      }
    },
    {
      user: "device"
      password: $DEVICE_PASSWORD
      permissions: {
        publish: ["telemetry.>", "events.>"]
        subscribe: ["commands.>"]
      }
    }
  ]
}

# Clustering (for Phase 3)
cluster {
  name: "fleet-cluster"
  listen: "0.0.0.0:6222"
  routes: []
}

# Leaf nodes for edge gateways (future)
leafnodes {
  listen: "0.0.0.0:7422"
  authorization {
    user: "leaf"
    password: $LEAF_PASSWORD
  }
}

# Limits
max_connections: 10000
max_payload: 8MB
max_pending: 64MB

# Logging
debug: false
trace: false
log_file: "/var/log/nats/nats.log"
log_size_limit: 100MB
```

