## A. WORKING BACKEND (Go)

### A.1 Main API Server

**`backend/cmd/api/main.go`**
```go
package main

import (
	"context"
	"fmt"
	"log"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"fleet-platform/backend/internal/billing"
	"fleet-platform/backend/internal/common/db"
	"fleet-platform/backend/internal/common/middleware"
	"fleet-platform/backend/internal/common/nats"
	"fleet-platform/backend/internal/common/redis"
	"fleet-platform/backend/internal/device"
	"fleet-platform/backend/internal/driver"
	"fleet-platform/backend/internal/geofence"
	"fleet-platform/backend/internal/telemetry"
	"fleet-platform/backend/internal/trip"
	"fleet-platform/backend/internal/vehicle"

	"github.com/gin-gonic/gin"
	"github.com/jackc/pgx/v5/pgxpool"
	"go.uber.org/zap"
)

func main() {
	logger, _ := zap.NewProduction()
	defer logger.Sync()

	// Database
	dbPool, err := pgxpool.New(context.Background(), os.Getenv("DATABASE_URL"))
	if err != nil {
		log.Fatal("database connection failed:", err)
	}
	defer dbPool.Close()

	// Redis
	redisClient := redis.NewClient(os.Getenv("REDIS_URL"))
	defer redisClient.Close()

	// NATS
	nc, err := nats.Connect(os.Getenv("NATS_URL"))
	if err != nil {
		log.Fatal("nats connection failed:", err)
	}
	defer nc.Close()

	// Repositories
	vehicleRepo := vehicle.NewRepository(dbPool)
	driverRepo := driver.NewRepository(dbPool)
	deviceRepo := device.NewRepository(dbPool)
	tripRepo := trip.NewRepository(dbPool)
	geofenceRepo := geofence.NewRepository(dbPool)
	billingRepo := billing.NewRepository(dbPool)

	// Services
	vehicleSvc := vehicle.NewService(vehicleRepo, logger)
	driverSvc := driver.NewService(driverRepo, logger)
	deviceSvc := device.NewService(deviceRepo, nc, logger)
	telemetrySvc := telemetry.NewService(dbPool, nc, redisClient, logger)
	tripSvc := trip.NewService(tripRepo, vehicleRepo, logger)
	geofenceSvc := geofence.NewService(geofenceRepo, nc, logger)
	billingSvc := billing.NewService(billingRepo, logger)

	// Handlers
	vehicleHandler := vehicle.NewHandler(vehicleSvc, logger)
	driverHandler := driver.NewHandler(driverSvc, logger)
	deviceHandler := device.NewHandler(deviceSvc, logger)
	telemetryHandler := telemetry.NewHandler(telemetrySvc, logger)
	tripHandler := trip.NewHandler(tripSvc, logger)
	geofenceHandler := geofence.NewHandler(geofenceSvc, logger)
	billingHandler := billing.NewHandler(billingSvc, logger)
	authHandler := NewAuthHandler(dbPool, redisClient, logger)

	// Router
	r := gin.New()
	r.Use(gin.Recovery())
	r.Use(middleware.Logger(logger))
	r.Use(middleware.CORS())
	r.Use(middleware.RateLimiter(redisClient))

	// Public routes
	r.POST("/api/v1/auth/login", authHandler.Login)
	r.POST("/api/v1/auth/refresh", authHandler.Refresh)
	r.POST("/api/v1/devices/enroll", deviceHandler.Enroll)

	// Device telemetry (API key auth)
	device := r.Group("/device")
	device.Use(middleware.DeviceAuth(deviceRepo))
	{
		device.POST("/telemetry/gps", telemetryHandler.ReceiveGPS)
		device.POST("/telemetry/obd", telemetryHandler.ReceiveOBD)
		device.POST("/events", telemetryHandler.ReceiveEvent)
		device.GET("/config", deviceHandler.GetConfig)
	}

	// Protected routes
	api := r.Group("/api/v1")
	api.Use(middleware.JWTAuth())
	{
		// Vehicles
		vehicles := api.Group("/vehicles")
		vehicles.GET("", middleware.RequirePermission("vehicles:read"), vehicleHandler.List)
		vehicles.POST("", middleware.RequirePermission("vehicles:write"), vehicleHandler.Create)
		vehicles.GET("/:id", middleware.RequirePermission("vehicles:read"), vehicleHandler.Get)
		vehicles.PUT("/:id", middleware.RequirePermission("vehicles:write"), vehicleHandler.Update)
		vehicles.DELETE("/:id", middleware.RequirePermission("vehicles:delete"), vehicleHandler.Delete)
		vehicles.GET("/:id/locations", middleware.RequirePermission("vehicles:read"), vehicleHandler.GetLocations)
		vehicles.POST("/:id/immobilize", middleware.RequirePermission("vehicles:control"), vehicleHandler.Immobilize)
		vehicles.POST("/:id/devices", middleware.RequirePermission("vehicles:write"), deviceHandler.AssignToVehicle)

		// Drivers
		drivers := api.Group("/drivers")
		drivers.GET("", middleware.RequirePermission("drivers:read"), driverHandler.List)
		drivers.POST("", middleware.RequirePermission("drivers:write"), driverHandler.Create)
		drivers.GET("/:id", middleware.RequirePermission("drivers:read"), driverHandler.Get)
		drivers.PUT("/:id", middleware.RequirePermission("drivers:write"), driverHandler.Update)
		drivers.DELETE("/:id", middleware.RequirePermission("drivers:delete"), driverHandler.Delete)

		// Trips
		trips := api.Group("/trips")
		trips.GET("", middleware.RequirePermission("trips:read"), tripHandler.List)
		trips.POST("", middleware.RequirePermission("trips:write"), tripHandler.Create)
		trips.GET("/:id", middleware.RequirePermission("trips:read"), tripHandler.Get)
		trips.POST("/:id/start", middleware.RequirePermission("trips:write"), tripHandler.Start)
		trips.POST("/:id/complete", middleware.RequirePermission("trips:write"), tripHandler.Complete)

		// Geofences
		geofences := api.Group("/geofences")
		geofences.GET("", middleware.RequirePermission("geofences:read"), geofenceHandler.List)
		geofences.POST("", middleware.RequirePermission("geofences:write"), geofenceHandler.Create)
		geofences.DELETE("/:id", middleware.RequirePermission("geofences:delete"), geofenceHandler.Delete)

		// Billing
		billing := api.Group("/billing")
		billing.GET("/subscription", middleware.RequirePermission("billing:read"), billingHandler.GetSubscription)
		billing.GET("/invoices", middleware.RequirePermission("billing:read"), billingHandler.ListInvoices)
		billing.GET("/usage", middleware.RequirePermission("billing:read"), billingHandler.GetUsage)

		// Reports
		api.GET("/reports/trips", middleware.RequirePermission("reports:read"), tripHandler.Report)
		api.GET("/reports/fuel", middleware.RequirePermission("reports:read"), vehicleHandler.FuelReport)
	}

	// Health
	r.GET("/health", func(c *gin.Context) {
		c.JSON(200, gin.H{
			"status":    "healthy",
			"version":   "1.0.0",
			"timestamp": time.Now().Unix(),
		})
	})

	srv := &http.Server{
		Addr:    ":8080",
		Handler: r,
	}

	// Graceful shutdown
	go func() {
		if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			log.Fatal("server failed:", err)
		}
	}()

	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
	<-quit

	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	if err := srv.Shutdown(ctx); err != nil {
		log.Fatal("server shutdown failed:", err)
	}
}
```

