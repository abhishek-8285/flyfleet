// DriverHomeScreen.kt
@Composable
fun DriverHomeScreen(
    viewModel: DriverViewModel = hiltViewModel()
) {
    val uiState by viewModel.uiState.collectAsState()
    val context = LocalContext.current
    
    // Check for active trip
