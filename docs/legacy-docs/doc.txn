#### Screen: Trip Execution

```kotlin
// TripExecutionScreen.kt
@Composable
fun TripExecutionScreen(
    tripId: String,
    viewModel: TripViewModel = hiltViewModel()
) {
    val context = LocalContext.current
    val lifecycleOwner = LocalLifecycleOwner.current
    
    // Initialize location tracking
    val locationPermissions = rememberMultiplePermissionsState(
        permissions = listOf(
            Manifest.permission.ACCESS_FINE_LOCATION,
            Manifest.permission.ACCESS_COARSE_LOCATION,
            Manifest.permission.ACCESS_BACKGROUND_LOCATION,
            Manifest.permission.FOREGROUND_SERVICE_LOCATION
        )
    )
    
    LaunchedEffect(Unit) {
        locationPermissions.launchMultiplePermissionRequest()
    }
    
    // Start foreground service for tracking
    LaunchedEffect(tripId) {
        val serviceIntent = Intent(context, TripTrackingService::class.java).apply {
            putExtra("trip_id", tripId)
            putExtra("action", "START_TRIP")
        }
        ContextCompat.startForegroundService(context, serviceIntent)
    }
    
    val tripState by viewModel.tripState.collectAsState()
    val currentLocation by viewModel.currentLocation.collectAsState()
    
    Scaffold(
        floatingActionButton = {
            SpeedDialFab(
                items = listOf(
                    SpeedDialItem("Complete", Icons.Default.Check, Color.Green) {
                        viewModel.completeTrip()
                    },
                    SpeedDialItem("Issue", Icons.Default.Report, Color.Red) {
                        showIssueDialog = true
                    },
                    SpeedDialItem("POD", Icons.Default.Camera, Color.Blue) {
                        navController.navigate("pod/${tripId}")
                    }
                )
            )
        }
    ) { padding ->
        Column(modifier = Modifier.padding(padding)) {
            // Live Route Map (offline-capable)
            OfflineMapView(
                route = tripState.route,
                currentLocation = currentLocation,
                waypoints = tripState.waypoints,
                completedWaypoints = tripState.completedWaypoints
            )
            
            // Waypoint Progress
            WaypointProgress(
                waypoints = tripState.waypoints,
                currentIndex = tripState.currentWaypointIndex,
                onWaypointClick = { index ->
                    if (index == tripState.currentWaypointIndex) {
                        showWaypointActions = true
                    }
                }
            )
            
            // ETA & Distance
            TripStatsRow(
                distanceRemaining = tripState.distanceRemaining,
                eta = tripState.eta,
                trafficDelay = tripState.trafficDelayMinutes
            )
        }
    }
    
    // Waypoint Action Dialog
    if (showWaypointActions) {
        val currentWp = tripState.waypoints[tripState.currentWaypointIndex]
        AlertDialog(
            onDismissRequest = { showWaypointActions = false },
            title = { Text("At: ${currentWp.name}") },
            text = {
                Column {
                    Button(onClick = {
                        viewModel.recordArrival(currentWp.id)
                        showWaypointActions = false
                    }) {
                        Text("Record Arrival")
                    }
                    Button(onClick = {
                        viewModel.recordDeparture(currentWp.id)
                        showWaypointActions = false
                    }) {
                        Text("Record Departure")
                    }
                    Button(onClick = {
                        navController.navigate("pod/${tripId}/${currentWp.id}")
                        showWaypointActions = false
                    }) {
                        Text("Capture POD")
                    }
                }
            },
            confirmButton = {},
            dismissButton = {
                TextButton(onClick = { showWaypointActions = false }) {
                    Text("Cancel")
                }
            }
        )
    }
}
