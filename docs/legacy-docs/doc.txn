---

This package provides **runnable code, working configurations, and operational procedures** rather than design theory. Each component can be deployed immediately with the provided scripts and credentials templates.


I'll address each of these gaps with production-hardened implementations. This is the correction from "works in a demo" to "ready for real fleet operations."

---

## 1. INFRASTRUCTURE HARDENING

### 1.1 Production Deployment with TLS & Multi-Node Ready

**File: `deploy-production.sh`**
```bash
#!/bin/bash
set -euo pipefail

# Production Deployment with TLS, Firewall, Backups
# Usage: ./deploy-production.sh <domain> <email>

DOMAIN=${1:?"Usage: $0 <domain> <email>"}
EMAIL=${2:?"Usage: $0 <domain> <email>"}

echo "=== Production Fleet Platform Deployment ==="
echo "Domain: $DOMAIN"
echo "Email: $EMAIL"

# 1. System Hardening
echo "[1/10] System hardening..."

# Firewall - strict rules
sudo ufw default deny incoming
sudo ufw default allow outgoing
sudo ufw allow 22/tcp    # SSH (change port in production)
sudo ufw allow 80/tcp    # HTTP (for certbot)
sudo ufw allow 443/tcp   # HTTPS
sudo ufw allow 1883/tcp  # MQTT (device telemetry)
sudo ufw allow 4222/tcp  # NATS (internal only - restrict to VPN in prod)
sudo ufw --force enable

# Fail2ban for intrusion protection
sudo apt-get update
sudo apt-get install -y fail2ban
sudo tee /etc/fail2ban/jail.local << 'EOF'
[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 3

[sshd]
enabled = true
port = 22
logpath = /var/log/auth.log

[nginx-http-auth]
enabled = true
EOF
sudo systemctl restart fail2ban

# 2. Secrets Management (HashiCorp Vault or file-based for Phase 2)
echo "[2/10] Setting up secrets management..."

SECRETS_DIR="/etc/fleet-platform/secrets"
sudo mkdir -p $SECRETS_DIR
sudo chmod 700 $SECRETS_DIR

# Generate strong secrets
generate_secret() {
    openssl rand -base64 48 | tr -d '\n' | cut -c1-${1:-32}
}

sudo tee $SECRETS_DIR/db-password << EOF
$(generate_secret 32)
EOF

sudo tee $SECRETS_DIR/jwt-secret << EOF
$(generate_secret 64)
EOF

sudo tee $SECRETS_DIR/nats-password << EOF
$(generate_secret 32)
EOF

sudo chmod 600 $SECRETS_DIR/*

# 3. Docker Swarm Setup (Multi-node ready)
echo "[3/10] Initializing Docker Swarm..."

docker swarm init 2>/dev/null || echo "Swarm already initialized"

# Create overlay networks
docker network create --driver overlay --attachable fleet-backend 2>/dev/null || true
docker network create --driver overlay fleet-internal 2>/dev/null || true

# 4. Stack Deployment with TLS
echo "[4/10] Deploying stack..."

mkdir -p /opt/fleet-platform/{data,backups,logs,certs}

# Docker Compose with TLS termination via Traefik
cat > /opt/fleet-platform/docker-stack.yml << 'EOF'
version: '3.8'

networks:
  backend:
    external: true
    name: fleet-backend
  internal:
    external: true
    name: fleet-internal

volumes:
  postgres_data:
  redis_data:
  nats_data:
  certs:
  traefik_certs:

services:
  traefik:
    image: traefik:v2.10
    command:
      - "--api.insecure=false"
      - "--providers.docker.swarmMode=true"
      - "--providers.docker.network=fleet-backend"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.web.http.redirections.entryPoint.to=websecure"
      - "--entrypoints.web.http.redirections.entryPoint.scheme=https"
      - "--certificatesresolvers.letsencrypt.acme.tlschallenge=true"
      - "--certificatesresolvers.letsencrypt.acme.email=${EMAIL}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json"
      - "--ping=true"
      - "--metrics.prometheus=true"
      - "--accesslog=true"
      - "--log.level=INFO"
    ports:
      - target: 80
        published: 80
        mode: host
      - target: 443
        published: 443
        mode: host
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - traefik_certs:/letsencrypt
    networks:
      - backend
      - internal
    deploy:
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: on-failure
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.api.rule=Host(`traefik.${DOMAIN}`)"
        - "traefik.http.routers.api.service=api@internal"
        - "traefik.http.routers.api.middlewares=auth@file"
        - "traefik.http.routers.api.tls.certresolver=letsencrypt"

  postgres:
    image: timescale/timescaledb:latest-pg16
    environment:
      POSTGRES_DB: fleetdb
      POSTGRES_USER: fleet
      POSTGRES_PASSWORD_FILE: /run/secrets/db_password
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - /opt/fleet-platform/backups:/backups
    secrets:
      - db_password
    networks:
      - internal
    deploy:
      placement:
        constraints:
          - node.labels.db == true
      restart_policy:
        condition: any
        delay: 5s
        max_attempts: 3
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U fleet -d fleetdb"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    command: redis-server --appendonly yes --requirepass $(cat /run/secrets/redis_password)
    volumes:
      - redis_data:/data
    secrets:
      - redis_password
    networks:
      - internal
    deploy:
      restart_policy:
        condition: on-failure

  nats:
    image: nats:2.10-alpine
    command: >
      --server_name nats-main
      --jetstream
      --store_dir /data/jetstream
      --max_memory_store 2GB
      --max_file_store 50GB
      --mqtt_port 1883
      --leafnodes --leafnode_listen=7422
    volumes:
      - nats_data:/data/jetstream
      - /opt/fleet-platform/certs:/certs
    networks:
      - backend
      - internal
    ports:
      - target: 4222
        published: 4222
        mode: host
      - target: 1883
        published: 1883
        mode: host
    deploy:
      restart_policy:
        condition: on-failure

  api:
    image: fleet-platform/api:latest
    build:
      context: .
      dockerfile: Dockerfile.api
    environment:
      - DB_HOST=postgres
      - DB_USER=fleet
      - DB_PASSWORD_FILE=/run/secrets/db_password
      - DB_NAME=fleetdb
      - NATS_URL=nats://nats:4222
      - REDIS_ADDR=redis:6379
      - JWT_SECRET_FILE=/run/secrets/jwt_secret
      - TLS_CERT=/certs/server.crt
      - TLS_KEY=/certs/server.key
      - GIN_MODE=release
      - LOG_LEVEL=info
    secrets:
      - db_password
      - jwt_secret
      - source: tls_cert
        target: /certs/server.crt
      - source: tls_key
        target: /certs/server.key
    networks:
      - backend
      - internal
    deploy:
      replicas: 2
      update_config:
        parallelism: 1
        delay: 10s
        failure_action: rollback
      restart_policy:
        condition: on-failure
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.api.rule=Host(`${DOMAIN}`)"
        - "traefik.http.routers.api.entrypoints=websecure"
        - "traefik.http.routers.api.tls.certresolver=letsencrypt"
        - "traefik.http.services.api.loadbalancer.server.port=8080"
        - "traefik.http.middlewares.api-ratelimit.ratelimit.average=100"
        - "traefik.http.middlewares.api-ratelimit.ratelimit.burst=200"
        - "traefik.http.routers.api.middlewares=api-ratelimit"

  # Backup service
  backup:
    image: offen/docker-volume-backup:latest
    environment:
      BACKUP_CRON_EXPRESSION: "0 2 * * *"
      BACKUP_RETENTION_DAYS: "30"
      BACKUP_FILENAME: backup-%Y-%m-%dT%H-%M-%S.tar.gz
      BACKUP_ARCHIVE: "/archive"
      BACKUP_STOP_CONTAINER_LABEL: fleet.backup.stop
      BACKUP_FROM_SNAPSHOT: "true"
      AWS_S3_BUCKET_NAME: ${S3_BUCKET:-""}
      AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY:-""}
      AWS_SECRET_ACCESS_KEY: ${AWS_SECRET_KEY:-""}
    volumes:
      - postgres_data:/backup/postgres:ro
      - /opt/fleet-platform/backups:/archive
    deploy:
      placement:
        constraints:
          - node.labels.backup == true

secrets:
  db_password:
    external: true
  jwt_secret:
    external: true
  redis_password:
    external: true
  tls_cert:
    external: true
  tls_key:
    external: true
EOF

# Create secrets in Docker
docker secret create db_password $SECRETS_DIR/db-password 2>/dev/null || true
docker secret create jwt_secret $SECRETS_DIR/jwt-secret 2>/dev/null || true
docker secret create redis_password $SECRETS_DIR/nats-password 2>/dev/null || true

# Generate self-signed certs for internal TLS (replace with real certs)
openssl req -x509 -newkey rsa:4096 -keyout /tmp/tls.key -out /tmp/tls.crt -days 365 -nodes -subj "/CN=$DOMAIN"
docker secret create tls_cert /tmp/tls.crt 2>/dev/null || true
docker secret create tls_key /tmp/tls.key 2>/dev/null || true

# 5. Database Migrations
echo "[5/10] Running database migrations..."

# Wait for postgres
sleep 10

# Run migrations using golang-migrate
docker run --rm -v $(pwd)/migrations:/migrations \
  --network fleet-internal \
  migrate/migrate:latest \
  -path=/migrations \
  -database "postgresql://fleet:$(cat $SECRETS_DIR/db-password)@postgres:5432/fleetdb?sslmode=disable" \
  up

# 6. Monitoring Stack
echo "[6/10] Deploying monitoring..."

cat > /opt/fleet-platform/monitoring-stack.yml << 'EOF'
version: '3.8'

networks:
  backend:
    external: true
  internal:
    external: true

services:
  prometheus:
    image: prom/prometheus:latest
    configs:
      - source: prometheus_config
        target: /etc/prometheus/prometheus.yml
    volumes:
      - prometheus_data:/prometheus
    networks:
      - internal
    deploy:
      placement:
        constraints:
          - node.labels.monitoring == true

  grafana:
    image: grafana/grafana:latest
    environment:
      - GF_SECURITY_ADMIN_PASSWORD__FILE=/run/secrets/grafana_password
      - GF_INSTALL_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/dashboards:/etc/grafana/provisioning/dashboards
      - ./grafana/datasources:/etc/grafana/provisioning/datasources
    secrets:
      - grafana_password
    networks:
      - backend
      - internal
    deploy:
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.grafana.rule=Host(`grafana.${DOMAIN}`)"
        - "traefik.http.routers.grafana.entrypoints=websecure"
        - "traefik.http.routers.grafana.tls.certresolver=letsencrypt"

  loki:
    image: grafana/loki:latest
    configs:
      - source: loki_config
        target: /etc/loki/local-config.yaml
    volumes:
      - loki_data:/loki
    networks:
      - internal

  promtail:
    image: grafana/promtail:latest
    volumes:
      - /var/log:/var/log:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
    configs:
      - source: promtail_config
        target: /etc/promtail/config.yml
    networks:
      - internal
    deploy:
      mode: global

volumes:
  prometheus_data:
  grafana_data:
  loki_data:

configs:
  prometheus_config:
    external: true
  loki_config:
    external: true
  promtail_config:
    external: true

secrets:
  grafana_password:
    external: true
EOF

# Generate Grafana password
openssl rand -base64 16 | tr -d '\n' > $SECRETS_DIR/grafana-password
docker secret create grafana_password $SECRETS_DIR/grafana-password 2>/dev/null || true

# 7. Deploy stacks
echo "[7/10] Deploying stacks..."

export DOMAIN EMAIL
envsubst < /opt/fleet-platform/docker-stack.yml | docker stack deploy -c - fleet

# 8. Backup verification
echo "[8/10] Testing backup system..."

mkdir -p /opt/fleet-platform/backups
# First backup will run at 2 AM, manual test:
docker service logs fleet_backup --tail 20

# 9. Health checks
echo "[9/10] Running health checks..."

sleep 5

HEALTH_STATUS=$(curl -s -o /dev/null -w "%{http_code}" https://$DOMAIN/health || echo "000")

if [ "$HEALTH_STATUS" == "200" ]; then
    echo "✓ API is healthy"
else
    echo "✗ API health check failed (HTTP $HEALTH_STATUS)"
    docker service logs fleet_api --tail 50
    exit 1
fi

# 10. Output credentials
echo "[10/10] Deployment complete!"
echo ""
echo "=== CREDENTIALS (SAVE THESE) ==="
echo "Domain: https://$DOMAIN"
echo "Grafana: https://grafana.$DOMAIN"
echo "Grafana Admin Password: $(cat $SECRETS_DIR/grafana-password)"
echo "Database Password: $(cat $SECRETS_DIR/db-password)"
echo ""
echo "Next steps:"
echo "1. Update DNS to point to this server"
echo "2. Configure Android apps with https://$DOMAIN"
echo "3. Access Grafana and import dashboards"
echo "4. Set up log shipping from devices"
```

---

## 2. ENTERPRISE BACKEND (Production-Grade Go)

### 2.1 Structured Project Layout

```
fleet-platform/
├── cmd/
│   ├── api/                    # Main API server
│   └── worker/                 # Background job processor
├── internal/
│   ├── config/                 # Environment configuration
│   ├── domain/                 # Business entities
│   ├── repository/             # Data access layer
│   ├── service/                # Business logic
│   ├── handler/                # HTTP handlers
│   ├── middleware/             # Auth, logging, rate limit
│   ├── telemetry/              # Metrics, tracing
│   └── pkg/
│       ├── validator/          # Request validation
│       ├── crypto/             # Encryption helpers
│       └── errors/             # Domain errors
├── pkg/
│   ├── proto/                  # Generated protobuf
│   └── client/                 # External API clients
├── migrations/                 # Database migrations
├── deployments/
│   ├── docker/
│   └── k8s/
└── tests/
    ├── integration/
    └── e2e/
```

### 2.2 Production API Server

**File: `cmd/api/main.go`**
```go
package main

import (
	"context"
	"errors"
	"fmt"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"fleet-platform/internal/config"
	"fleet-platform/internal/handler"
	"fleet-platform/internal/middleware"
	"fleet-platform/internal/repository"
	"fleet-platform/internal/service"
	"fleet-platform/internal/telemetry"

	"github.com/gin-gonic/gin"
	"github.com/jackc/pgx/v5/pgxpool"
	"github.com/nats-io/nats.go"
	"github.com/redis/go-redis/v9"
	"go.uber.org/zap"
	"go.uber.org/zap/zapcore"
)

func main() {
	// Structured logging
	logger := initLogger()
	defer logger.Sync()

	// Configuration
	cfg, err := config.Load()
	if err != nil {
		logger.Fatal("failed to load config", zap.Error(err))
	}

	// Database with connection pooling
	dbpool, err := initDatabase(cfg, logger)
	if err != nil {
		logger.Fatal("failed to connect to database", zap.Error(err))
	}
	defer dbpool.Close()

	// Redis
	redisClient := redis.NewClient(&redis.Options{
		Addr:     cfg.Redis.Addr,
		Password: cfg.Redis.Password,
		DB:       0,
		PoolSize: 20,
	})
	defer redisClient.Close()

	// NATS with reconnect logic
	nc, err := initNATS(cfg, logger)
	if err != nil {
		logger.Fatal("failed to connect to NATS", zap.Error(err))
	}
	defer nc.Close()

	// Repository layer
	repos := repository.New(dbpool, redisClient, logger)

	// Service layer
	services := service.New(repos, nc, logger)

	// HTTP handlers
	handlers := handler.New(services, logger)

	// Router setup
	router := setupRouter(handlers, cfg, logger)

	// HTTP server with graceful shutdown
	srv := &http.Server{
		Addr:         fmt.Sprintf(":%d", cfg.Port),
		Handler:      router,
		ReadTimeout:  15 * time.Second,
		WriteTimeout: 15 * time.Second,
		IdleTimeout:  60 * time.Second,
	}

	// Start server in goroutine
	go func() {
		logger.Info("starting server", zap.String("addr", srv.Addr))
		if err := srv.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			logger.Fatal("failed to start server", zap.Error(err))
		}
	}()

	// Wait for interrupt signal
	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
	<-quit

	logger.Info("shutting down server...")

	// Graceful shutdown with timeout
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	if err := srv.Shutdown(ctx); err != nil {
		logger.Fatal("server forced to shutdown", zap.Error(err))
	}

	logger.Info("server exited")
}

func initLogger() *zap.Logger {
	config := zap.NewProductionConfig()
	config.EncoderConfig.TimeKey = "timestamp"
	config.EncoderConfig.EncodeTime = zapcore.ISO8601TimeEncoder
	config.EncoderConfig.StacktraceKey = "stacktrace"

	logger, err := config.Build(
		zap.AddCaller(),
		zap.AddStacktrace(zapcore.ErrorLevel),
	)
	if err != nil {
		panic(err)
	}
	return logger
}

func initDatabase(cfg *config.Config, logger *zap.Logger) (*pgxpool.Pool, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	poolConfig, err := pgxpool.ParseConfig(cfg.Database.URL)
	if err != nil {
		return nil, err
	}

	// Production tuning
	poolConfig.MaxConns = 50
	poolConfig.MinConns = 10
	poolConfig.MaxConnLifetime = time.Hour
	poolConfig.MaxConnIdleTime = 30 * time.Minute
	poolConfig.HealthCheckPeriod = 5 * time.Minute

	pool, err := pgxpool.NewWithConfig(ctx, poolConfig)
	if err != nil {
		return nil, err
	}

	// Verify connection
	if err := pool.Ping(ctx); err != nil {
		return nil, err
	}

	return pool, nil
}

func initNATS(cfg *config.Config, logger *zap.Logger) (*nats.Conn, error) {
	opts := []nats.Option{
		nats.Name("Fleet API"),
		nats.RetryOnFailedConnect(true),
		nats.MaxReconnects(10),
		nats.ReconnectWait(time.Second),
		nats.ReconnectJitter(500*time.Millisecond, 2*time.Second),
		nats.DisconnectErrHandler(func(nc *nats.Conn, err error) {
			logger.Warn("NATS disconnected", zap.Error(err))
		}),
		nats.ReconnectHandler(func(nc *nats.Conn) {
			logger.Info("NATS reconnected", zap.String("server", nc.ConnectedUrl()))
		}),
		nats.ErrorHandler(func(nc *nats.Conn, sub *nats.Subscription, err error) {
			logger.Error("NATS error", zap.Error(err), zap.String("sub", sub.Subject))
		}),
	}

	if cfg.NATS.User != "" {
		opts = append(opts, nats.UserInfo(cfg.NATS.User, cfg.NATS.Password))
	}

	return nats.Connect(cfg.NATS.URL, opts...)
}

func setupRouter(h *handler.Handler, cfg *config.Config, logger *zap.Logger) *gin.Engine {
	if cfg.Environment == "production" {
		gin.SetMode(gin.ReleaseMode)
	}

	r := gin.New()

	// Middleware chain
	r.Use(middleware.RequestID())
	r.Use(middleware.StructuredLogger(logger))
	r.Use(middleware.RecoveryWithLogger(logger))
	r.Use(middleware.CORS(cfg.CORS.AllowedOrigins))
	r.Use(middleware.RateLimiter(cfg.RateLimit))

	// Metrics endpoint (before auth)
	r.GET("/metrics", telemetry.MetricsHandler())
	r.GET("/health", h.HealthCheck)

	// API routes
	v1 := r.Group("/api/v1")
	
	// Public
	v1.POST("/auth/login", h.Auth.Login)
	v1.POST("/auth/refresh", h.Auth.Refresh)
	
	// Authenticated
	auth := v1.Group("")
	auth.Use(middleware.JWTAuth(cfg.JWT.Secret))
	{
		// Vehicles
		vehicles := auth.Group("/vehicles")
		vehicles.GET("", h.Vehicle.List)
		vehicles.POST("", middleware.RequireRole("admin", "fleet_manager"), h.Vehicle.Create)
		vehicles.GET("/:id", h.Vehicle.Get)
		vehicles.PUT("/:id", middleware.RequireRole("admin", "fleet_manager"), h.Vehicle.Update)
		vehicles.DELETE("/:id", middleware.RequireRole("admin"), h.Vehicle.Delete)
		vehicles.POST("/:id/immobilize", middleware.RequireRole("admin"), h.Vehicle.Immobilize)
		
		// Telemetry
		vehicles.GET("/:id/locations", h.Telemetry.GetLocations)
		vehicles.GET("/:id/trips", h.Trip.ListByVehicle)
	}

	// Device routes (API key auth)
	device := r.Group("/device")
	device.Use(middleware.DeviceAuth())
	{
		device.POST("/telemetry/gps", h.Telemetry.ReceiveGPS)
		device.POST("/telemetry/obd", h.Telemetry.ReceiveOBD)
		device.POST("/events", h.Event.Receive)
	}

	return r
}
```

### 2.3 Database Migrations

**File: `migrations/001_initial_schema.up.sql`**
```sql
-- Migration framework: golang-migrate or atlas
-- Version: 001
-- Description: Initial schema with proper constraints

CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS "postgis";
CREATE EXTENSION IF NOT EXISTS "timescaledb";

-- Organizations
CREATE TABLE organizations (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    name VARCHAR(255) NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    type VARCHAR(50) NOT NULL CHECK (type IN ('fleet_owner', 'reseller', 'partner')),
    settings JSONB NOT NULL DEFAULT '{}',
    billing_email VARCHAR(255),
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    deleted_at TIMESTAMPTZ
);

CREATE INDEX idx_organizations_slug ON organizations(slug) WHERE deleted_at IS NULL;

-- Users with proper password hashing
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    org_id UUID NOT NULL REFERENCES organizations(id),
    email VARCHAR(255) NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    role VARCHAR(50) NOT NULL CHECK (role IN ('super_admin', 'admin', 'fleet_manager', 'driver', 'viewer')),
    status VARCHAR(20) NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'suspended', 'invited')),
    mfa_enabled BOOLEAN NOT NULL DEFAULT FALSE,
    mfa_secret VARCHAR(255),
    last_login_at TIMESTAMPTZ,
    failed_login_attempts INTEGER NOT NULL DEFAULT 0,
    locked_until TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    deleted_at TIMESTAMPTZ,
    
    UNIQUE(org_id, email)
);

CREATE INDEX idx_users_org_email ON users(org_id, email) WHERE deleted_at IS NULL;
CREATE INDEX idx_users_role ON users(role) WHERE status = 'active';

-- Vehicles with soft delete
CREATE TABLE vehicles (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    org_id UUID NOT NULL REFERENCES organizations(id),
    registration_number VARCHAR(20) NOT NULL,
    chassis_number VARCHAR(17),
    engine_number VARCHAR(20),
    type VARCHAR(50) NOT NULL CHECK (type IN ('truck', 'bus', 'car', 'bike', 'tempo')),
    make VARCHAR(100),
    model VARCHAR(100),
    year INTEGER CHECK (year BETWEEN 1900 AND EXTRACT(YEAR FROM NOW()) + 1),
    fuel_type VARCHAR(20) CHECK (fuel_type IN ('diesel', 'petrol', 'cng', 'electric', 'hybrid')),
    status VARCHAR(20) NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'inactive', 'maintenance', 'retired')),
    current_driver_id UUID REFERENCES users(id),
    current_location GEOGRAPHY(POINT, 4326),
    last_seen_at TIMESTAMPTZ,
    metadata JSONB NOT NULL DEFAULT '{}',
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    deleted_at TIMESTAMPTZ,
    
    UNIQUE(org_id, registration_number)
);

CREATE INDEX idx_vehicles_org ON vehicles(org_id) WHERE deleted_at IS NULL;
CREATE INDEX idx_vehicles_location ON vehicles USING GIST(current_location) WHERE current_location IS NOT NULL;

-- GPS hypertable
CREATE TABLE gps_readings (
    time TIMESTAMPTZ NOT NULL,
    vehicle_id UUID NOT NULL REFERENCES vehicles(id),
    latitude DECIMAL(10, 8) NOT NULL CHECK (latitude BETWEEN -90 AND 90),
    longitude DECIMAL(11, 8) NOT NULL CHECK (longitude BETWEEN -180 AND 180),
    altitude DECIMAL(8, 2),
    speed DECIMAL(5, 2) CHECK (speed >= 0),
    heading DECIMAL(5, 2) CHECK (heading BETWEEN 0 AND 360),
    accuracy DECIMAL(5, 2),
    ignition BOOLEAN,
    odometer DECIMAL(10, 2),
    metadata JSONB NOT NULL DEFAULT '{}'
);

SELECT create_hypertable('gps_readings', 'time', chunk_time_interval => INTERVAL '1 day');
CREATE INDEX idx_gps_vehicle_time ON gps_readings (vehicle_id, time DESC);

-- Retention policy: compress after 7 days, drop after 1 year
SELECT add_compression_policy('gps_readings', INTERVAL '7 days');
SELECT add_retention_policy('gps_readings', INTERVAL '1 year');

-- OBD readings
CREATE TABLE obd_readings (
    time TIMESTAMPTZ NOT NULL,
    vehicle_id UUID NOT NULL REFERENCES vehicles(id),
    rpm INTEGER CHECK (rpm >= 0),
    speed INTEGER CHECK (speed >= 0),
    coolant_temp DECIMAL(5, 2),
    engine_load DECIMAL(5, 2) CHECK (engine_load BETWEEN 0 AND 100),
    fuel_level DECIMAL(5, 2) CHECK (fuel_level BETWEEN 0 AND 100),
    throttle_pos DECIMAL(5, 2) CHECK (throttle_pos BETWEEN 0 AND 100),
    dtcs TEXT[],
    vin VARCHAR(17)
);

SELECT create_hypertable('obd_readings', 'time', chunk_time_interval => INTERVAL '1 day');

-- Audit log
CREATE TABLE audit_logs (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    table_name VARCHAR(100) NOT NULL,
    record_id UUID NOT NULL,
    action VARCHAR(20) NOT NULL CHECK (action IN ('INSERT', 'UPDATE', 'DELETE')),
    old_data JSONB,
    new_data JSONB,
    changed_by UUID REFERENCES users(id),
    changed_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    ip_address INET
);

CREATE INDEX idx_audit_table_record ON audit_logs(table_name, record_id);
```

### 2.4 Request Validation Layer

**File: `internal/validator/vehicle.go`**
```go
package validator

import (
	"fmt"
	"regexp"
)

type VehicleCreateRequest struct {
	RegistrationNumber string `json:"registration_number" validate:"required"`
	ChassisNumber      string `json:"chassis_number" validate:"omitempty,len=17"`
	Type               string `json:"type" validate:"required,oneof=truck bus car bike tempo"`
	Year               int    `json:"year" validate:"omitempty,gte=1900,lte=2100"`
}

func (r *VehicleCreateRequest) Validate() error {
	// Indian registration number format: KA01AB1234 or KA01A1234
	regex := regexp.MustCompile(`^[A-Z]{2}[0-9]{2}[A-Z]{1,2}[0-9]{4}$`)
	if !regex.MatchString(r.RegistrationNumber) {
		return fmt.Errorf("registration_number must match Indian format (e.g., KA01AB1234)")
	}
	
	// Normalize to uppercase
	r.RegistrationNumber = strings.ToUpper(r.RegistrationNumber)
	
	return nil
}
```

### 2.5 Rate Limiting & Circuit Breaker

**File: `internal/middleware/ratelimit.go`**
```go
package middleware

import (
	"net/http"
	"time"

	"github.com/gin-gonic/gin"
	"github.com/redis/go-redis/v9"
	"golang.org/x/time/rate"
)

type RateLimiter struct {
	redis     *redis.Client
	limiters  map[string]*rate.Limiter // In-memory for burst
	visitors  map[string]*visitor
}

type visitor struct {
	limiter  *rate.Limiter
	lastSeen time.Time
}

func NewRateLimiter(redis *redis.Client) *RateLimiter {
	rl := &RateLimiter{
		redis:    redis,
		limiters: make(map[string]*rate.Limiter),
		visitors: make(map[string]*visitor),
	}
	
	// Cleanup old visitors
	go rl.cleanupVisitors()
	
	return rl
}

func (rl *RateLimiter) Limit() gin.HandlerFunc {
	return func(c *gin.Context) {
		key := c.ClientIP()
		
		// Check Redis for distributed rate limiting
		ctx := c.Request.Context()
		current, err := rl.redis.Incr(ctx, "ratelimit:"+key).Result()
		if err == nil && current == 1 {
			rl.redis.Expire(ctx, "ratelimit:"+key, time.Minute)
		}
		
		if current > 100 { // 100 requests per minute
			c.JSON(http.StatusTooManyRequests, gin.H{
				"error": "rate limit exceeded",
				"retry_after": 60,
			})
			c.Abort()
			return
		}
		
		c.Next()
	}
}
```

