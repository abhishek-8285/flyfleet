## 11. VALIDATION & TESTING

### 11.1 Load Testing Plan

**File: `tests/load/locustfile.py`**

```python
from locust import HttpUser, task, between
import random
import json

class FleetUser(HttpUser):
    wait_time = between(1, 5)
    
    def on_start(self):
        # Login
        response = self.client.post("/api/v1/auth/login", json={
            "email": "loadtest@fleet.local",
            "password": "testpass123"
        })
        self.token = response.json()["access_token"]
        self.headers = {"Authorization": f"Bearer {self.token}"}
        
        # Get vehicle list
        vehicles = self.client.get("/api/v1/vehicles", headers=self.headers).json()
        self.vehicle_ids = [v["id"] for v in vehicles["vehicles"]]
    
    @task(10)
    def get_vehicles(self):
        self.client.get("/api/v1/vehicles", headers=self.headers)
    
    @task(5)
    def get_vehicle_detail(self):
        if self.vehicle_ids:
            vid = random.choice(self.vehicle_ids)
            self.client.get(f"/api/v1/vehicles/{vid}", headers=self.headers)
    
    @task(20)
    def submit_telemetry(self):
        # Simulate device
        if self.vehicle_ids:
            vid = random.choice(self.vehicle_ids)
            self.client.post("/telemetry/gps", 
                headers={"X-API-Key": "device-key"},
                json={
                    "vehicle_id": vid,
                    "latitude": 19.0 + random.random(),
                    "longitude": 72.0 + random.random(),
                    "speed": random.randint(0, 80),
                    "timestamp": int(time.time())
                }
            )

class DeviceUser(HttpUser):
    """Simulates GPS devices"""
    wait_time = between(4, 6)  # 12/min = 1 per 5s average
    
    @task
    def send_gps(self):
        self.client.post("/telemetry/gps",
            headers={"X-API-Key": "load-test-key"},
            json={
                "vehicle_id": f"vehicle-{self.user_id}",
                "latitude": 19.0760 + random.gauss(0, 0.01),
                "longitude": 77.5946 + random.gauss(0, 0.01),
                "speed": abs(random.gauss(40, 20)),
                "heading": random.randint(0, 360),
                "timestamp": int(time.time())
            }
        )
```

