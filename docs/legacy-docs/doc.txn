### 4.2 Alerting Rules

**File: `monitoring/prometheus/alerts.yml`**
```yaml
groups:
  - name: fleet-alerts
    rules:
      - alert: HighErrorRate
        expr: rate(fleet_http_requests_total{status=~"5.."}[5m]) > 0.05
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "High error rate detected"
          description: "Error rate is {{ $value }} errors per second"

      - alert: DatabaseConnectionExhausted
        expr: pg_stat_activity_count{state="active"} / pg_settings_max_connections > 0.8
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "Database connections running high"

      - alert: VehicleOffline
        expr: fleet_vehicles_online < fleet_vehicles_total * 0.9
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Many vehicles offline"
          description: "{{ $value }} vehicles are offline"

      - alert: DiskSpaceLow
        expr: (node_filesystem_avail_bytes / node_filesystem_size_bytes) < 0.1
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Disk space low on {{ $labels.instance }}"

      - alert: BackupFailed
        expr: time() - backup_last_success_timestamp > 86400
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Backup has not run in 24 hours"
```

