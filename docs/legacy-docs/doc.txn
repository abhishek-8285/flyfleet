#### Screen: Live Map

```typescript
// LiveMap.tsx - Real-time Tracking
import { MapContainer, TileLayer, Marker, Popup, Polyline } from 'react-leaflet';
import { useCentrifuge } from '../hooks/useCentrifuge';  // WebSocket

const LiveMap: React.FC = () => {
  const [vehicles, setVehicles] = useState<VehicleMarker[]>([]);
  const [selectedVehicle, setSelectedVehicle] = useState<string | null>(null);
  const [showTraffic, setShowTraffic] = useState(true);
  
  // WebSocket connection for real-time updates
  const { publish } = useCentrifuge({
    channel: `fleet:${orgId}:locations`,
    onMessage: (msg) => {
      updateVehicleLocation(msg.vehicle_id, msg.location);
    }
  });
  
  // Fetch initial positions
  useEffect(() => {
    api.get('/api/v1/vehicles?include_location=true').then(res => {
      setVehicles(res.data.vehicles.map(v => ({
        id: v.id,
        position: [v.current_location.lat, v.current_location.lng],
        heading: v.current_location.heading,
        status: v.status,
        driver: v.current_driver,
        speed: v.current_location.speed
      })));
    });
  }, []);

  return (
    <div className="live-map-container">
      <MapContainer 
        center={[20.5937, 78.9629]}  // Center of India
        zoom={5}
        style={{ height: '100vh', width: '100%' }}
      >
        <TileLayer 
          url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
          attribution='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        />
        
        {vehicles.map(vehicle => (
          <RotatedMarker 
            key={vehicle.id}
            position={vehicle.position}
            rotationAngle={vehicle.heading}
            icon={getVehicleIcon(vehicle.status, vehicle.speed)}
            eventHandlers={{
              click: () => setSelectedVehicle(vehicle.id)
            }}
          >
            <Popup>
              <VehiclePopupContent vehicle={vehicle} />
            </Popup>
          </RotatedMarker>
        ))}
        
        {/* Trip routes for active trips */}
        <ActiveTripRoutes orgId={orgId} />
        
        {/* Geofences */}
        <GeofenceLayers 
          geofences={geofences}
          onGeofenceClick={handleGeofenceClick}
        />
        
        {/* Traffic overlay (India-specific: use MapMyIndia or similar free tier) */}
        {showTraffic && <TrafficOverlay />}
      </MapContainer>
      
      {/* Vehicle List Sidebar */}
      <VehicleSidebar 
        vehicles={vehicles}
        selectedId={selectedVehicle}
        onSelect={setSelectedVehicle}
        onTrack={(id) => {
          const v = vehicles.find(x => x.id === id);
          map.flyTo(v.position, 16);
        }}
        onImmobilize={async (id) => {
          await api.post(`/vehicles/${id}/immobilize`);
          toast.success('Immobilize command sent');
        }}
      />
      
      {/* Alert Overlay */}
      <AlertOverlay 
        alerts={activeAlerts}
        onAlertClick={(alert) => {
          map.flyTo([alert.location.lat, alert.location.lng], 16);
        }}
      />
    </div>
  );
};
```

