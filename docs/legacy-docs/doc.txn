```typescript
// Dashboard.tsx - Main Analytics View
interface DashboardProps {
  orgId: string;
  userRole: 'admin' | 'fleet_manager' | 'viewer';
}

const Dashboard: React.FC<DashboardProps> = ({ orgId, userRole }) => {
  // Real-time stats
  const { data: stats } = useSWR('/api/v1/dashboard/stats', fetcher, {
    refreshInterval: 5000
  });
  
  // Permissions: viewers see only their assigned vehicles
  const visibleStats = useMemo(() => {
    if (userRole === 'viewer') {
      return filterStatsByAssignedVehicles(stats, user.assignedVehicles);
    }
    return stats;
  }, [stats, userRole]);

  return (
    <div className="dashboard-grid">
      {/* KPI Cards */}
      <KPICard 
        title="Vehicles Online"
        value={visibleStats.vehiclesOnline}
        total={visibleStats.totalVehicles}
        trend={visibleStats.onlineTrend}
        color="green"
      />
      
      <KPICard 
        title="Active Trips"
        value={visibleStats.activeTrips}
        alert={visibleStats.delayedTrips > 0}
        alertCount={visibleStats.delayedTrips}
        link="/trips?status=ongoing"
      />
      
      <KPICard 
        title="Fuel Efficiency"
        value={visibleStats.avgFuelEfficiency}
        unit="km/l"
        benchmark={visibleStats.industryBenchmark}
      />
      
      <KPICard 
        title="Safety Score"
        value={visibleStats.safetyScore}
        trend={visibleStats.safetyTrend}
        color={visibleStats.safetyScore > 80 ? "green" : "red"}
      />
      
      {/* Live Map Preview */}
      <LiveMapCard 
        vehicles={visibleStats.vehicleLocations}
        alerts={visibleStats.activeAlerts}
        onVehicleClick={(id) => router.push(`/vehicles/${id}`)}
        height="400px"
      />
      
      {/* Alerts Feed */}
      <AlertsFeed 
        alerts={visibleStats.recentAlerts}
        onAcknowledge={(id) => api.post(`/alerts/${id}/acknowledge`)}
        maxItems={5}
        autoRefresh={true}
      />
      
      {/* Quick Actions */}
      {userRole !== 'viewer' && (
        <QuickActions>
          <ActionButton 
            icon="plus"
            label="Create Trip"
            onClick={() => setTripModalOpen(true)}
          />
          <ActionButton 
            icon="bell"
            label="Send Alert"
            onClick={() => setAlertModalOpen(true)}
          />
          <ActionButton 
            icon="file"
            label="Generate Report"
            onClick={() => router.push('/reports')}
          />
        </QuickActions>
      )}
    </div>
  );
};

// API Integration
const fetcher = (url: string) => api.get(url).then(r => r.data);

// Error Handling
const ErrorFallback = ({ error, resetErrorBoundary }) => (
  <Alert variant="error">
    <AlertTitle>Dashboard Error</AlertTitle>
    <AlertDescription>{error.message}</AlertDescription>
    <Button onClick={resetErrorBoundary}>Retry</Button>
  </Alert>
);
