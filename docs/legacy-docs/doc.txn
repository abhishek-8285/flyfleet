## D. ANDROID DRIVER APP

### D.1 Complete Kotlin Implementation

**`android-driver/app/src/main/java/com/fleet/driver/MainActivity.kt`**
```kotlin
package com.fleet.driver

import android.Manifest
import android.content.Intent
import android.content.pm.PackageManager
import android.os.Build
import android.os.Bundle
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import androidx.activity.result.contract.ActivityResultContracts
import androidx.compose.foundation.layout.*
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.*
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.unit.dp
import androidx.core.content.ContextCompat
import androidx.hilt.navigation.compose.hiltViewModel
import com.fleet.driver.service.LocationTrackingService
import com.fleet.driver.ui.enrollment.EnrollmentScreen
import com.fleet.driver.ui.main.DriverDashboard
import com.fleet.driver.ui.theme.FleetTheme
import com.fleet.driver.util.SecurePrefs
import dagger.hilt.android.AndroidEntryPoint

@AndroidEntryPoint
class MainActivity : ComponentActivity() {
    private val locationPermissionRequest = registerForActivityResult(
        ActivityResultContracts.RequestMultiplePermissions()
    ) { permissions ->
        when {
            permissions.getOrDefault(Manifest.permission.ACCESS_FINE_LOCATION, false) -> {
                startTrackingService()
            }
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        
        setContent {
            FleetTheme {
                val context = LocalContext.current
                val isEnrolled = remember { SecurePrefs.isEnrolled(context) }
                
                if (!isEnrolled) {
                    EnrollmentScreen(onEnrolled = { recreate() })
                } else {
                    DriverApp()
                }
            }
        }
    }
    
    private fun checkPermissions() {
        val permissions = mutableListOf(
            Manifest.permission.ACCESS_FINE_LOCATION,
            Manifest.permission.ACCESS_COARSE_LOCATION
        )
        
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
            permissions.add(Manifest.permission.ACCESS_BACKGROUND_LOCATION)
        }
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            permissions.add(Manifest.permission.POST_NOTIFICATIONS)
        }
        
        val needsRequest = permissions.any {
            ContextCompat.checkSelfPermission(this, it) != PackageManager.PERMISSION_GRANTED
        }
        
        if (needsRequest) {
            locationPermissionRequest.launch(permissions.toTypedArray())
        } else {
            startTrackingService()
        }
    }
    
    private fun startTrackingService() {
        val intent = Intent(this, LocationTrackingService::class.java).apply {
            action = LocationTrackingService.ACTION_START
        }
        startForegroundService(intent)
    }
}

@Composable
fun DriverApp(viewModel: DriverViewModel = hiltViewModel()) {
    val uiState by viewModel.uiState.collectAsState()
    var showSOS by remember { mutableStateOf(false) }
    
    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("Fleet Driver") },
                actions = {
                    IconButton(onClick = { showSOS = true }) {
                        Icon(Icons.Default.Warning, contentDescription = "SOS", tint = MaterialTheme.colorScheme.error)
                    }
                }
            )
        }
    ) { padding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(padding)
                .padding(16.dp)
        ) {
            // Status Card
            TrackingStatusCard(
                isTracking = uiState.isTracking,
                location = uiState.currentLocation,
                onToggle = { viewModel.toggleTracking() }
            )
            
            Spacer(modifier = Modifier.height(16.dp))
            
            // Trip Actions
            if (uiState.activeTrip == null) {
                Button(
                    onClick = { viewModel.startTrip() },
                    modifier = Modifier.fillMaxWidth()
                ) {
                    Icon(Icons.Default.PlayArrow, contentDescription = null)
                    Spacer(Modifier.width(8.dp))
                    Text("START TRIP")
                }
            } else {
                ActiveTripCard(
                    trip = uiState.activeTrip,
                    onComplete = { viewModel.completeTrip() },
                    onAddWaypoint = { viewModel.addWaypoint() }
                )
            }
            
            Spacer(modifier = Modifier.height(16.dp))
            
            // Stats
            StatsRow(
                tripsToday = uiState.todayStats.trips,
                distanceToday = uiState.todayStats.distanceKm,
                earningsToday = uiState.todayStats.earnings
            )
        }
    }
    
    if (showSOS) {
        SOSDialog(
            onConfirm = { type, message ->
                viewModel.triggerSOS(type, message)
                showSOS = false
            },
            onDismiss = { showSOS = false }
        )
    }
}

@Composable
fun TrackingStatusCard(isTracking: Boolean, location: LocationData?, onToggle: () -> Unit) {
    Card(
        colors = CardDefaults.cardColors(
            containerColor = if (isTracking) MaterialTheme.colorScheme.primaryContainer 
                           else MaterialTheme.colorScheme.surfaceVariant
        )
    ) {
        Column(
            modifier = Modifier.padding(16.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            Icon(
                imageVector = if (isTracking) Icons.Default.RadioButtonChecked else Icons.Default.RadioButtonUnchecked,
                contentDescription = null,
                tint = if (isTracking) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.outline
            )
            Text(
                text = if (isTracking) "TRACKING ACTIVE" else "TRACKING PAUSED",
                style = MaterialTheme.typography.titleMedium
            )
            location?.let {
                Text("Lat: ${it.latitude}, Lng: ${it.longitude}")
                Text("Speed: ${it.speed} km/h")
            }
            Button(onClick = onToggle) {
                Text(if (isTracking) "PAUSE" else "RESUME")
            }
        }
    }
}
```

**`android-driver/app/src/main/java/com/fleet/driver/service/LocationTrackingService.kt`**
```kotlin
package com.fleet.driver.service

import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.Service
import android.content.Context
import android.content.Intent
import android.location.Location
import android.os.Binder
import android.os.Build
import android.os.IBinder
import android.os.Looper
import androidx.core.app.NotificationCompat
import com.fleet.driver.R
import com.fleet.driver.data.local.FleetDatabase
import com.fleet.driver.data.local.PendingLocation
import com.fleet.driver.data.remote.ApiService
import com.google.android.gms.location.*
import dagger.hilt.android.AndroidEntryPoint
import kotlinx.coroutines.*
import javax.inject.Inject

@AndroidEntryPoint
class LocationTrackingService : Service() {
    private val binder = LocationBinder()
    private val serviceScope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
    
    @Inject lateinit var fusedLocationClient: FusedLocationProviderClient
    @Inject lateinit var database: FleetDatabase
    @Inject lateinit var apiService: ApiService
    
    private var locationCallback: LocationCallback? = null
    
    companion object {
        const val ACTION_START = "START"
        const val ACTION_STOP = "STOP"
        const val ACTION_SOS = "SOS"
        private const val NOTIFICATION_ID = 1001
        private const val CHANNEL_ID = "fleet_tracking"
        private const val UPDATE_INTERVAL = 5000L
    }
    
    inner class LocationBinder : Binder() {
        fun getService(): LocationTrackingService = this@LocationTrackingService
    }
    
    override fun onBind(intent: Intent): IBinder = binder
    
    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        when (intent?.action) {
            ACTION_START -> startTracking()
            ACTION_STOP -> stopTracking()
            ACTION_SOS -> handleSOS()
        }
        return START_STICKY
    }
    
    private fun startTracking() {
        val notification = createNotification("Initializing GPS...")
        startForeground(NOTIFICATION_ID, notification)
        
        val request = LocationRequest.Builder(
            Priority.PRIORITY_HIGH_ACCURACY,
            UPDATE_INTERVAL
        ).build()
        
        locationCallback = object : LocationCallback() {
            override fun onLocationResult(result: LocationResult) {
                result.lastLocation?.let { processLocation(it) }
            }
        }
        
        fusedLocationClient.requestLocationUpdates(
            request,
            locationCallback!!,
            Looper.getMainLooper()
        )
    }
    
    private fun processLocation(location: Location) {
        serviceScope.launch {
            val pending = PendingLocation(
                vehicleId = SecurePrefs.getVehicleId(this@LocationTrackingService),
                latitude = location.latitude,
                longitude = location.longitude,
                speed = location.speed * 3.6f,
                accuracy = location.accuracy,
                timestamp = System.currentTimeMillis()
            )
            
            database.pendingSyncDao().insert(pending)
            
            // Attempt immediate sync
            try {
                val response = apiService.postTelemetry(pending.toPayload())
                if (response.isSuccessful) {
                    database.pendingSyncDao().delete(pending)
                }
            } catch (e: Exception) {
                // Will retry via WorkManager
            }
        }
    }
    
    private fun createNotification(content: String): Notification {
        val channel = NotificationChannel(
            CHANNEL_ID,
            "Fleet Tracking",
            NotificationManager.IMPORTANCE_LOW
        )
        (getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager)
            .createNotificationChannel(channel)
            
        return NotificationCompat.Builder(this, CHANNEL_ID)
            .setContentTitle("Fleet Tracking Active")
            .setContentText(content)
            .setSmallIcon(R.drawable.ic_location)
            .setOngoing(true)
            .build()
    }
    
    private fun stopTracking() {
        locationCallback?.let { fusedLocationClient.removeLocationUpdates(it) }
        stopForeground(STOP_FOREGROUND_REMOVE)
        stopSelf()
    }
    
    private fun handleSOS() {
        serviceScope.launch {
            apiService.triggerSOS(SOSRequest(
                type = "emergency",
                timestamp = System.currentTimeMillis()
            ))
        }
    }
}
```

