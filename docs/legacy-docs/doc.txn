    {
      key: 'actions',
      title: 'Actions',
      render: (_: any, record: any) => (
        <div className="flex gap-2">
          <button 
            onClick={() => setSelectedVehicle(record.id)}
            className="text-blue-600 hover:text-blue-800"
          >
            View
          </button>
          <button 
            onClick={() => dispatch(deleteVehicle(record.id))}
            className="text-red-600 hover:text-red-800"
          >
            Delete
          </button>
        </div>
      )
    }
  ];

  return (
    <div className="p-6">
      <div className="flex justify-between items-center mb-6">
        <h1 className="text-2xl font-bold">Vehicles</h1>
        <div className="flex gap-4">
          <input
            type="text"
            placeholder="Search vehicles..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            className="px-4 py-2 border rounded-lg"
          />
          <button
            onClick={() => setShowCreate(true)}
            className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
          >
            + Add Vehicle
          </button>
        </div>
      </div>

      <DataTable
        columns={columns}
        data={vehicles}
        loading={loading}
        pagination={{ pageSize: 20, total: vehicles.length }}
      />

      <Modal open={showCreate} onClose={() => setShowCreate(false)} title="Create Vehicle">
        <VehicleForm 
          onSubmit={(data) => {
            dispatch(createVehicle(data));
            setShowCreate(false);
          }}
          onCancel={() => setShowCreate(false)}
        />
      </Modal>

      <Modal open={!!selectedVehicle} onClose={() => setSelectedVehicle(null)} title="Vehicle Details">
        {selectedVehicle && (
          <VehicleDetail 
            vehicleId={selectedVehicle}
            onClose={() => setSelectedVehicle(null)}
          />
        )}
      </Modal>
    </div>
  );
};

export default Vehicles;
```

**`web-admin/src/pages/Geofences.tsx`**
```typescript
import React, { useState } from 'react';
import { MapContainer, TileLayer, FeatureGroup } from 'react-leaflet';
import { EditControl } from 'react-leaflet-draw';
import { useDispatch, useSelector } from 'react-redux';
import { createGeofence, fetchGeofences, selectGeofences } from '../store/geofenceSlice';

const Geofences: React.FC = () => {
  const dispatch = useDispatch();
  const geofences = useSelector(selectGeofences);
  const [drawnItems, setDrawnItems] = useState<any>(null);

  const onCreated = (e: any) => {
    const { layerType, layer } = e;
    const geojson = layer.toGeoJSON();
    
    dispatch(createGeofence({
      name: `Geofence ${geofences.length + 1}`,
      type: layerType === 'circle' ? 'circle' : 'polygon',
      geometry: geojson.geometry,
      radius: layerType === 'circle' ? layer.getRadius() : undefined,
      entry_alert: true,
      exit_alert: true,
    }));
  };

  return (
    <div className="h-screen flex">
      <div className="w-1/3 bg-white p-4 overflow-y-auto">
        <h1 className="text-2xl font-bold mb-4">Geofences</h1>
        
        <div className="space-y-4">
          {geofences.map((gf: any) => (
            <div key={gf.id} className="border rounded-lg p-4">
              <h3 className="font-semibold">{gf.name}</h3>
              <p className="text-sm text-gray-600">{gf.type}</p>
              <div className="mt-2 flex gap-2">
                <span className="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded">
                  Entry: {gf.entry_alert ? 'ON' : 'OFF'}
                </span>
                <span className="text-xs bg-purple-100 text-purple-800 px-2 py-1 rounded">
                  Exit: {gf.exit_alert ? 'ON' : 'OFF'}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div className="flex-1">
        <MapContainer center={[20.5937, 78.9629]} zoom={5} className="h-full">
          <TileLayer url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png" />
          <FeatureGroup>
            <EditControl
              position="topright"
              onCreated={onCreated}
              draw={{
                rectangle: false,
                circle: true,
                polygon: true,
                polyline: false,
                marker: false,
                circlemarker: false,
              }}
            />
          </FeatureGroup>
        </MapContainer>
      </div>
    </div>
  );
};

export default Geofences;
```

**`web-admin/src/pages/Billing.tsx`**
```typescript
import React, { useEffect } from 'react';
import { useDispatch, useSelector } from 'react-redux';
import { fetchSubscription, fetchInvoices, fetchUsage } from '../store/billingSlice';
import { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip } from 'recharts';

const Billing: React.FC = () => {
  const dispatch = useDispatch();
  const subscription = useSelector((state: any) => state.billing.subscription);
  const invoices = useSelector((state: any) => state.billing.invoices);
  const usage = useSelector((state: any) => state.billing.usage);

  useEffect(() => {
    dispatch(fetchSubscription());
    dispatch(fetchInvoices());
    dispatch(fetchUsage());
  }, [dispatch]);

  return (
    <div className="p-6 max-w-7xl mx-auto">
      <h1 className="text-2xl font-bold mb-6">Billing & Usage</h1>

      {/* Subscription Card */}
      <div className="bg-white rounded-lg shadow p-6 mb-6">
        <div className="flex justify-between items-start">
          <div>
            <h2 className="text-lg font-semibold">Current Plan</h2>
            <p className="text-3xl font-bold mt-2">₹{subscription?.amount || 0}/month</p>
            <p className="text-gray-600">{subscription?.plan_name || 'Free Tier'}</p>
          </div>
          <span className={`px-3 py-1 rounded-full text-sm ${
            subscription?.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'
          }`}>
            {subscription?.status || 'Inactive'}
          </span>
        </div>
        
        <div className="mt-4 grid grid-cols-3 gap-4">
          <div>
            <p className="text-sm text-gray-600">Vehicles</p>
            <p className="text-lg font-semibold">{subscription?.usage?.vehicles || 0} / {subscription?.limits?.vehicles || 10}</p>
          </div>
          <div>
            <p className="text-sm text-gray-600">GPS Points</p>
            <p className="text-lg font-semibold">{((subscription?.usage?.gps_points || 0) / 1000000).toFixed(1)}M / {((subscription?.limits?.gps_points || 0) / 1000000).toFixed(1)}M</p>
          </div>
          <div>
            <p className="text-sm text-gray-600">Storage</p>
            <p className="text-lg font-semibold">{subscription?.usage?.storage_gb || 0} / {subscription?.limits?.storage_gb || 10} GB</p>
          </div>
        </div>
      </div>

      {/* Usage Chart */}
      <div className="bg-white rounded-lg shadow p-6 mb-6">
        <h2 className="text-lg font-semibold mb-4">Daily Usage</h2>
        <BarChart width={800} height={300} data={usage?.daily || []}>
          <CartesianGrid strokeDasharray="3 3" />
          <XAxis dataKey="date" />
          <YAxis />
          <Tooltip />
          <Bar dataKey="gps_points" fill="#3b82f6" name="GPS Points" />
          <Bar dataKey="api_calls" fill="#10b981" name="API Calls" />
        </BarChart>
      </div>

      {/* Invoices */}
      <div className="bg-white rounded-lg shadow">
        <h2 className="text-lg font-semibold p-6 border-b">Invoices</h2>
        <table className="w-full">
          <thead className="bg-gray-50">
            <tr>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Invoice #</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Period</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
            </tr>
          </thead>
          <tbody>
            {invoices.map((inv: any) => (
              <tr key={inv.id} className="border-b">
                <td className="px-6 py-4">{inv.invoice_number}</td>
                <td className="px-6 py-4">{inv.period}</td>
                <td className="px-6 py-4">₹{inv.amount}</td>
                <td className="px-6 py-4">
                  <span className={`px-2 py-1 rounded text-xs ${
                    inv.status === 'paid' ? 'bg-green-100 text-green-800' :
                    inv.status === 'overdue' ? 'bg-red-100 text-red-800' :
                    'bg-yellow-100 text-yellow-800'
