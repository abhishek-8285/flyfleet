## 4. COMPLETE API SPECIFICATION

### 4.1 Authentication APIs

```yaml
POST /api/v1/auth/login
  Request:
    email: string
    password: string
    device_id?: string  # for mobile apps
  
  Response 200:
    access_token: string (JWT, 15min)
    refresh_token: string (JWT, 7days)
    user: {id, email, role, permissions, org_id}
  
  Response 401:
    error: "invalid_credentials"
    attempts_remaining: number

POST /api/v1/auth/refresh
  Headers: Authorization: Bearer {refresh_token}
  
  Response 200:
    access_token: string
    refresh_token: string

POST /api/v1/auth/logout
  Headers: Authorization: Bearer {access_token}
  
  Response 204

POST /api/v1/auth/mfa/enable
  Request:
    method: "totp" | "sms"
  
  Response 200:
    secret: string  # QR code data for TOTP

POST /api/v1/auth/device/register
  # For mobile app device binding
  Request:
    device_id: string
    fcm_token?: string
    platform: "android"
  
  Response 200:
    device_registered: true
```

### 4.2 Vehicle APIs

```yaml
GET /api/v1/vehicles
  Query:
    org_id: UUID (required for non-admin)
    status: string[]
    type: string[]
    search: string
    limit: integer (default 20, max 100)
    offset: integer
  
  Response 200:
    total: integer
    vehicles: [
      {
        id: UUID
        registration_number: string
        type: string
        status: string
        current_location: {lat, lng, accuracy, timestamp}
        current_driver: {id, name, phone}
        last_seen: ISO8601
        alerts_count: integer
        next_maintenance_date: date
      }
    ]

POST /api/v1/vehicles
  Auth: admin, fleet_manager
  
  Request:
    registration_number: string (regex: ^[A-Z]{2}[0-9]{2}[A-Z]{1,2}[0-9]{4}$)
    chassis_number: string (17 chars, alphanumeric)
    type: enum
    make: string
    model: string
    year: integer (1900-current+1)
    fuel_type: enum
    gps_device_id?: string
    documents: [
      {
        type: enum [rc, insurance, permit, fitness, pollution]
        number: string
        expiry_date: date
        file_url?: string
      }
    ]
  
  Response 201:
    vehicle: {...}
    qr_code: string  # For device pairing

GET /api/v1/vehicles/{id}
  Response 200:
    full vehicle object with:
      - trip_history (last 10)
      - driver_history
      - maintenance_history
      - fuel_analytics
      - document_status

PUT /api/v1/vehicles/{id}
  Auth: admin, fleet_manager
  
  Request: partial vehicle object
  
  Response 200: updated vehicle

DELETE /api/v1/vehicles/{id}
  Auth: admin
  
  Response 204

POST /api/v1/vehicles/{id}/immobilize
  Auth: admin, fleet_manager
  
  Request:
    reason: string
    emergency: boolean
  
  Response 202:
    command_id: UUID
    status: "queued" | "sent" | "acknowledged" | "failed"
    estimated_delivery: ISO8601
  
  Error 409:
    if vehicle in motion and !emergency

POST /api/v1/vehicles/{id}/diagnostics/run
  Auth: admin, fleet_manager
  
  Response 202:
    report_id: UUID
  
  GET /api/v1/diagnostics/{report_id}
    Response 200 when ready:
      dtcs: [...]
      engine_health: percentage
      recommendations: [...]
```

### 4.3 GPS & Tracking APIs

```yaml
POST /api/v1/telemetry/gps
  # Called by Android app or OBD device
  Auth: Device API Key (X-Device-Key header)
  
  Request:
    vehicle_id: UUID
    timestamp: ISO8601  # Device time
    latitude: decimal (-90 to 90)
    longitude: decimal (-180 to 180)
    accuracy: decimal (meters)
    altitude: decimal (meters)
    speed: decimal (km/h)
    heading: decimal (0-360)
    ignition: boolean
    odometer: decimal (km)
    battery_level: integer (0-100)
  
  Response 202: Accepted (async processing)
  
  Validation:
    - Rate limit: 1 per 5 seconds per vehicle
    - Geo bounds: Must be within Indian territory (rough bbox check)

POST /api/v1/telemetry/obd
  Auth: Device API Key
  
  Request:
    vehicle_id: UUID
    timestamp: ISO8601
    rpm: integer
    speed: integer (from OBD, cross-check with GPS)
    coolant_temp: decimal
    engine_load: decimal
    throttle_pos: decimal
    fuel_level: decimal (0-100)
    dtcs: string[]  # e.g., ["P0301", "P0420"]
    vin: string (if available)
  
  Response 202

GET /api/v1/vehicles/{id}/locations
  Query:
    from: ISO8601 (required)
    to: ISO8601 (required, max 7 days range)
    interval: string ("raw", "1min", "5min", "hour")  # downsampling
  
  Response 200:
    locations: [
      {timestamp, lat, lng, speed, ignition}
    ]
    distance_km: decimal
    max_speed: decimal
    stops: [
      {start_time, end_time, location, duration_minutes}
    ]

GET /api/v1/vehicles/{id}/live
  # WebSocket upgrade or Server-Sent Events
  Headers: Upgrade: websocket
  
  Real-time stream:
    {type: "location", data: {...}}
    {type: "alert", data: {...}}
    {type: "status", data: {...}}
```

### 4.4 Trip APIs

```yaml
POST /api/v1/trips
  Auth: driver, fleet_manager, admin
  
  Request:
    vehicle_id: UUID
    driver_id: UUID
    type: enum [delivery, pickup, transfer, school_run, employee_run]
    waypoints: [
      {
        sequence: integer
        lat: decimal
        lng: decimal
        address: string
        type: enum [start, end, stop, delivery, pickup]
        expected_arrival: ISO8601
        contact_name: string
        contact_phone: string
        notes: string
      }
    ]
    cargo_details: {
      description: string
      weight_kg: decimal
      value_inr: decimal
      temperature_required: boolean
      min_temp: decimal
      max_temp: decimal
    }
    estimated_distance_km: decimal
  
  Response 201:
    trip: {...}
    optimized_route: {
      polyline: string  # Google Maps encoded polyline
      distance_km: decimal
      duration_minutes: integer
      toll_cost_inr: decimal
    }
    geofences_created: [UUID]  # Auto-created for waypoints

POST /api/v1/trips/{id}/start
  Auth: assigned driver, fleet_manager
  
  Request:
    odometer_reading: decimal
    fuel_level: decimal
  
  Response 200:
    trip: {...}
    live_tracking_url: string  # Shareable with customer

POST /api/v1/trips/{id}/events
  Auth: driver
  
  Request:
    type: enum [arrival, departure, delivery_attempt, delivery_success, delivery_failed, delay, breakdown, accident]
    location: {lat, lng}
    timestamp: ISO8601
    notes: string
    photos: string[]  # URLs
    pod: {
      recipient_name: string
      recipient_phone: string
      signature_image: string  # base64
      otp_verified: boolean
    }
  
  Response 201

POST /api/v1/trips/{id}/complete
  Auth: driver, fleet_manager
  
  Request:
    odometer_reading: decimal
    fuel_level: decimal
    actual_distance_km: decimal
  
  Response 200:
    trip_summary: {
      planned_vs_actual_distance: decimal
      fuel_efficiency_kmpl: decimal
      profitability: decimal
      alerts_generated: integer
    }

GET /api/v1/trips/{id}/optimize-route
  Query:
    avoid_tolls: boolean
    traffic_aware: boolean
  
  Response 200:
    routes: [
      {
        polyline: string
        distance_km: decimal
        duration_minutes: integer
        tolls: [{name, cost_inr, location}]
        fuel_cost_estimate: decimal
        weather_alerts: [...]
      }
    ]
```

### 4.5 Alert & Geofence APIs

```yaml
POST /api/v1/alerts/rules
  Auth: admin, fleet_manager
  
  Request:
    name: string
    type: enum [
      overspeed, geofence_entry, geofence_exit, 
      harsh_acceleration, harsh_braking, harsh_cornering,
      idle_time, fuel_theft, low_battery, 
      temperature_excursion, accident_detected,
      maintenance_due, document_expiry,
      driver_fatigue, adas_event
    ]
    conditions: JSONB  # Rule-specific
    # Example for overspeed:
    # {speed_limit: 80, duration_seconds: 30}
    # Example for fuel theft:
    # {drop_threshold_liters: 5, duration_minutes: 10}
    severity: enum [info, warning, critical]
    actions: [
      {
        type: enum [notification, email, sms, immobilize, webhook]
        target: string
        template?: string
      }
    ]
    vehicles: UUID[]  # Apply to specific vehicles or all
    enabled: boolean
  
  Response 201

GET /api/v1/alerts
  Query:
    org_id: UUID
    severity: string[]
    status: string[]  # new, acknowledged, resolved
    vehicle_id: UUID
    from: ISO8601
    to: ISO8601
  
  Response 200:
    alerts: [
      {
        id: UUID
        type: string
        severity: string
        vehicle: {...}
        driver: {...}
        location: {lat, lng}
        timestamp: ISO8601
        details: JSONB  # Rule-specific data
        status: string
        acknowledged_by: {...}
        resolved_at: ISO8601
      }
    ]

POST /api/v1/alerts/{id}/acknowledge
  Request:
    notes: string
  
  Response 200

POST /api/v1/geofences
  Auth: admin, fleet_manager
  
  Request:
    name: string
    type: enum [circle, polygon, route_corridor]
    # For circle:
    center: {lat, lng}
    radius_meters: integer
    
    # For polygon:
    coordinates: [{lat, lng}, ...]  # Closed polygon
    
    # For route_corridor:
    route_polyline: string  # Encoded polyline
    buffer_meters: integer  # Width of corridor
    
    entry_alert: boolean
    exit_alert: boolean
    speed_limit: integer
    vehicles: UUID[]  # or "all"
  
  Response 201
```

