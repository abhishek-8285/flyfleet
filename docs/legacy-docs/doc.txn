## 3. DATABASE SCHEMA

### 3.1 PostgreSQL Core Tables

```sql
-- Core entities
CREATE TABLE organizations (
    id UUID PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    type VARCHAR(50) CHECK (type IN ('fleet_owner', 'reseller', 'partner', 'white_label')),
    billing_model VARCHAR(50),
    settings JSONB DEFAULT '{}',
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE users (
    id UUID PRIMARY KEY,
    org_id UUID REFERENCES organizations(id),
    email VARCHAR(255) UNIQUE NOT NULL,
    phone VARCHAR(20) UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    role VARCHAR(50) CHECK (role IN ('super_admin', 'admin', 'fleet_manager', 'driver', 'viewer', 'partner', 'reseller')),
    permissions JSONB DEFAULT '{}', -- granular permissions
    mfa_enabled BOOLEAN DEFAULT FALSE,
    last_login TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE vehicles (
    id UUID PRIMARY KEY,
    org_id UUID REFERENCES organizations(id),
    registration_number VARCHAR(20) UNIQUE NOT NULL, -- Indian format: KA01AB1234
    chassis_number VARCHAR(17) UNIQUE,
    engine_number VARCHAR(20),
    type VARCHAR(50) CHECK (type IN ('truck', 'bus', 'car', 'bike', 'tempo', 'school_bus', 'employee_transport')),
    make VARCHAR(100),
    model VARCHAR(100),
    year INTEGER,
    fuel_type VARCHAR(20),
    gps_device_id VARCHAR(100),
    obd_device_id VARCHAR(100),
    camera_device_id VARCHAR(100),
    status VARCHAR(20) DEFAULT 'active' CHECK (status IN ('active', 'inactive', 'maintenance', 'sold')),
    current_driver_id UUID,
    current_location GEOGRAPHY(POINT, 4326),
    last_seen TIMESTAMPTZ,
    metadata JSONB DEFAULT '{}',
    documents JSONB DEFAULT '[]', -- [{type: 'insurance', url: '...', expiry: '...'}]
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE drivers (
    id UUID PRIMARY KEY,
    org_id UUID REFERENCES organizations(id),
    user_id UUID REFERENCES users(id),
    license_number VARCHAR(50) NOT NULL,
    license_expiry DATE,
    phone VARCHAR(20) UNIQUE NOT NULL,
    name VARCHAR(255) NOT NULL,
    status VARCHAR(20) DEFAULT 'available' CHECK (status IN ('available', 'on_trip', 'off_duty', 'suspended')),
    rating DECIMAL(2,1) DEFAULT 5.0,
    behavior_score INTEGER DEFAULT 100,
    documents JSONB DEFAULT '[]',
    emergency_contact JSONB,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE trips (
    id UUID PRIMARY KEY,
    org_id UUID REFERENCES organizations(id),
    vehicle_id UUID REFERENCES vehicles(id),
    driver_id UUID REFERENCES drivers(id),
    status VARCHAR(20) DEFAULT 'planned' CHECK (status IN ('planned', 'ongoing', 'paused', 'completed', 'cancelled')),
    start_time TIMESTAMPTZ,
    end_time TIMESTAMPTZ,
    start_location GEOGRAPHY(POINT, 4326),
    end_location GEOGRAPHY(POINT, 4326),
    route GEOGRAPHY(LINESTRING, 4326),
    distance_km DECIMAL(10,2),
    fuel_consumed_liters DECIMAL(8,2),
    estimated_fuel_cost DECIMAL(10,2),
    actual_fuel_cost DECIMAL(10,2),
    waypoints JSONB DEFAULT '[]', -- [{lat, lng, name, type, eta}]
    geofences JSONB DEFAULT '[]', -- auto-created entry/exit zones
    pod_documents JSONB DEFAULT '[]',
    temperature_logs JSONB DEFAULT '[]',
    profitability DECIMAL(10,2), -- revenue - costs
    metadata JSONB DEFAULT '{}',
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- India-specific
CREATE TABLE fastag_transactions (
    id UUID PRIMARY KEY,
    vehicle_id UUID REFERENCES vehicles(id),
    transaction_id VARCHAR(100) UNIQUE,
    toll_plaza_name VARCHAR(255),
    toll_plaza_location GEOGRAPHY(POINT, 4326),
    amount DECIMAL(8,2),
    timestamp TIMESTAMPTZ,
    meta JSONB,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE eway_bills (
    id UUID PRIMARY KEY,
    org_id UUID REFERENCES organizations(id),
    ewb_number VARCHAR(20) UNIQUE,
    vehicle_id UUID REFERENCES vehicles(id),
    trip_id UUID REFERENCES trips(id),
    valid_from TIMESTAMPTZ,
    valid_until TIMESTAMPTZ,
    status VARCHAR(20),
    json_data JSONB,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE echallans (
    id UUID PRIMARY KEY,
    vehicle_id UUID REFERENCES vehicles(id),
    challan_number VARCHAR(50) UNIQUE,
    violation VARCHAR(255),
    amount DECIMAL(8,2),
    location GEOGRAPHY(POINT, 4326),
    date TIMESTAMPTZ,
    status VARCHAR(20) DEFAULT 'pending',
    created_at TIMESTAMPTZ DEFAULT NOW()
);
```

### 3.2 TimescaleDB Hypertables (Time-series)

```sql
-- Enable TimescaleDB extension
CREATE EXTENSION IF NOT EXISTS timescaledb;

-- GPS telemetry (1 location/10s per vehicle = massive scale)
CREATE TABLE gps_locations (
    time TIMESTAMPTZ NOT NULL,
    vehicle_id UUID NOT NULL,
    latitude DECIMAL(10, 8),
    longitude DECIMAL(11, 8),
    altitude DECIMAL(8, 2),
    speed DECIMAL(5, 2),
    heading DECIMAL(5, 2),
    accuracy DECIMAL(5, 2),
    ignition BOOLEAN,
    odometer DECIMAL(10, 2),
    battery_level INTEGER,
    satellites INTEGER,
    raw_data JSONB
);

SELECT create_hypertable('gps_locations', 'time', chunk_time_interval => INTERVAL '1 day');

-- OBD data
CREATE TABLE obd_readings (
    time TIMESTAMPTZ NOT NULL,
    vehicle_id UUID NOT NULL,
    rpm INTEGER,
    coolant_temp DECIMAL(5,2),
    engine_load DECIMAL(5,2),
    throttle_pos DECIMAL(5,2),
    fuel_level DECIMAL(5,2),
    dtcs TEXT[], -- Diagnostic trouble codes
    vin VARCHAR(17)
);

SELECT create_hypertable('obd_readings', 'time', chunk_time_interval => INTERVAL '1 day');

-- Fuel readings (for theft detection)
CREATE TABLE fuel_readings (
    time TIMESTAMPTZ NOT NULL,
    vehicle_id UUID NOT NULL,
    level_percent DECIMAL(5,2),
    level_liters DECIMAL(8,2),
    refuel_event BOOLEAN DEFAULT FALSE,
    theft_event BOOLEAN DEFAULT FALSE,
    location GEOGRAPHY(POINT, 4326)
);

SELECT create_hypertable('fuel_readings', 'time', chunk_time_interval => INTERVAL '7 days');

-- Indexes for time-series
CREATE INDEX idx_gps_vehicle_time ON gps_locations (vehicle_id, time DESC);
CREATE INDEX idx_obd_vehicle_time ON obd_readings (vehicle_id, time DESC);
CREATE INDEX idx_fuel_vehicle_time ON fuel_readings (vehicle_id, time DESC);

-- Compression policy (save 90% space after 7 days)
SELECT add_compression_policy('gps_locations', INTERVAL '7 days');
SELECT add_compression_policy('obd_readings', INTERVAL '7 days');
```

### 3.3 Geofencing (PostGIS)

```sql
CREATE TABLE geofences (
    id UUID PRIMARY KEY,
    org_id UUID REFERENCES organizations(id),
    name VARCHAR(255),
    type VARCHAR(50) CHECK (type IN ('circle', 'polygon', 'route_corridor')),
    geometry GEOGRAPHY,
    radius_meters INTEGER, -- for circle
    buffer_meters INTEGER, -- for route corridor
    entry_alert BOOLEAN DEFAULT TRUE,
    exit_alert BOOLEAN DEFAULT TRUE,
    speed_limit INTEGER,
    metadata JSONB,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX idx_geofences_geom ON geofences USING GIST(geometry);
```

