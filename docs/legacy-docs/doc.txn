package vehicle

import (
	"time"
)

type Vehicle struct {
	ID                 string     `json:"id"`
	OrgID              string     `json:"org_id"`
	RegistrationNumber string     `json:"registration_number"`
	ChassisNumber      string     `json:"chassis_number"`
	EngineNumber       string     `json:"engine_number"`
	Type               string     `json:"type"`
	Make               string     `json:"make"`
	Model              string     `json:"model"`
	Year               int        `json:"year"`
	FuelType           string     `json:"fuel_type"`
	Status             string     `json:"status"`
	CurrentDriverID    *string    `json:"current_driver_id"`
	CurrentLocation    *Location  `json:"current_location"`
	LastLocationAt     *time.Time `json:"last_location_at"`
	LastSpeed          float64    `json:"last_speed"`
	LastIgnition       bool       `json:"last_ignition"`
	OdometerKm         float64    `json:"odometer_km"`
	FuelCapacityLiters float64    `json:"fuel_capacity_liters"`
	Metadata           Metadata   `json:"metadata"`
	Documents          []Document `json:"documents"`
	CreatedAt          time.Time  `json:"created_at"`
	UpdatedAt          time.Time  `json:"updated_at"`
}

type Location struct {
	Lat       float64   `json:"lat"`
	Lng       float64   `json:"lng"`
	Accuracy  float64   `json:"accuracy"`
	Speed     float64   `json:"speed"`
	Heading   float64   `json:"heading"`
	Timestamp time.Time `json:"timestamp"`
}

type Metadata struct {
	Color       string `json:"color"`
	EngineCC    int    `json:"engine_cc"`
	SeatingCapacity int `json:"seating_capacity"`
}

type Document struct {
	Type     string    `json:"type"`
	Number   string    `json:"number"`
	URL      string    `json:"url"`
	ExpiryAt time.Time `json:"expiry_at"`
}

type CreateRequest struct {
	RegistrationNumber string   `json:"registration_number" binding:"required,reg_number"`
	ChassisNumber      string   `json:"chassis_number" binding:"omitempty,len=17"`
	EngineNumber       string   `json:"engine_number"`
	Type               string   `json:"type" binding:"required,oneof=truck bus car bike tempo tractor school_bus ambulance"`
	Make               string   `json:"make"`
	Model              string   `json:"model"`
	Year               int      `json:"year" binding:"omitempty,gte=1900,lte=2100"`
	FuelType           string   `json:"fuel_type" binding:"omitempty,oneof=diesel petrol cng electric hybrid lpg"`
	FuelCapacityLiters float64  `json:"fuel_capacity_liters"`
}

type UpdateRequest struct {
	Make               string   `json:"make"`
	Model              string   `json:"model"`
	Status             string   `json:"status" binding:"omitempty,oneof=active inactive maintenance retired sold"`
	CurrentDriverID    *string  `json:"current_driver_id"`
	FuelCapacityLiters float64  `json:"fuel_capacity_liters"`
}
