# Optimize npm workspaces dependency hoisting
# This prevents duplicate node_modules in each workspace
node-linker=hoisted

# Improve install performance
prefer-offline=true
fetch-retries=3
fetch-retry-maxtimeout=60000
fetch-retry-mintimeout=10000

# Workspace settings
workspaces-offline-concurrency=1

# Reduce log noise
silent=false
metrics-registry=https://registry.npmjs.org/
