# FlyFleet Environment Variables Example
# Copy this file to .env and fill in your actual values

# Database Configuration
POSTGRES_USER=fleet_user
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_DB=fleet_db

# JWT Secret
JWT_SECRET=your_very_secure_jwt_secret_key_here_with_at_least_32_characters

# Service Ports (optional, defaults shown)
AUTH_SERVICE_PORT=8080
FLEET_CORE_SERVICE_PORT=8084
ALERT_SERVICE_PORT=8085
ADMIN_SUPPORT_SERVICE_PORT=8086
BILLING_SERVICE_PORT=8087
TRACKING_SERVICE_PORT=8082
WEB_BFF_PORT=8081
REPORTS_SERVICE_PORT=8083
GOVERNANCE_SERVICE_PORT=8088
ANALYTICS_SERVICE_PORT=8089
INTEGRATIONS_SERVICE_PORT=8090
SETTINGS_SERVICE_PORT=8091
MAINTENANCE_SERVICE_PORT=8092
VEHICLE_SERVICE_PORT=8093
DRIVER_SERVICE_PORT=8094
TRIP_SERVICE_PORT=8095

# External Service URLs
FLEET_CORE_SERVICE_URL=http://fleet-core-service:8084
ALERT_SERVICE_URL=http://alert-service:8085
ADMIN_SUPPORT_SERVICE_URL=http://admin-support-service:8086
BILLING_SERVICE_URL=http://billing-service:8087
TRACKING_SERVICE_URL=http://tracking-service:8082