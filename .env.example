# ──────────────────────────────────────────────────────
# FlyFleet Platform – Required Environment Variables
# Copy this file to .env and fill in production values.
# ──────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────
POSTGRES_USER=fleet_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=fleet_db

# ── Security ──────────────────────────────────────────
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_KEY
# Used for service-to-service authentication
SERVICE_JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_KEY

# ── Analytics (optional) ──────────────────────────────
POSTHOG_API_KEY=
POSTHOG_ENDPOINT=