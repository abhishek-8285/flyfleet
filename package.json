{
  "name": "flyfleet",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:unit": "go test ./... -short -count=1",
    "test:integration": "go test ./... -tags=integration -count=1",
    "test:coverage": "go test ./... -coverprofile=coverage.out -covermode=atomic && go tool cover -html=coverage.out -o coverage.html",
    "test:e2e": "npm run test --workspace=apps/dashboard-web --if-present",
    "bff:build": "make bff-build",
    "bff:contract-check": "make bff-contract-check",
    "bff:smoke": "make bff-smoke",
    "frontend:api-check": "make frontend-api-check",
    "docs:governance": "make docs-governance",
    "ops:governance": "make operations-governance",
    "perf:web-budget": "make performance-web-budget",
    "perf:api-latency": "make api-latency-smoke",
    "api:clients:generate": "make api-clients-generate",
    "api:clients:check": "make api-clients-check",
    "trace:check": "make trace-propagation-check",
    "services:all:check": "make all-services-foundation-check",
    "identity:auth:check": "make identity-auth-foundation-check",
    "design:system:check": "make design-system-foundation-check",
    "observability:foundation:check": "make observability-foundation-check",
    "mobile:sync:check": "make mobile-sync-foundation-check",
    "mobile:sync:simulate": "make mobile-sync-simulate",
    "firmware:ota:check": "make firmware-ota-foundation-check",
    "firmware:ota:validate": "make firmware-ota-validate",
    "firmware:ota:orchestrate": "make ota-rollout-simulate",
    "device:reliability:check": "make device-reliability-foundation-check",
    "device:command:simulate": "make device-command-simulate",
    "vehicle:device:foundation:check": "make vehicle-device-foundation-check",
    "vehicle:device:test": "make vehicle-device-tests",
    "runtime:service-matrix:check": "make runtime-service-matrix-check",
    "enterprise:foundation:check": "make enterprise-foundation-check",
    "runtime:integration:gate": "make runtime-integration-gate",
    "workflow:coverage:check": "make workflow-coverage-check",
    "turbo:build": "turbo run build",
    "turbo:test": "turbo run test",
    "turbo:lint": "turbo run lint",
    "turbo:dev": "turbo run dev",
    "turbo:clean": "turbo run clean",
    "type-check": "turbo run build --no-emit",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "changeset publish",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "lint:fix": "turbo run lint -- --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "framer-motion": "^12.34.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.8.1",
    "turbo": "^2.3.3",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "lodash": "4.17.21",
    "express": "4.18.2"
  }
}
